@@ -143,7 +143,7 @@
   if (name.has_value() && !name.value().empty()) {
     return name.value();
   }
-  return "helium.desktop";
+  return "aerie.desktop";
 #endif
 }
 #endif  // BUILDFLAG(IS_LINUX)
