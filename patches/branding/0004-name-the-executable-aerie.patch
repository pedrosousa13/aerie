Aerie-Purpose: Name the Linux browser executable aerie and its crash handler aerie_crashpad_handler, so the desktop entry, process list and install directory show Aerie.
Aerie-Upstream-Area: chrome/BUILD.gn, chrome/installer/linux/BUILD.gn, components/crash/core/app, chrome/browser/memory_details_linux.cc
Aerie-Kind: branding

Helium names the executable helium. This patch changes every line that
Helium's rename-chrome-binary patch added for that name. ./aerie build looks
for out/Default/aerie (tools/aerie_build/pipeline.py).

--- a/chrome/browser/memory_details_linux.cc
+++ b/chrome/browser/memory_details_linux.cc
@@ -118,7 +118,7 @@
   ProcessData current_browser =
       GetProcessDataMemoryInformation(GetAllChildren(process_map, getpid()));
   current_browser.name = base::ASCIIToUTF16(version_info::GetProductName());
-  current_browser.process_name = u"helium";
+  current_browser.process_name = u"aerie";
 
   for (auto i = current_browser.processes.begin();
        i != current_browser.processes.end(); ++i) {
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -157,7 +157,7 @@
   if (is_win) {
     _chrome_output_name = "initialexe/chrome"
   } else {
-    _chrome_output_name = "helium"
+    _chrome_output_name = "aerie"
   }
 
   executable("chrome_initial") {
@@ -1883,20 +1883,20 @@
     }
 
     extract_symbols("chrome_symbols") {
-      binary = "$root_out_dir/helium"
+      binary = "$root_out_dir/aerie"
 
       if (current_cpu == "x86") {
         # GYP used "ia32" so keep that naming for back-compat.
-        symbol_file = "$root_out_dir/helium.breakpad.ia32"
+        symbol_file = "$root_out_dir/aerie.breakpad.ia32"
       } else {
-        symbol_file = "$root_out_dir/helium.breakpad.$current_cpu"
+        symbol_file = "$root_out_dir/aerie.breakpad.$current_cpu"
       }
 
       deps = [ ":chrome" ]
     }
 
     extract_symbols("chrome_crashpad_symbols") {
-      binary = "$root_out_dir/helium_crashpad_handler"
+      binary = "$root_out_dir/aerie_crashpad_handler"
 
       if (current_cpu == "x86") {
         # GYP used "ia32" so keep that naming for back-compat.
--- a/chrome/installer/linux/BUILD.gn
+++ b/chrome/installer/linux/BUILD.gn
@@ -71,8 +71,8 @@
 }
 
 packaging_files_executables = [
-  "$root_out_dir/helium",
-  "$root_out_dir/helium_crashpad_handler",
+  "$root_out_dir/aerie",
