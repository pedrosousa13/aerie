 ]
 
 packaging_files_shlibs = []
@@ -206,12 +206,12 @@
 }
 
 strip_binary("strip_chrome_binary") {
-  binary_input = "$root_out_dir/helium"
+  binary_input = "$root_out_dir/aerie"
   deps = [ "//chrome" ]
 }
 
 strip_binary("strip_chrome_crashpad_handler") {
-  binary_input = "$root_out_dir/helium_crashpad_handler"
+  binary_input = "$root_out_dir/aerie_crashpad_handler"
   deps = [ "//components/crash/core/app:chrome_crashpad_handler" ]
 }
 
