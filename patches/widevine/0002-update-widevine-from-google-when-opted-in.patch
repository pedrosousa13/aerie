+bool ChromeConfigurator::ShouldSendToServer(const std::string& app_id,
+                                            const GURL& url) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return aerie_widevine::ShouldSendToUpdateServer(app_id, url);
 }
 
