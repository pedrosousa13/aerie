   observer_remote_.Bind(std::move(observer));
+
+  // Aerie: tell the embedder that this frame uses encrypted media. Chrome
+  // asks the user once whether to turn on Widevine.
+  GetContentClient()->browser()->OnEncryptedMediaRequested(
+      &render_frame_host());
 
   // If `key_system_support_` is already available, notify the new observer
