+// Aerie: the sidebar has no collapsed state and no snap points. A drag or a key
+// press moves the inner edge, the width stays between size-sidebar-min and
+// size-sidebar-max, and it is stored when the drag ends (issue #177).
+void VerticalTabStripRegionView::OnAerieResize(int resize_amount,
+                                               bool done_resizing) {
+  if (!starting_width_on_resize_.has_value()) {
+    starting_width_on_resize_ = width();
+    state_controller_->SetIsResizing(true);
+  }
+  const int new_width = aerie_sidebar::ResizeByDrag(
+      starting_width_on_resize_.value(), resize_amount,
+      state_controller_->IsTabStripRightAligned());
+  if (done_resizing) {
+    starting_width_on_resize_ = std::nullopt;
+    state_controller_->SetIsResizing(false);
+    state_controller_->SetUncollapsedWidth(new_width);
+  }
+  target_collapse_state_.uncollapsed_width = new_width;
+  InvalidateLayout();
+}
+
+// Aerie: Ctrl+S flips aerie.sidebar.visible. The layout snaps to the new
+// width at once and the column slides on its layer (transform and opacity
+// only, opacity alone under reduced motion). On the way out the layout waits
+// for the slide to end (issue #177).
+void VerticalTabStripRegionView::OnAerieVisibleChanged() {
+  PrefService* const prefs = browser_view()->GetProfile()->GetPrefs();
+  const bool visible = aerie_sidebar::IsVisible(*prefs);
+  if (visible != aerie_hidden_) {
+    return;
+  }
+  aerie_hide_timer_.Stop();
+  aerie_motion_.Abort();
+  const bool reduced = aerie::motion::ShouldReduceMotion(prefs);
+  const bool on_right =
+      state_controller_->IsTabStripRightAligned() != base::i18n::IsRTL();
+  const int edge = on_right ? 1 : -1;
+  const int column_width = target_collapse_state_.uncollapsed_width;
+  ui::Layer* const column = layer();
+
+  if (visible) {
+    aerie_hidden_ = false;
+    SetVisible(true);
+    InvalidateLayout();
+    const aerie_sidebar::SlideMotion slide =
+        aerie_sidebar::ShowMotion(column_width, edge, reduced);
+    aerie::motion::LayerMotion target;
+    if (slide.animate_transform) {
+      column->SetTransform(gfx::Transform::MakeTranslation(slide.hidden_x, 0));
+      target.transform = gfx::Transform();
+    }
+    if (slide.animate_opacity) {
+      column->SetOpacity(slide.from_opacity);
+      target.opacity = slide.to_opacity;
+    }
+    aerie_motion_ = aerie::motion::AnimateLayer(
+        column, target, slide.duration, slide.easing, prefs);
+    return;
+  }
+
+  const aerie_sidebar::SlideMotion slide =
+      aerie_sidebar::HideMotion(column_width, edge, reduced);
+  aerie::motion::LayerMotion target;
+  if (slide.animate_transform) {
+    target.transform = gfx::Transform::MakeTranslation(slide.hidden_x, 0);
+  }
+  if (slide.animate_opacity) {
+    target.opacity = slide.to_opacity;
+  }
+  aerie_motion_ = aerie::motion::AnimateLayer(column, target, slide.duration,
+                                              slide.easing, prefs);
+  aerie_hide_timer_.Start(
+      FROM_HERE, base::Milliseconds(slide.duration_ms),
+      base::BindOnce(
+          [](VerticalTabStripRegionView* self) {
+            self->aerie_hidden_ = true;
+            self->SetVisible(false);
+            self->layer()->SetTransform(gfx::Transform());
+            self->layer()->SetOpacity(1.f);
+            self->InvalidateLayout();
+          },
+          base::Unretained(this)));
+}
