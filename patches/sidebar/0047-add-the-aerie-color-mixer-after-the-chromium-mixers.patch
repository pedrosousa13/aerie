Aerie-Purpose: Add the Aerie ColorMixer after Chromium's own mixers, so menus, dialogs, bubbles and the omnibox popup follow the effective Theme.
Aerie-Upstream-Area: chrome/browser/ui/color (chrome_color_mixers.cc, BUILD.gn)
Aerie-Kind: hook

Issue #185 (ADR 0007, decision 7). AddAerieColorMixer() and the ui::ColorId mapping are in the overlay,
chrome/browser/ui/color/aerie. It is the last call of AddChromeColorMixers(), so it wins over the
extension theme and the user colour for the roles it maps, and does nothing under forced colours or
until an Aerie window has set the look. ColorProviderKey has no field for the Aerie Theme, so no
Chromium header is touched: the Theme is process state, and a change resets the ColorProviderManager
cache and notifies the theme observers (see aerie_color_mixer.h).

--- a/chrome/browser/ui/color/BUILD.gn
+++ b/chrome/browser/ui/color/BUILD.gn
@@ -52,6 +52,7 @@
     "//build:branding_buildflags",
     "//chrome/app/theme:theme_resources",
     "//chrome/browser/task_manager/common",
+    "//chrome/browser/ui/color/aerie:mixer",
     "//chrome/browser/themes",
     "//chrome/browser/ui:ui_features",
     "//chrome/common/themes:autogenerated_theme_util",
--- a/chrome/browser/ui/color/chrome_color_mixers.cc
+++ b/chrome/browser/ui/color/chrome_color_mixers.cc
@@ -10,6 +10,7 @@
 #include "base/containers/fixed_flat_map.h"
 #include "base/functional/bind.h"
 #include "base/no_destructor.h"
+#include "chrome/browser/ui/color/aerie/aerie_color_mixer.h"
 #include "chrome/browser/ui/color/chrome_color_id.h"
 #include "chrome/browser/ui/color/chrome_color_mixer.h"
 #include "chrome/browser/ui/color/chrome_color_provider_utils.h"
@@ -95,4 +96,7 @@
   if (key.app_controller) {
     key.app_controller->AddColorMixers(provider, key);
   }
+
+  // Aerie: Chromium's own surfaces follow the effective Theme (issue #185).
+  aerie_color::AddAerieColorMixer(provider, key);
 }
