Aerie-Purpose: Set up the sidebar's width, side and density observers in every window, so a switch to the sidebar later works.
Aerie-Upstream-Area: chrome/browser/ui/tabs (vertical_tab_strip_state_controller_impl.cc)
Aerie-Kind: hook

Issue #186. The constructor ran its Aerie setup only when the layout was the sidebar at start. It now always runs.

--- a/chrome/browser/ui/tabs/vertical_tab_strip_state_controller_impl.cc
+++ b/chrome/browser/ui/tabs/vertical_tab_strip_state_controller_impl.cc
@@ -79,33 +79,27 @@
           &VerticalTabStripStateControllerImpl::OnExpandOnHoverEnabledChanged,
           base::Unretained(this)));
 
-  if (IsAerieSidebar()) {
-    // Aerie: the sidebar is never collapsed, and its width is the
-    // aerie.sidebar.width pref, not what a window restored (issue #177).
-    state_.collapsed = false;
-    // The rail is 56 px wide whatever width the user chose (issue #184).
-    state_.uncollapsed_width = aerie_sidebar::EffectiveWidth(*pref_service_);
-    // The side is aerie.sidebar.side. Helium's right-aligned pref, which the
-    // window layout, the frame tint and the window menu read, follows it
-    // (issue #184).
-    SyncAerieSide();
-    pref_change_registrar_.Add(
-        aerie_sidebar::kSidePref,
-        base::BindRepeating(&VerticalTabStripStateControllerImpl::SyncAerieSide,
-                            base::Unretained(this)));
-    pref_change_registrar_.Add(
-        aerie_sidebar::kDensityPref,
-        base::BindRepeating(
-            &VerticalTabStripStateControllerImpl::SyncAerieWidth,
-            base::Unretained(this)));
-  } else {
-    if (restored_state_collapsed.has_value()) {
-      SetCollapsed(restored_state_collapsed.value());
-    }
-    if (restored_state_uncollapsed_width.has_value()) {
-      SetUncollapsedWidth(restored_state_uncollapsed_width.value());
-    }
-  }
+  // Aerie: set up for the sidebar whatever the layout is now, because the
+  // layout can change to it while the window is open (issue #186). The
+  // collapsed state and the width of Helium's own vertical layout are never
+  // used: the layout is the sidebar or a horizontal one.
+  // The sidebar is never collapsed, and its width is the aerie.sidebar.width
+  // pref, not what a window restored (issue #177).
+  state_.collapsed = false;
+  // The rail is 56 px wide whatever width the user chose (issue #184).
+  state_.uncollapsed_width = aerie_sidebar::EffectiveWidth(*pref_service_);
+  // The side is aerie.sidebar.side. Helium's right-aligned pref, which the
+  // window layout, the frame tint and the window menu read, follows it
+  // (issue #184).
+  SyncAerieSide();
+  pref_change_registrar_.Add(
+      aerie_sidebar::kSidePref,
+      base::BindRepeating(&VerticalTabStripStateControllerImpl::SyncAerieSide,
+                          base::Unretained(this)));
+  pref_change_registrar_.Add(
+      aerie_sidebar::kDensityPref,
+      base::BindRepeating(&VerticalTabStripStateControllerImpl::SyncAerieWidth,
+                          base::Unretained(this)));
 
   UpdateCollapseActionItem();
 
