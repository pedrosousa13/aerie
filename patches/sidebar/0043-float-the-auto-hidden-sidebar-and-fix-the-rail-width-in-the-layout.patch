+// Aerie: the density decides the rail's width, whether the column floats and
+// whether it has a resizer (issue #184).
+void VerticalTabStripRegionView::OnAerieDensityChanged() {
+  PrefService* const prefs = browser_view()->GetProfile()->GetPrefs();
+  target_collapse_state_.uncollapsed_width =
+      aerie_sidebar::EffectiveWidth(*prefs);
+  if (!AerieAutoHides() && aerie_hidden_ &&
+      aerie_sidebar::IsVisible(*prefs)) {
+    // Leaving auto-hide: the column docks.
+    aerie_hidden_ = false;
+    aerie_target_visible_ = true;
+    SetVisible(true);
+  }
+  UpdateResizeAreaVisibility();
+  InvalidateLayout();
+}
+
+bool VerticalTabStripRegionView::AerieAutoHides() const {
+  return aerie_sidebar_view_ &&
+         aerie_sidebar::IsAutoHide(aerie_sidebar::GetDensity(
+             *browser_view()->GetProfile()->GetPrefs()));
+}
