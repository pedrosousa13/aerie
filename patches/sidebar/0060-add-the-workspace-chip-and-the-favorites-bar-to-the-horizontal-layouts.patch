Aerie-Purpose: Make the Workspace chip and the Favorites bar of the horizontal layouts when the layout changes.
Aerie-Upstream-Area: chrome/browser/ui/views/frame (browser_view.cc, horizontal_tab_strip_region_view.cc, BUILD.gn)
Aerie-Kind: hook

Issue #186. BrowserView::UpdateAerieFrameForLayout calls aerie_hz_chrome::UpdateForLayout, which adds the Workspace chip at the start of the horizontal tab strip region and, in two rows, the Favorites bar at the end of the toolbar, and takes them away again for the other layouts.

--- a/chrome/browser/ui/views/frame/browser_view.cc
+++ b/chrome/browser/ui/views/frame/browser_view.cc
@@ -154,6 +154,7 @@
 #include "chrome/browser/ui/views/accessibility/caret_browsing_dialog_delegate.h"
 #include "chrome/browser/ui/views/aerie_frame/frame_tint_enabled.h"
 #include "chrome/browser/ui/views/aerie_frame/frame_tint_view.h"
+#include "chrome/browser/ui/views/aerie_hz_chrome/aerie_hz_chrome.h"
 #include "chrome/browser/ui/views/aerie_sidebar/aerie_sidebar_toolbar_hook.h"
 #include "chrome/browser/ui/views/autofill/autofill_bubble_handler_impl.h"
 #include "chrome/browser/ui/views/bookmarks/bookmark_bar_view.h"
@@ -1866,6 +1867,9 @@
   if (multi_contents_view_) {
     multi_contents_view_->InvalidateLayout();
   }
+  // The Workspace chip and the Favorites bar of the horizontal layouts.
+  aerie_hz_chrome::UpdateForLayout(this, horizontal_tab_strip_region_view_.get(),
+                                   toolbar_.get());
   SchedulePaint();
 }
 
@@ -1893,6 +1897,11 @@
 
   UpdateZenModeState();
   UpdateTabSearchBubbleHost();
+  // Aerie (issue #186): the window is made here, and two rows and one row are
+  // Helium's classic and compact layouts, so a switch between them arrives
+  // here and not in the orientation change. The frame view, the look and the
+  // chip and Favorites bar follow the layout.
+  UpdateAerieFrameForLayout();
   InvalidateLayout();
 }
 
--- a/chrome/browser/ui/views/frame/horizontal_tab_strip_region_view.cc
+++ b/chrome/browser/ui/views/frame/horizontal_tab_strip_region_view.cc
@@ -3,6 +3,7 @@
 // found in the LICENSE file.
 
 #include "chrome/browser/ui/views/frame/horizontal_tab_strip_region_view.h"
+#include "chrome/browser/ui/views/aerie_hz_chrome/aerie_hz_chrome.h"
 
 #include "base/feature_list.h"
 #include "base/functional/bind.h"
@@ -927,6 +928,12 @@
   if (tab_strip_action_container_) {
     children.emplace_back(tab_strip_action_container_.get());
   }
+  // Aerie (issue #186): the Workspace chip is painted and hit-tested too.
+  for (views::View* child : View::children()) {
+    if (views::IsViewClass<AerieHzWorkspaceChip>(child)) {
+      children.emplace_back(child);
+    }
+  }
   return children;
 }
 
