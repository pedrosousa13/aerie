 float BrowserFrameViewLinuxNative::GetRestoredCornerRadiusDip() const {
-  return layout_->GetFrameProvider()->GetTopCornerRadiusDip();
+  // Aerie: a restored window that can draw transparent corners is rounded even
+  // when the provider reports no radius (issue #249). The base class answers
+  // non-zero exactly when the window can draw them.
+  const views::Widget* widget = GetWidget();
+  const bool restored =
+      widget && !widget->IsMaximized() && !widget->IsFullscreen();
+  return aerie_frame::WindowCornerRadius(
+      layout_->GetFrameProvider()->GetTopCornerRadiusDip(), restored,
+      BrowserFrameViewLinux::GetRestoredCornerRadiusDip() > 0);
 }
 
 void BrowserFrameViewLinuxNative::PaintRestoredFrameBorder(
     gfx::Canvas* canvas) const {
+  // Aerie: the provider paints its own radius. With none, the frame and its
+  // shadow are painted with the radius above, as the non-native frame does
+  // (issue #249).
+  if (layout_->GetFrameProvider()->GetTopCornerRadiusDip() == 0 &&
+      GetRestoredCornerRadiusDip() > 0) {
+    BrowserFrameViewLinux::PaintRestoredFrameBorder(canvas);
+    return;
+  }
   layout_->GetFrameProvider()->PaintWindowFrame(
       canvas, GetLocalBounds(), GetTopAreaHeight(), ShouldPaintAsActive(),
       GetInputInsets());
