 #include "components/aerie_adblock/browser/aerie_guard_prefs.h"
 #include "components/aerie_design_tokens/aerie_motion_prefs.h"
+#include "components/aerie_sidebar/aerie_sidebar_prefs.h"
 #include "components/aerie_tab_model/tab_model_prefs.h"
 #include "components/aerie_widevine/widevine_opt_in.h"
 #include "components/autofill/core/common/autofill_prefs.h"
@@ -2004,6 +2005,7 @@
   aerie_guard::RegisterProfilePrefs(registry);
   aerie::motion::RegisterProfilePrefs(registry);
   aerie_tab_model::RegisterProfilePrefs(registry);
+  aerie_sidebar::RegisterProfilePrefs(registry);
   registry->RegisterBooleanPref(prefs::kRendererAccessibilityEnabled, true);
   AccessibilityUIMessageHandler::RegisterProfilePrefs(registry);
 #if !BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_DESKTOP_ANDROID)  // nocheck
