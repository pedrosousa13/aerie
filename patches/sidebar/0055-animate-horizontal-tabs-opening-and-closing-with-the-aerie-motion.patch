+bool UnpinnedTabContainerView::ShouldAnimateAerieMotion(
+    const views::View& child_view) const {
+  // Only the tabs of the horizontal strip: a vertical strip has Chromium's.
+  return orientation_ == TabStripOrientation::kHorizontal &&
+         views::IsViewClass<TabView>(&child_view);
+}
+
+const PrefService* UnpinnedTabContainerView::GetPrefsForMotion() const {
+  if (!collection_node_ || !collection_node_->GetController()) {
+    return nullptr;
+  }
+  BrowserView* const browser_view =
+      collection_node_->GetController()->GetBrowserView();
+  return browser_view ? browser_view->GetProfile()->GetPrefs() : nullptr;
+}
+
 bool UnpinnedTabContainerView::ShouldSnapToTarget(
     const views::View& child_view) const {
   return views::IsViewClass<SplitTabView>(&child_view);
