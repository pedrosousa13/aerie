@@ -82,7 +83,21 @@
     // Aerie: the sidebar is never collapsed, and its width is the
     // aerie.sidebar.width pref, not what a window restored (issue #177).
     state_.collapsed = false;
-    state_.uncollapsed_width = aerie_sidebar::GetWidth(*pref_service_);
+    // The rail is 56 px wide whatever width the user chose (issue #184).
+    state_.uncollapsed_width = aerie_sidebar::EffectiveWidth(*pref_service_);
+    // The side is aerie.sidebar.side. Helium's right-aligned pref, which the
+    // window layout, the frame tint and the window menu read, follows it
+    // (issue #184).
+    SyncAerieSide();
+    pref_change_registrar_.Add(
+        aerie_sidebar::kSidePref,
+        base::BindRepeating(&VerticalTabStripStateControllerImpl::SyncAerieSide,
+                            base::Unretained(this)));
+    pref_change_registrar_.Add(
+        aerie_sidebar::kDensityPref,
+        base::BindRepeating(
+            &VerticalTabStripStateControllerImpl::SyncAerieWidth,
+            base::Unretained(this)));
   } else {
     if (restored_state_collapsed.has_value()) {
       SetCollapsed(restored_state_collapsed.value());
@@ -196,6 +211,14 @@
 
 void VerticalTabStripStateControllerImpl::SetTabStripRightAligned(
     bool right_aligned) {
+  if (IsAerieSidebar()) {
+    // Aerie: the side is aerie.sidebar.side (issue #184); SyncAerieSide moves
+    // Helium's pref after it.
+    pref_service_->SetString(aerie_sidebar::kSidePref,
+                             right_aligned ? aerie_sidebar::kSideRight
+                                           : aerie_sidebar::kSideLeft);
+    return;
+  }
   pref_service_->SetBoolean(prefs::kHeliumVerticalRightAligned, right_aligned);
 }
 
@@ -240,6 +263,18 @@
   return state_.uncollapsed_width;
 }
 
+void VerticalTabStripStateControllerImpl::SyncAerieSide() {
+  const bool right = aerie_sidebar::IsOnRight(*pref_service_);
+  if (pref_service_->GetBoolean(prefs::kHeliumVerticalRightAligned) != right) {
+    pref_service_->SetBoolean(prefs::kHeliumVerticalRightAligned, right);
+  }
+}
+
+void VerticalTabStripStateControllerImpl::SyncAerieWidth() {
+  // The region view applies it to the layout; this keeps the state honest.
+  state_.uncollapsed_width = aerie_sidebar::EffectiveWidth(*pref_service_);
+}
+
 bool VerticalTabStripStateControllerImpl::IsAerieSidebar() const {
   return pref_service_ && aerie_sidebar::IsSidebarLayout(*pref_service_);
 }
