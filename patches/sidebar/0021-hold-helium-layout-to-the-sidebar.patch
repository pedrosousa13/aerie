+  // Aerie: while the layout is the sidebar, Helium's layout is vertical and
+  // Zen mode is off, whoever writes the prefs (issue #177). A write of another
+  // value is put back before the state-changed callbacks run.
+  aerie_sidebar::EnforceHeliumLayout(pref_service_);
   pref_change_registrar_.AddMultiple(
-      {prefs::kHeliumLayout, prefs::kHeliumZenMode},
-      base::BindRepeating(&HeliumLayoutStateController::NotifyStateChanged,
-                          base::Unretained(this)));
+      {prefs::kHeliumLayout, prefs::kHeliumZenMode, aerie_sidebar::kLayoutPref},
+      base::BindRepeating(
+          [](HeliumLayoutStateController* self, PrefService* prefs) {
+            aerie_sidebar::EnforceHeliumLayout(prefs);
+            self->NotifyStateChanged();
+          },
+          base::Unretained(this), pref_service_.get()));
 }
 
