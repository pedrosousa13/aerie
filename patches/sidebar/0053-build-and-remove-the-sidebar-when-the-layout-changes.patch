+// Aerie: builds the sidebar view in the column (issue #177) and starts to follow
+// the prefs that move it. Called by the constructor for the sidebar layout, and
+// by SetAerieSidebarEnabled when the user switches to it (issue #186).
+void VerticalTabStripRegionView::AddAerieSidebar() {
+  CHECK(!aerie_sidebar_view_);
+  bottom_button_container_->SetVisible(false);
+  aerie_sidebar_view_ = content_area_view_->AddChildViewAt(
+      std::make_unique<AerieSidebarView>(
+          browser_view()->browser(),
+          base::BindRepeating(
+              [](actions::ActionItem* root, BrowserView* view) {
+                if (auto* action = actions::ActionManager::Get().FindAction(
+                        kActionNewTab, root)) {
+                  action->InvokeAction();
+                }
+              },
+              base::Unretained(root_action_item()),
+              base::Unretained(browser_view()))),
+      *content_area_view_->GetIndexOf(bottom_button_container_));
+  aerie_sidebar_view_->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                               views::MaximumFlexSizeRule::kUnbounded));
+  // Shown or hidden as the pref says (Ctrl+S flips it), now and when it
+  // changes.
+  PrefService* const prefs = browser_view()->GetProfile()->GetPrefs();
+  aerie_hidden_ = !aerie_sidebar::IsVisible(*prefs);
+  aerie_target_visible_ = !aerie_hidden_;
+  aerie_pref_registrar_.Init(prefs);
+  aerie_pref_registrar_.Add(
+      aerie_sidebar::kVisiblePref,
+      base::BindRepeating(&VerticalTabStripRegionView::OnAerieVisibleChanged,
+                          base::Unretained(this)));
+  // The density sets the rail's fixed width, the resize area and whether the
+  // column floats (issue #184).
+  aerie_pref_registrar_.Add(
+      aerie_sidebar::kDensityPref,
+      base::BindRepeating(&VerticalTabStripRegionView::OnAerieDensityChanged,
+                          base::Unretained(this)));
+}
+
+// Aerie: what the region says about itself while it holds the sidebar view.
+void VerticalTabStripRegionView::UpdateAerieChrome() {
+  if (resize_area_) {
+    resize_area_->GetViewAccessibility().SetName(l10n_util::GetStringUTF16(
+        aerie_sidebar_view_ ? IDS_AERIE_SIDEBAR_RESIZE
+                            : IDS_VERTICAL_RESIZE_AREA));
+    resize_area_->GetViewAccessibility().SetRole(
+        aerie_sidebar_view_ ? ax::mojom::Role::kSplitter
+                            : ax::mojom::Role::kSlider);
+  }
+  // The sidebar view is the navigation landmark and holds the tree of tabs, so
+  // this container is no tab list.
+  GetViewAccessibility().SetRole(aerie_sidebar_view_
+                                     ? ax::mojom::Role::kGenericContainer
+                                     : ax::mojom::Role::kTabList);
+}
+
+// Aerie (issue #186): the layout changed. Builds the sidebar view, or takes it
+// away. The toolbar's parts that the sidebar holds are given back first by
+// aerie_sidebar::ReleaseToolbar (the caller does that), and the tab strip is
+// reset or initialised by BrowserView around this call.
+void VerticalTabStripRegionView::SetAerieSidebarEnabled(bool enabled) {
+  if (enabled == !!aerie_sidebar_view_) {
+    return;
+  }
+  if (enabled) {
+    AddAerieSidebar();
+    if (tab_strip_view()) {
+      tab_strip_view()->SetVisible(false);
+    }
+  } else {
+    aerie_pref_registrar_.RemoveAll();
+    aerie_hide_timer_.Stop();
+    aerie_motion_.Abort();
+    aerie_hide_slide_.End();
+    aerie_hidden_ = false;
+    aerie_target_visible_ = true;
+    if (layer()) {
+      layer()->SetTransform(gfx::Transform());
+      layer()->SetOpacity(1.f);
+    }
+    AerieSidebarView* const view = aerie_sidebar_view_;
+    aerie_sidebar_view_ = nullptr;
+    content_area_view_->RemoveChildViewT(view);
+    bottom_button_container_->SetVisible(true);
+    if (tab_strip_view()) {
+      tab_strip_view()->SetVisible(true);
+    }
+  }
+  UpdateAerieChrome();
+  if (resize_area_) {
+    UpdateResizeAreaVisibility();
+  }
+  UpdateInteriorMargin();
+  InvalidateLayout();
+}
+
+bool VerticalTabStripRegionView::ReleaseAerieToolbar() {
+  return aerie_sidebar_view_ && aerie_sidebar_view_->ReleaseToolbar();
+}
