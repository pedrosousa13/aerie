+// Aerie (issue #186): the window frame follows the layout. The tint is the
+// frame of the sidebar layout only (aerie_frame::ShouldTintFrame reads the
+// pref), so the view is made when the user first switches to the sidebar and
+// hidden while the layout is a horizontal one, where Helium's own frame fills
+// paint again.
+void BrowserView::UpdateAerieFrameForLayout() {
+  const bool tint = aerie_frame::ShouldTintFrame(this);
+  if (tint && !frame_tint_view_ && GetIsNormalType()) {
+    frame_tint_view_ = AddChildViewAt(
+        std::make_unique<FrameTintView>(GetProfile()), 0);
+    if (multi_contents_view_) {
+      frame_tint_view_->SetCard(
+          multi_contents_view_->GetActiveContentsContainerView());
+    }
+  }
+  if (frame_tint_view_) {
+    frame_tint_view_->SetVisible(tint);
+  }
+  if (multi_contents_view_) {
+    multi_contents_view_->InvalidateLayout();
+  }
+  SchedulePaint();
+}
