 void VerticalTabStripStateControllerImpl::SetUncollapsedWidth(int width) {
+  if (IsAerieSidebar()) {
+    // Aerie: the width is limited and stored in aerie.sidebar.width.
+    width = aerie_sidebar::ClampWidth(width);
+    if (pref_service_->GetInteger(aerie_sidebar::kWidthPref) != width) {
+      pref_service_->SetInteger(aerie_sidebar::kWidthPref, width);
+    }
+  }
   if (state_.uncollapsed_width != width) {
