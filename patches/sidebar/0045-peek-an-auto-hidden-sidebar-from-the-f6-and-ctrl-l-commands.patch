--- a/chrome/browser/ui/views/frame/vertical_tab_strip_region_view.cc
+++ b/chrome/browser/ui/views/frame/vertical_tab_strip_region_view.cc
@@ -421,6 +421,12 @@
   }
 }
 
+void VerticalTabStripRegionView::PeekAerieSidebarForPaneFocus() {
+  if (aerie_sidebar_view_ && AerieAutoHides()) {
+    aerie_sidebar_view_->PeekForPaneFocus();
+  }
