+// Aerie keeps crash reports on the device (issue #262, docs/crash-reports.md): none is
+// deleted for being pending, and the oldest beyond the limit go. The folder walk does file
+// I/O, so it runs on the thread pool.
+void PruneReportsInBackground() {
+  // Crashpad's own path when it runs; else the folder it would use. Never skip silently.
+  base::FilePath dir;
+  if (std::optional<base::FilePath> database =
+          crash_reporter::GetCrashpadDatabasePath()) {
+    dir = *database;
+  } else if (!base::PathService::Get(chrome::DIR_CRASH_DUMPS, &dir)) {
+    LOG(ERROR) << "Aerie: no crash folder to prune";
+    return;
   }
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(
+          [](base::FilePath dir) {
+            aerie_crash_reports::CrashReportStore(dir).Prune();
+          },
+          dir));
 }
 
