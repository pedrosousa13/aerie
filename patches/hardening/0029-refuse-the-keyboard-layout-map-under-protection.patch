     std::move(callback).Run(std::move(response));
     return;
   }
+  // Aerie (issue #203): the layout gives away the user's region. The decision
+  // that gives a page its noise tokens (the pref and the per-site setting, read
+  // here in the browser process), made for the site of the page the user is on,
+  // so a frame of another site gets its top page's answer. It is false when
+  // the HeliumNoise feature is off. A top page with an opaque origin has an
+  // empty URL here; the per-site lookup skips such a URL and answers from the
+  // feature and the pref alone, so the map is refused (fail closed, as for the
+  // noise tokens). lock() and unlock() are not touched.
+  if (aerie_keyboard_layout::ShouldRefuseLayoutMap(
+          {.site_protected = GetContentClient()->browser()->HeliumNoiseEnabled(
+               frame_host_impl.GetBrowserContext(),
+               frame_host_impl.GetOutermostMainFrame()
+                   ->GetLastCommittedOrigin()
+                   .GetURL())})) {
+    response->status = blink::mojom::GetKeyboardLayoutMapStatus::kNotSupported;
+    std::move(callback).Run(std::move(response));
+    return;
+  }
   response->status = blink::mojom::GetKeyboardLayoutMapStatus::kSuccess;
   response->layout_map = frame_host_impl.GetPage().GetKeyboardLayoutMap();
 
