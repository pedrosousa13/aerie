 namespace content_settings {
 
+namespace {
+
+// Aerie: hides the rules that must not take effect from the iterator of the
+// extension store.
+class ThirdPartyCookieAllowFilter : public RuleIterator {
+ public:
+  ThirdPartyCookieAllowFilter(std::unique_ptr<RuleIterator> inner,
+                              ContentSettingsType content_type)
+      : inner_(std::move(inner)), content_type_(content_type) {
+    Advance();
+  }
+  ~ThirdPartyCookieAllowFilter() override = default;
+
+  bool HasNext() const override { return next_ != nullptr; }
+
+  std::unique_ptr<Rule> Next() override {
+    std::unique_ptr<Rule> out = std::move(next_);
+    Advance();
+    return out;
+  }
+
+ private:
+  void Advance() {
+    next_.reset();
+    while (inner_ && inner_->HasNext()) {
+      std::unique_ptr<Rule> rule = inner_->Next();
+      if (content_type_ == ContentSettingsType::COOKIES &&
+          CustomExtensionProvider::IsCookieAllowForThirdPartyContext(
+              rule->primary_pattern, rule->secondary_pattern, rule->value)) {
+        continue;
+      }
+      next_ = std::move(rule);
+      return;
+    }
+  }
+
+  std::unique_ptr<RuleIterator> inner_;
+  ContentSettingsType content_type_;
+  std::unique_ptr<Rule> next_;
+};
+
+}  // namespace
+
 CustomExtensionProvider::CustomExtensionProvider(
     const scoped_refptr<extensions::ContentSettingsStore>& extensions_settings,
-    bool incognito)
-    : incognito_(incognito), extensions_settings_(extensions_settings) {
+    bool incognito,
+    PrefService* prefs)
+    : incognito_(incognito),
+      extensions_settings_(extensions_settings),
+      prefs_(prefs) {
   content_settings_store_observation_.Observe(extensions_settings_.get());
+  if (prefs_) {
+    cookie_controls_mode_.store(prefs_->GetInteger(prefs::kCookieControlsMode));
+    pref_change_registrar_.Init(prefs_);
+    pref_change_registrar_.Add(
+        prefs::kCookieControlsMode,
+        base::BindRepeating(&CustomExtensionProvider::OnCookieControlsModeChanged,
+                            base::Unretained(this)));
+  }
+}
+
+// static
+bool CustomExtensionProvider::IsCookieAllowForThirdPartyContext(
+    const ContentSettingsPattern& primary_pattern,
+    const ContentSettingsPattern& secondary_pattern,
+    const base::Value& value) {
+  const ContentSetting setting = ValueToContentSetting(value);
+  if (setting != CONTENT_SETTING_ALLOW &&
+      setting != CONTENT_SETTING_SESSION_ONLY) {
+    return false;
+  }
+  const bool first_party_only = secondary_pattern == primary_pattern &&
+                                !primary_pattern.MatchesAllHosts() &&
+                                !primary_pattern.HasDomainWildcard();
+  return !first_party_only;
+}
+
+bool CustomExtensionProvider::ThirdPartyCookiesBlocked(bool incognito) const {
+  if (!prefs_) {
+    return false;
+  }
+  // The same rule as CookieSettings::ShouldBlockThirdPartyCookiesInternal.
+  return cookie_controls_mode_.load() ==
+             static_cast<int>(CookieControlsMode::kBlockThirdParty) ||
+         incognito;
+}
+
+void CustomExtensionProvider::OnCookieControlsModeChanged() {
+  cookie_controls_mode_.store(prefs_->GetInteger(prefs::kCookieControlsMode));
+  // The rules that count have changed, although the store has not.
+  NotifyObservers(ContentSettingsPattern::Wildcard(),
+                  ContentSettingsPattern::Wildcard(),
+                  ContentSettingsType::COOKIES);
 }
 
