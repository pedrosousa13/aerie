+namespace {
+
+const char kBlockingKey[] = "aerie.third_party_cookie_blocking";
+
+struct BlockingData : public base::SupportsUserData::Data {
+  scoped_refptr<ThirdPartyCookieBlocking> blocking;
+};
+
+// Aerie (#166): hides the rules that must not take effect from the iterator of
+// the extension store.
+class ThirdPartyCookieAllowFilter : public RuleIterator {
+ public:
+  explicit ThirdPartyCookieAllowFilter(std::unique_ptr<RuleIterator> inner)
+      : inner_(std::move(inner)) {
+    Advance();
+  }
+  ~ThirdPartyCookieAllowFilter() override = default;
+
+  bool HasNext() const override { return next_ != nullptr; }
+
+  std::unique_ptr<Rule> Next() override {
+    std::unique_ptr<Rule> out = std::move(next_);
+    Advance();
+    return out;
+  }
+
+ private:
+  void Advance() {
+    next_.reset();
+    while (inner_->HasNext()) {
+      std::unique_ptr<Rule> rule = inner_->Next();
+      if (CustomExtensionProvider::IsCookieAllowForThirdPartyContext(
+              rule->primary_pattern, rule->secondary_pattern,
+              ValueToContentSetting(rule->value))) {
+        continue;
+      }
+      next_ = std::move(rule);
+      return;
+    }
+  }
+
+  std::unique_ptr<RuleIterator> inner_;
+  std::unique_ptr<Rule> next_;
+};
+
+}  // namespace
+
+// static
+scoped_refptr<ThirdPartyCookieBlocking> ThirdPartyCookieBlocking::GetOrCreateFor(
+    base::SupportsUserData* profile) {
+  auto* data = static_cast<BlockingData*>(profile->GetUserData(kBlockingKey));
+  if (!data) {
+    auto created = std::make_unique<BlockingData>();
+    created->blocking = base::MakeRefCounted<ThirdPartyCookieBlocking>();
+    data = created.get();
+    profile->SetUserData(kBlockingKey, std::move(created));
+  }
+  return data->blocking;
+}
+
+ThirdPartyCookieBlocking::ThirdPartyCookieBlocking() = default;
+ThirdPartyCookieBlocking::~ThirdPartyCookieBlocking() = default;
+
+void ThirdPartyCookieBlocking::Bind(
+    scoped_refptr<CookieSettings> cookie_settings) {
+  CHECK(cookie_settings);
+  cookie_settings->AddObserver(this);
+  {
+    base::AutoLock auto_lock(lock_);
+    cookie_settings_ = std::move(cookie_settings);
+  }
+  // From "unbound, so blocked" to the real answer.
+  OnThirdPartyCookieBlockingChanged(Blocked());
+}
+
+void ThirdPartyCookieBlocking::Shutdown() {
+  scoped_refptr<CookieSettings> cookie_settings;
+  {
+    base::AutoLock auto_lock(lock_);
+    cookie_settings = std::move(cookie_settings_);
+  }
+  if (cookie_settings) {
+    cookie_settings->RemoveObserver(this);
+  }
+  changed_callback_.Reset();
+}
+
+void ThirdPartyCookieBlocking::SetChangedCallback(
+    base::RepeatingClosure callback) {
+  changed_callback_ = std::move(callback);
+}
+
+bool ThirdPartyCookieBlocking::Blocked() const {
+  scoped_refptr<CookieSettings> cookie_settings;
+  {
+    base::AutoLock auto_lock(lock_);
+    cookie_settings = cookie_settings_;
+  }
+  // The same call patch 0016 makes: no top-frame origin, no overrides.
+  return !cookie_settings || cookie_settings->ShouldBlockThirdPartyCookies();
+}
+
+void ThirdPartyCookieBlocking::OnThirdPartyCookieBlockingChanged(bool) {
+  if (changed_callback_) {
+    changed_callback_.Run();
+  }
+}
