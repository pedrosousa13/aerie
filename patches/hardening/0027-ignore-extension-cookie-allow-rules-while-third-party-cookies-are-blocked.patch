+// Aerie (#166): where the provider learns whether third-party cookies are
+// blocked. It asks the real CookieSettings of the same profile, so the answer
+// is the one cookie decisions use (cookie controls mode, incognito, forced
+// blocking, modifiers) and not a copy of it. The map and its providers are
+// built before CookieSettings, so CookieSettingsFactory binds it later. Until
+// it is bound, and after Shutdown, it says "blocked": the filter fails closed.
+// Safe on any thread, except Bind, Shutdown and SetChangedCallback (UI).
+class ThirdPartyCookieBlocking
+    : public base::RefCountedThreadSafe<ThirdPartyCookieBlocking>,
+      public CookieSettings::Observer {
+ public:
+  // The one holder of a profile (regular or off the record), kept on it.
+  static scoped_refptr<ThirdPartyCookieBlocking> GetOrCreateFor(
+      base::SupportsUserData* profile);
+
+  ThirdPartyCookieBlocking();
+  ThirdPartyCookieBlocking(const ThirdPartyCookieBlocking&) = delete;
+  ThirdPartyCookieBlocking& operator=(const ThirdPartyCookieBlocking&) =
+      delete;
+
+  void Bind(scoped_refptr<CookieSettings> cookie_settings);
+  // Drops the CookieSettings and the callback, which breaks the reference
+  // cycle (CookieSettings -> map -> provider -> this -> CookieSettings).
+  void Shutdown();
+  // Runs on the UI thread when the answer may have changed.
+  void SetChangedCallback(base::RepeatingClosure callback);
+
+  bool Blocked() const;
+
+  // CookieSettings::Observer:
+  void OnThirdPartyCookieBlockingChanged(
+      bool block_third_party_cookies) override;
+
+ private:
+  friend class base::RefCountedThreadSafe<ThirdPartyCookieBlocking>;
+  ~ThirdPartyCookieBlocking() override;
+
+  mutable base::Lock lock_;
+  scoped_refptr<CookieSettings> cookie_settings_ GUARDED_BY(lock_);
+  base::RepeatingClosure changed_callback_;
+};
