+// static
+bool CanvasNoisingHelper::MaybeNoiseReadPixels(
+    ExecutionContext* execution_context,
+    base::span<uint8_t> buffer,
+    int width,
+    int height,
+    int x,
+    int y,
+    size_t first_pixel_offset,
+    size_t row_stride) {
+  std::optional<HeliumNoiseHash> token_hash =
+      GetCanvasTokenHash(execution_context);
+  if (!token_hash) {
+    return false;
+  }
+  if (width <= 0 || height <= 0) {
+    return false;
+  }
+
+  // Check that the rows lie inside the buffer before touching them.
+  const size_t row_bytes = static_cast<size_t>(width) * kChannelsPerPixel;
+  base::CheckedNumeric<size_t> needed = static_cast<size_t>(height - 1);
+  needed *= row_stride;
+  needed += row_bytes;
+  needed += first_pixel_offset;
+  if (!needed.IsValid() || needed.ValueOrDie() > buffer.size() ||
+      row_stride < row_bytes) {
+    return false;
+  }
+
+  if (row_stride == row_bytes) {
+    return HeliumNoisePixelBuffer(
+        *token_hash, kRGBA_8888_SkColorType,
+        buffer.subspan(first_pixel_offset, row_bytes * height), width, height,
+        x, y);
+  }
+
+  // Rows with padding or a wider PACK_ROW_LENGTH: noise a tightly packed copy,
+  // so the neighbourhood of each pixel is the same as for a tight read, and
+  // copy the rows back without touching the padding.
+  std::vector<uint8_t> packed(row_bytes * height);
+  for (int row = 0; row < height; ++row) {
+    auto source = buffer.subspan(first_pixel_offset + row * row_stride,
+                                 row_bytes);
+    std::ranges::copy(source, packed.begin() + row * row_bytes);
+  }
+  if (!HeliumNoisePixelBuffer(*token_hash, kRGBA_8888_SkColorType, packed,
+                              width, height, x, y)) {
+    return false;
+  }
+  for (int row = 0; row < height; ++row) {
+    auto destination = buffer.subspan(first_pixel_offset + row * row_stride,
+                                      row_bytes);
+    std::ranges::copy(
+        base::span(packed).subspan(row * row_bytes, row_bytes),
+        destination.begin());
+  }
+  return true;
+}
+
 }  // namespace blink
