+// The screen point that a mouse, pointer, touch or drag event of a protected
+// window carries (Aerie, issue #159). The window reports its position as 0,0,
+// so the event's point is `point_in_page` (the client point in CSS pixels, as
+// clientX reads it) plus the difference between the outerWidth and innerWidth
+// the page reads. Then screenX - clientX matches the page's own outer - inner
+// at every zoom, and the real window position and the real screen never reach
+// the page through an event.
+inline gfx::PointF ProtectedEventScreenPoint(const LocalDOMWindow* window,
+                                             const gfx::PointF& point_in_page) {
+  const aerie_screen::PointF point = aerie_screen::EventScreenPoint(
+      {point_in_page.x(), point_in_page.y()},
+      {window->outerWidth(), window->outerHeight()},
+      {window->innerWidth(), window->innerHeight()});
+  return gfx::PointF(point.x, point.y);
+}
+
 }  // namespace blink
 
