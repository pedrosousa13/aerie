+class Profile;
+
+namespace settings {
+
+// Lists, and lets the user remove, the sites that were allowed to load over
+// plain HTTP from the HTTPS-only warning page. The exceptions are the
+// HTTP_ALLOWED content settings written by
+// security_interstitials::HttpsOnlyModeAllowlist.
+class AerieHardeningHandler : public SettingsPageUIHandler {
+ public:
+  explicit AerieHardeningHandler(Profile* profile);
+  AerieHardeningHandler(const AerieHardeningHandler&) = delete;
+  AerieHardeningHandler& operator=(const AerieHardeningHandler&) = delete;
+  ~AerieHardeningHandler() override;
+
+  // SettingsPageUIHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+ private:
+  base::ListValue GetHttpExceptions() const;
+  void HandleGetHttpExceptions(const base::ListValue& args);
+  void HandleRemoveHttpException(const base::ListValue& args);
+
+  raw_ptr<Profile> profile_;
+};
+
+}  // namespace settings
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SETTINGS_AERIE_HARDENING_HANDLER_H_
