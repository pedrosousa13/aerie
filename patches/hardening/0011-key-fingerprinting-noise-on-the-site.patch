+// Aerie (#114): removes the exception for one pattern pair (a default setting
+// is no rule). The per-site switch is aerie_fingerprint::NoiseSitePattern:
+// "https://[*.]example.com", the same scheme and hosts that share a noise
+// token (aerie_fingerprint::NoiseSiteKey).
+void ClearRule(HostContentSettingsMap* map,
+               const ContentSettingsPattern& primary,
+               const ContentSettingsPattern& secondary) {
+  map->SetContentSettingCustomScope(primary, secondary,
+                                    ContentSettingsType::HELIUM_NOISE,
+                                    CONTENT_SETTING_DEFAULT);
+}
+
+const void* const kOriginExceptionsMigratedKey =
+    &kOriginExceptionsMigratedKey;
+
+class OriginExceptionsMigrated : public base::SupportsUserData::Data {};
+
+// Before #114 the switch was set for one origin ("https://a.example.com:443").
+// Turns each such "off" exception into one for the whole site, once per
+// profile object (it is idempotent, so a restart can run it again). Skips the
+// off-the-record profile: its exceptions are in memory and start empty.
+void MigrateOriginExceptions(Profile* profile, HostContentSettingsMap* map) {
+  if (profile->IsOffTheRecord() ||
+      profile->GetUserData(kOriginExceptionsMigratedKey)) {
+    return;
+  }
+  profile->SetUserData(kOriginExceptionsMigratedKey,
+                       std::make_unique<OriginExceptionsMigrated>());
+
+  for (const ContentSettingPatternSource& rule :
+       map->GetSettingsForOneType(ContentSettingsType::HELIUM_NOISE)) {
+    if (rule.source != content_settings::mojom::ProviderType::kPrefProvider ||
+        rule.GetContentSetting() != CONTENT_SETTING_BLOCK ||
+        rule.primary_pattern.HasDomainWildcard()) {
+      continue;
+    }
+    const ContentSettingsPattern site_pattern =
+        aerie_fingerprint::NoiseSitePattern(
+            GURL(rule.primary_pattern.ToString()));
+    if (!site_pattern.IsValid() || site_pattern == rule.primary_pattern) {
+      continue;
+    }
+    map->SetContentSettingCustomScope(
+        site_pattern, ContentSettingsPattern::Wildcard(),
+        ContentSettingsType::HELIUM_NOISE, CONTENT_SETTING_BLOCK);
+    ClearRule(map, rule.primary_pattern, rule.secondary_pattern);
+  }
+}
+
 }  // namespace
 
