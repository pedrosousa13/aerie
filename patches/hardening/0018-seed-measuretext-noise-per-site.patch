+// Copyright 2026 The Aerie Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_TEXT_METRICS_NOISE_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_TEXT_METRICS_NOISE_H_
+
+#include "third_party/blink/renderer/core/core_export.h"
+
+namespace blink {
+
+class ExecutionContext;
+
+// Which value the factor is for. Each kind gets its own factor from the same
+// token, so one factor does not give away another.
+enum class TextMetricsNoiseKind {
+  kMeasureText,
+  kClientRectsX,
+  kClientRectsY,
+};
+
+// The factor that CanvasRenderingContext2D.measureText and, when its flag is
+// on, getClientRects and getBoundingClientRect scale their values by (Aerie,
+// issue #118). It is derived from the context's kTextMetrics token, which the
+// browser derives per site and session, so every load of one site in a session
+// reads one factor and another site reads another. The browser sends the token
+// only while protection is on for the site, so 1.0 (no change) means "not
+// protected here": turning protection off, globally or for the site, gives the
+// real values back.
+CORE_EXPORT double TextMetricsNoiseFactor(const ExecutionContext* context,
+                                          TextMetricsNoiseKind kind);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_TEXT_METRICS_NOISE_H_
