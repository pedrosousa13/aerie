+
+#include "third_party/blink/renderer/core/helium_noise/text_metrics_noise.h"
+
+#include <cstdint>
+
+#include "base/feature_list.h"
+#include "components/aerie_text_metrics/text_metrics_noise.h"
+#include "third_party/blink/public/common/features.h"
+#include "third_party/blink/public/common/helium_noise/noise_token.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/helium_noise/helium_noise_hash.h"
+
+namespace blink {
+
+double TextMetricsNoiseFactor(const ExecutionContext* context,
+                              TextMetricsNoiseKind kind) {
+  if (!context) {
+    return 1.0;
+  }
+  const HeliumNoiseTokenMap& tokens = context->GetHeliumNoiseTokens();
+  const bool has_token = tokens.contains(HeliumNoiseFeature::kTextMetrics);
+  if (!aerie_text_metrics::ShouldNoiseTextMetrics(
+          {.master_enabled = base::FeatureList::IsEnabled(features::kHeliumNoise),
+           .surface_enabled =
+               base::FeatureList::IsEnabled(features::kHeliumNoiseTextMetrics),
+           .has_token = has_token})) {
+    return 1.0;
+  }
+
+  HeliumNoiseHash hash(tokens.at(HeliumNoiseFeature::kTextMetrics));
+  hash.Update(static_cast<uint64_t>(kind) + 1);
+  return aerie_text_metrics::NoiseFactor(
+      hash.GetValueBelow(aerie_text_metrics::kSteps));
+}
+
+}  // namespace blink
