+// Copyright 2026 The Aerie Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+/**
+ * Talks to AerieHardeningHandler (chrome/browser/ui/webui/settings).
+ */
+export interface AerieHardeningBrowserProxy {
+  /** Hosts the user allowed over plain HTTP, sorted. */
+  getHttpExceptions(): Promise<string[]>;
+
+  /** Takes one host off the list. */
+  removeHttpException(host: string): Promise<void>;
+}
+
+let instance: AerieHardeningBrowserProxy|null = null;
+
+export class AerieHardeningBrowserProxyImpl implements
+    AerieHardeningBrowserProxy {
+  getHttpExceptions() {
+    return sendWithPromise('getAerieHttpExceptions');
+  }
+
+  removeHttpException(host: string) {
+    return sendWithPromise('removeAerieHttpException', host);
+  }
+
+  static getInstance(): AerieHardeningBrowserProxy {
+    return instance || (instance = new AerieHardeningBrowserProxyImpl());
+  }
+
+  static setInstance(obj: AerieHardeningBrowserProxy) {
+    instance = obj;
+  }
+}
