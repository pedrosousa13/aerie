+// Copyright 2026 The Aerie Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-aerie-hardening-page' lists the privacy and security protections
+ * Aerie turns on by default, with each default and its cost, and the sites
+ * the user allowed over plain HTTP. The markup in hardening_page.html is
+ * generated from tools/aerie_hardening/controls.json.
+ */
+
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import '../controls/settings_dropdown_menu.js';
+import '../controls/settings_toggle_button.js';
+import '../settings_page/settings_subpage.js';
+
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {routes} from '../route.js';
+import type {Route} from '../router.js';
+import {SettingsViewMixinLit} from '../settings_page/settings_view_mixin_lit.js';
+
+import {AerieHardeningBrowserProxyImpl} from './hardening_browser_proxy.js';
+import type {AerieHardeningBrowserProxy} from './hardening_browser_proxy.js';
+import {getCss} from './hardening_page.css.js';
+import {getHtml} from './hardening_page.html.js';
+import {HARDENING_MENU_OPTIONS} from './hardening_menu_options.js';
+
+const SettingsAerieHardeningPageElementBase =
+    SettingsViewMixinLit(CrLitElement);
+
+// html_to_wrapper names the element type after the file: hardening_page.html
+// gets HardeningPageElement.
+export type HardeningPageElement = SettingsAerieHardeningPageElement;
+
+export class SettingsAerieHardeningPageElement extends
+    SettingsAerieHardeningPageElementBase {
+  static get is() {
+    return 'settings-aerie-hardening-page';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      httpExceptions_: {type: Array},
+    };
+  }
+
+  protected accessor httpExceptions_: string[] = [];
+
+  // Built once, so the dropdowns do not get a new array on every render.
+  protected readonly menuOptions_ = HARDENING_MENU_OPTIONS;
+
+  private browserProxy_: AerieHardeningBrowserProxy =
+      AerieHardeningBrowserProxyImpl.getInstance();
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.refreshHttpExceptions_();
+  }
+
+  override currentRouteChanged(route: Route, oldRoute?: Route) {
+    super.currentRouteChanged(route, oldRoute);
+
+    // A site can be allowed in another tab at any time, so read the list
+    // again whenever the user comes to this page.
+    if (route === routes.AERIE_HARDENING) {
+      this.refreshHttpExceptions_();
+    }
+  }
+
+  protected onRemoveHttpException_(e: Event) {
+    const host = (e.currentTarget as HTMLElement).dataset['host'];
+    if (!host) {
+      return;
+    }
+    this.browserProxy_.removeHttpException(host).then(
+        () => this.refreshHttpExceptions_());
+  }
+
+  private refreshHttpExceptions_() {
+    return this.browserProxy_.getHttpExceptions().then((hosts: string[]) => {
+      this.httpExceptions_ = hosts;
+    });
+  }
+
+  // SettingsViewMixinLit implementation.
+  override focusBackButton() {
+    this.shadowRoot.querySelector('settings-subpage')!.focusBackButton();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-aerie-hardening-page': SettingsAerieHardeningPageElement;
+  }
+}
+
+customElements.define(
+    SettingsAerieHardeningPageElement.is, SettingsAerieHardeningPageElement);
