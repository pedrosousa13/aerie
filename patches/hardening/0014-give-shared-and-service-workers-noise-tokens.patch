 // static
+blink::HeliumNoiseTokenMap HeliumNoiseTokenData::GetTokensForWorker(
+    BrowserContext* context,
+    const blink::StorageKey& key) {
+  if (!context) {
+    return {};
+  }
+  // The top-level site of the storage key is the site of the page that embeds
+  // the worker (its own site for a first-party worker), the same site that
+  // keys the tokens of the window. An opaque site has no URL; it gets random
+  // tokens, as an opaque window does.
+  const GURL site_url = key.top_level_site().GetURL();
+  if (!GetContentClient()->browser()->HeliumNoiseEnabled(context, site_url)) {
+    return {};
+  }
+  return GetTokens(context, url::Origin::Create(site_url));
+}
