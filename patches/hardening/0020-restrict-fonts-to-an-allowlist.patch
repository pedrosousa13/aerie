+// Whether this context can match only the allowlist of common fonts (Aerie,
+// issue #117). The browser sends a kFonts token only while the "Restrict fonts"
+// pref is on and protection is on for the site, so "token present" means
+// "restricted here": turning either off, or protection off for the site, gives
+// the real fonts back without a renderer change.
+inline bool AreFontsRestricted(const ExecutionContext* context) {
+  if (!context) {
+    return false;
+  }
+  return aerie_fonts::ShouldRestrictFonts(
+      {.master_enabled = base::FeatureList::IsEnabled(features::kHeliumNoise),
+       .surface_enabled =
+           base::FeatureList::IsEnabled(features::kHeliumNoiseFonts),
+       .has_token = context->GetHeliumNoiseTokens().contains(
+           HeliumNoiseFeature::kFonts)});
+}
+
+// Whether a lookup of the installed font family `family` must find nothing in
+// this context. Callers pass only non-generic families, and only after they
+// found no @font-face of that name, so web fonts a page loads are never hidden.
+inline bool IsInstalledFontFamilyHidden(const ExecutionContext* context,
+                                        const AtomicString& family) {
+  return AreFontsRestricted(context) &&
+         !aerie_fonts::IsFontFamilyAllowed(family.Utf8());
+}
+
+// Whether `@font-face { src: local(name) }` must find nothing in this context.
+inline bool IsLocalFontNameHidden(const ExecutionContext* context,
+                                  const String& name) {
+  return AreFontsRestricted(context) &&
+         !aerie_fonts::IsLocalFontNameAllowed(name.Utf8());
+}
+
+}  // namespace blink
