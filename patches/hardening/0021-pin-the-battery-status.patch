+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_EXECUTION_CONTEXT_NAVIGATOR_MASKING_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_EXECUTION_CONTEXT_NAVIGATOR_MASKING_H_
+
+#include "base/feature_list.h"
+#include "components/aerie_navigator_pins/navigator_pins.h"
+#include "third_party/blink/public/common/features.h"
+#include "third_party/blink/public/common/helium_noise/noise_token.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+
+namespace blink {
+
+// Whether getBattery() and getVoices() report pinned values to this context
+// (Aerie, issue #120). The browser sends a kNavigator token only when
+// protection is on for the site, so "token present" means "protected here":
+// turning protection off, globally or for the site, gives the real values back.
+// A null context has no token to read and reports the real values; both
+// callers are windows.
+inline bool ShouldPinNavigatorForContext(const ExecutionContext* context) {
+  return aerie_navigator_pins::ShouldPinNavigator(
+      {.master_enabled = base::FeatureList::IsEnabled(features::kHeliumNoise),
+       .surface_enabled =
+           base::FeatureList::IsEnabled(features::kHeliumNoiseNavigator),
+       .has_token =
+           context && context->GetHeliumNoiseTokens().contains(
+                          HeliumNoiseFeature::kNavigator)});
+}
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_EXECUTION_CONTEXT_NAVIGATOR_MASKING_H_
