 namespace blink {
 
+// Aerie (issue #124): whether the 8 GB cap applies to this context. The
+// browser sends noise tokens only when fingerprinting protection is on for the
+// page (the pref is on and the site has no per-site off), so a token means
+// "protected here", as for the GPU (ShouldMaskGpuInfoForContext). A worker has
+// no tokens yet (issue #113) and fails closed: it is capped while the feature
+// is on. Nothing here reads a value the page can set.
+// static
+bool NavigatorDeviceMemory::ShouldCapDeviceMemory(
+    const ExecutionContext* context) {
+  if (!base::FeatureList::IsEnabled(features::kHeliumNoise)) {
+    return false;
+  }
+  if (!context || context->IsWorkerOrWorkletGlobalScope()) {
+    return true;
+  }
+  return context->GetHeliumNoiseTokens().contains(
+      HeliumNoiseFeature::kHardware);
+}
+
 float NavigatorDeviceMemory::deviceMemory() const {
-  return ApproximatedDeviceMemory::GetApproximatedDeviceMemory();
+  // NavigatorBase is the only class that includes this mixin.
+  const ExecutionContext* context =
+      static_cast<const NavigatorBase*>(this)->GetExecutionContext();
+  return ApproximatedDeviceMemory::GetApproximatedDeviceMemory(
+      ShouldCapDeviceMemory(context));
 }
 
