 // static
+float ApproximatedDeviceMemory::GetApproximatedDeviceMemory(
+    bool protected_context) {
+  // Aerie: Machines with more than 8 GB are rare, so a larger value only tells
+  // a site more about this one. The cap is not applied to the cached value, so
+  // a context without protection still reads the real bucket.
+  const float real = approximated_device_memory_gb_;
+  return protected_context && real > kProtectedMaxGb ? kProtectedMaxGb : real;
+}
