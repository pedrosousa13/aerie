Aerie-Purpose: Stop extensions from writing the WebRTC policy, the preloading option and the third-party cookie setting through chrome.privacy.
Aerie-Upstream-Area: chrome/browser/extensions/pref_mapping.cc (write permission of three chrome.privacy entries)
Aerie-Kind: hook

PrefMappingEntry documents kInvalid as the write permission for a pref that an extension may
read but not write. The extension then gets the usual permission error. Only the user can
loosen these settings, in settings.

--- a/chrome/browser/extensions/pref_mapping.cc
+++ b/chrome/browser/extensions/pref_mapping.cc
@@ -39,4 +39,7 @@
 constexpr char kOnPrefChangeFormat[] = "types.ChromeSetting.%s.onChange";
 
+// Aerie: an extension cannot write a pref marked kInvalid in the last column.
+// These are the hardened defaults that only the user may loosen, in settings.
+// Reading them and onChange events still work.
 const PrefMappingEntry kMappings[] = {
     {"alternateErrorPagesEnabled",
@@ -54,5 +57,5 @@
      APIPermissionID::kPrivacy, APIPermissionID::kPrivacy},
     {"networkPredictionEnabled", prefetch::prefs::kNetworkPredictionOptions,
-     APIPermissionID::kPrivacy, APIPermissionID::kPrivacy},
+     APIPermissionID::kPrivacy, APIPermissionID::kInvalid},
     {"passwordSavingEnabled",
      password_manager::prefs::kCredentialsEnableService,
@@ -73,5 +76,5 @@
      APIPermissionID::kPrivacy, APIPermissionID::kPrivacy},
     {"thirdPartyCookiesAllowed", prefs::kCookieControlsMode,
-     APIPermissionID::kPrivacy, APIPermissionID::kPrivacy},
+     APIPermissionID::kPrivacy, APIPermissionID::kInvalid},
     {"topicsEnabled", prefs::kPrivacySandboxM1TopicsEnabled,
      APIPermissionID::kPrivacy, APIPermissionID::kPrivacy},
@@ -83,5 +86,5 @@
      APIPermissionID::kPrivacy, APIPermissionID::kPrivacy},
     {"webRTCIPHandlingPolicy", prefs::kWebRTCIPHandlingPolicy,
-     APIPermissionID::kPrivacy, APIPermissionID::kPrivacy},
+     APIPermissionID::kPrivacy, APIPermissionID::kInvalid},
     {"webRTCIPHandlingUrl", prefs::kWebRTCIPHandlingUrl,
      APIPermissionID::kPrivacy, APIPermissionID::kPrivacy},
