+
+namespace blink {
+
+// Whether window.screen, the device-width and device-height media features and
+// window.screenX/screenY report a common screen to this context (Aerie, issue
+// #116). The browser sends a kScreen token only when protection is on for the
+// site, so "token present" means "protected here": turning protection off,
+// globally or for the site, gives the real values back.
+inline bool IsScreenProtected(const ExecutionContext* context) {
+  if (!context) {
+    return false;
+  }
+  return aerie_screen::ShouldProtectScreen(
+      {.master_enabled = base::FeatureList::IsEnabled(features::kHeliumNoise),
+       .surface_enabled =
+           base::FeatureList::IsEnabled(features::kHeliumNoiseScreen),
+       .has_token = context->GetHeliumNoiseTokens().contains(
+           HeliumNoiseFeature::kScreen)});
+}
+
+// The screen size a protected frame reports: the smallest common size that
+// fits the browser window (see aerie_screen::ScreenSizeForWindow). Empty when
+// the frame is not protected. It reads only the window rectangle that
+// outerWidth and outerHeight read, so it needs no layout and is safe during
+// style recalculation.
+inline std::optional<aerie_screen::Size> ProtectedScreenSize(
+    LocalFrame* frame) {
+  if (!frame || !frame->DomWindow() || !frame->GetPage() ||
+      !IsScreenProtected(frame->DomWindow())) {
+    return std::nullopt;
+  }
+  const gfx::Rect window =
+      frame->GetPage()->GetChromeClient().RootWindowRect(*frame);
+  return aerie_screen::ScreenSizeForWindow(window.width(), window.height());
+}
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_SCREEN_MASKING_H_
