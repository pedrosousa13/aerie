 namespace {
 
+// What WEBGL_debug_renderer_info reports (Aerie, issue #112). The
+// SpoofWebGLInfo flag, a value the user chose, wins. Otherwise a context under
+// protection reports the vendor family in Chrome's own format, and any other
+// context reports the real string. A worker has no noise tokens yet, so it is
+// always protected here (fail closed, until issue #113).
+String UnmaskedGpuString(ScriptState* script_state,
+                         bool vendor,
+                         const base::FeatureParam<std::string>& spoofed,
+                         const String& real_vendor,
+                         const String& real_renderer) {
+  if (base::FeatureList::IsEnabled(blink::features::kSpoofWebGLInfo)) {
+    return String(spoofed.Get());
+  }
+  ExecutionContext* context = ExecutionContext::From(script_state);
+  const bool is_worker = !context || context->IsWorkerOrWorkletGlobalScope();
+  const bool has_token =
+      context &&
+      context->GetHeliumNoiseTokens().contains(HeliumNoiseFeature::kWebGL);
+  if (!aerie_gpu_info::ShouldMaskGpuInfo(
+          is_worker ? aerie_gpu_info::ContextKind::kWorker
+                    : aerie_gpu_info::ContextKind::kWindow,
+          base::FeatureList::IsEnabled(blink::features::kHeliumNoise),
+          base::FeatureList::IsEnabled(blink::features::kHeliumNoiseWebGL),
+          has_token)) {
+    return vendor ? real_vendor : real_renderer;
+  }
+  const aerie_gpu_info::GpuFamily family =
+      aerie_gpu_info::GpuFamilyFromGlStrings(real_vendor.Utf8(),
+                                             real_renderer.Utf8());
+  return String::FromUtf8(vendor ? aerie_gpu_info::MaskedVendor(family)
+                                 : aerie_gpu_info::MaskedRenderer(family));
+}
