+#include "base/feature_list.h"
+#include "components/aerie_gpu_info/gpu_info.h"
+#include "third_party/blink/public/common/features.h"
+#include "third_party/blink/public/common/helium_noise/noise_token.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+
+namespace blink {
+
+// Whether WebGL and WebGPU report masked graphics card details to this context
+// (Aerie, issue #112). A null context counts as a worker. A worker has no noise
+// tokens yet, so it is always protected while the features are on (fail
+// closed, until issue #113).
+inline bool ShouldMaskGpuInfoForContext(const ExecutionContext* context) {
+  const bool is_worker = !context || context->IsWorkerOrWorkletGlobalScope();
+  const bool has_token =
+      context &&
+      context->GetHeliumNoiseTokens().contains(HeliumNoiseFeature::kWebGL);
+  return aerie_gpu_info::ShouldMaskGpuInfo(
+      is_worker ? aerie_gpu_info::ContextKind::kWorker
+                : aerie_gpu_info::ContextKind::kWindow,
+      {.master_enabled = base::FeatureList::IsEnabled(features::kHeliumNoise),
+       .surface_enabled =
+           base::FeatureList::IsEnabled(features::kHeliumNoiseWebGL),
+       .has_token = has_token});
+}
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_EXECUTION_CONTEXT_GPU_INFO_MASKING_H_
