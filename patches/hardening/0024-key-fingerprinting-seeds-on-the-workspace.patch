+    const url::Origin& origin,
+    const StoragePartitionConfig& partition) {
   HeliumNoiseTokenData* data = GetBrowserTokens(context);
 
   // Aerie (#114): the key is the site (scheme plus registrable domain), so
   // x.example.com and y.example.com get the same tokens. An opaque origin has
-  // no key and gets a random value. Keying on a Workspace later (#121) is a
