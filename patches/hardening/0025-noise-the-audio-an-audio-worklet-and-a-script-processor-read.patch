+// Aerie (#157): noises the samples that an author script reads out of the
+// graph, so every such reader keys the noise the same way. |for_each_channel|
+// is called twice with a visitor and must call it with the samples of every
+// channel, in the same order both times. The first pass hashes every channel
+// into |noise|, which must be enabled; the second jitters each sample by its
+// position across all the channels, as AudioBuffer::JitterAudioData does. It
+// allocates nothing and takes no lock, because the audio thread runs it.
+template <typename ForEachChannel>
+void JitterReadbackChannels(AudioReadbackNoise& noise,
+                            ForEachChannel for_each_channel) {
+  for_each_channel(
+      [&noise](base::span<float> samples) { noise.AddSource(samples); });
+  uint64_t index = 0;
+  for_each_channel([&noise, &index](base::span<float> samples) {
+    for (float& sample : samples) {
+      sample = noise.Jitter(sample, index++);
+    }
+  });
+}
