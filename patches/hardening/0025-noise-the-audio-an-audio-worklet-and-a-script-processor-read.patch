+// Aerie: calls |visit| with the samples of every channel of |array_buffers|.
+template <typename Visit>
+void ForEachChannelSamples(v8::Isolate* isolate,
+                           const BackingArrayBuffers& array_buffers,
+                           Visit visit) {
+  for (const auto& bus : array_buffers) {
+    for (const auto& channel : bus) {
+      auto backing_store = channel.Get(isolate)->GetBackingStore();
+      visit(base::subtle::reinterpret_span<float>(
+          ArrayBufferContents(std::move(backing_store)).ByteSpan()));
+    }
+  }
+}
+
+// Aerie: noises the samples that an author script is about to read, the way
+// the rendered buffer of an OfflineAudioContext is noised, so a worklet at the
+// end of a graph cannot read the audio without the per-site noise. The seed is
+// the audio noise token and the samples of this block, and each sample moves
+// by its position in the block. Nothing here depends on a counter or on time.
+// There is nothing to do when there is no token, so the real samples show with
+// protection off.
+void JitterInputArrayBuffers(v8::Isolate* isolate,
+                             ExecutionContext* context,
+                             const BackingArrayBuffers& array_buffers) {
+  AudioReadbackNoise noise(context);
+  if (!noise.enabled()) {
+    return;
+  }
+
+  JitterReadbackChannels(noise, [&](auto visit) {
+    ForEachChannelSamples(isolate, array_buffers, visit);
+  });
+}
