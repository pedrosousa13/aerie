+// Copyright 2026 The Aerie Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/aerie_services/extension_proxy.h"
+
+#include "base/command_line.h"
+#include "base/strings/string_util.h"
+#include "net/base/ip_address.h"
+#include "net/base/url_util.h"
+#include "url/url_constants.h"
+
+namespace aerie {
+
+namespace {
+
+// localhost, *.localhost, 127.0.0.0/8, ::1, the IPv4-mapped form of those
+// ([::ffff:7f00:1]), and the unspecified address (0.0.0.0, ::), which most
+// systems route to the local machine. GURL has already canonicalized spellings
+// such as 0x7f.1 and 2130706433 to dotted form.
+bool IsLoopbackLike(const GURL& url) {
+  if (net::IsLocalhost(url)) {
+    return true;
+  }
+  net::IPAddress ip;
+  if (!ip.AssignFromIPLiteral(url.HostNoBrackets())) {
+    return false;
+  }
+  if (ip.IsIPv4MappedIPv6()) {
+    ip = net::ConvertIPv4MappedIPv6ToIPv4(ip);
+  }
+  return ip.IsLoopback() || ip.IsZero();
+}
+
+}  // namespace
+
+std::optional<GURL> ParseExtensionProxyUrl(std::string_view text,
+                                           bool allow_loopback) {
+  if (text.empty() || !base::IsStringASCII(text)) {
+    return std::nullopt;
+  }
+
+  // GURL strips tabs, newlines and surrounding spaces without complaint.
+  // A setting that needed that is not one we want to accept.
+  for (char c : text) {
+    if (c <= ' ' || c == '\x7f') {
+      return std::nullopt;
+    }
+  }
+
+  GURL url(text);
+  if (!url.is_valid() || !url.SchemeIs(url::kHttpsScheme) ||
+      !url.has_host() || url.host().empty()) {
+    return std::nullopt;
+  }
+  if (url.has_username() || url.has_password() || url.has_query() ||
+      url.has_ref()) {
+    return std::nullopt;
+  }
+  // A canonical https URL without a path has the path "/".
+  if (url.path() != "/") {
+    return std::nullopt;
+  }
+  if (!allow_loopback && IsLoopbackLike(url)) {
+    return std::nullopt;
+  }
+  return url;
+}
+
+bool IsLoopbackExtensionProxyAllowed() {
+  return base::CommandLine::InitializedForCurrentProcess() &&
+         base::CommandLine::ForCurrentProcess()->HasSwitch(
+             kAllowLoopbackExtensionProxySwitch);
+}
+
+std::optional<GURL> ParseExtensionProxyUrl(std::string_view text) {
+  return ParseExtensionProxyUrl(text, IsLoopbackExtensionProxyAllowed());
+}
+
+}  // namespace aerie
