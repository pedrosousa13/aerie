+// Copyright 2026 The Aerie Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef COMPONENTS_AERIE_SERVICES_EXTENSION_PROXY_H_
+#define COMPONENTS_AERIE_SERVICES_EXTENSION_PROXY_H_
+
+#include <optional>
+#include <string_view>
+
+#include "base/component_export.h"
+#include "url/gurl.h"
+
+namespace aerie {
+
+// Test-only switch. The Bench passes it so that a fixture proxy on 127.0.0.1
+// can be configured. Without it, loopback hosts are never accepted.
+inline constexpr char kAllowLoopbackExtensionProxySwitch[] =
+    "aerie-test-allow-loopback-extension-proxy";
+
+// Validates the extension proxy setting. Aerie has no built-in proxy: the
+// setting is empty until the user sets one, and an empty or invalid value
+// means "not configured".
+//
+// Accepts only an https origin: ASCII, a host, no user info, no query or
+// fragment, and no path beyond "/". Rejects loopback hosts (localhost,
+// 127.0.0.0/8, ::1, their IPv4-mapped forms) and the unspecified address
+// (0.0.0.0, ::) unless `allow_loopback` is true.
+//
+// On success returns the URL with its path set to "/", so that callers can
+// Resolve() absolute paths against it.
+COMPONENT_EXPORT(AERIE_SERVICES)
+std::optional<GURL> ParseExtensionProxyUrl(std::string_view text,
+                                           bool allow_loopback);
+
+// True when the current process was started with
+// `kAllowLoopbackExtensionProxySwitch`.
+COMPONENT_EXPORT(AERIE_SERVICES) bool IsLoopbackExtensionProxyAllowed();
+
+// Same as above, with `allow_loopback` taken from the command line switch.
+COMPONENT_EXPORT(AERIE_SERVICES)
+std::optional<GURL> ParseExtensionProxyUrl(std::string_view text);
+
+}  // namespace aerie
+
+#endif  // COMPONENTS_AERIE_SERVICES_EXTENSION_PROXY_H_
