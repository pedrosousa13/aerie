+// Copyright 2026 The Aerie Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/aerie_services/extension_proxy.h"
+
+#include <string_view>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aerie {
+
+namespace {
+
+std::optional<GURL> Parse(std::string_view text) {
+  return ParseExtensionProxyUrl(text, /*allow_loopback=*/false);
+}
+
+}  // namespace
+
+TEST(AerieExtensionProxyTest, AcceptsHttpsOrigins) {
+  ASSERT_TRUE(Parse("https://proxy.example.org"));
+  EXPECT_EQ("https://proxy.example.org/", Parse("https://proxy.example.org")->spec());
+  EXPECT_EQ("https://proxy.example.org/", Parse("https://proxy.example.org/")->spec());
+  EXPECT_EQ("https://proxy.example.org:8443/",
+            Parse("https://proxy.example.org:8443")->spec());
+  EXPECT_EQ("https://proxy.example.org/", Parse("HTTPS://Proxy.Example.ORG")->spec());
+}
+
+TEST(AerieExtensionProxyTest, RejectsEmptyAndNotConfigured) {
+  EXPECT_FALSE(Parse(""));
+  EXPECT_FALSE(Parse("   "));
+  EXPECT_FALSE(Parse("https://"));
+}
+
+TEST(AerieExtensionProxyTest, RejectsEverythingButHttps) {
+  EXPECT_FALSE(Parse("http://proxy.example.org"));
+  EXPECT_FALSE(Parse("ws://proxy.example.org"));
+  EXPECT_FALSE(Parse("wss://proxy.example.org"));
+  EXPECT_FALSE(Parse("ftp://proxy.example.org"));
+  EXPECT_FALSE(Parse("file:///etc/passwd"));
+  EXPECT_FALSE(Parse("javascript:alert(1)"));
+  EXPECT_FALSE(Parse("data:text/plain,hello"));
+  EXPECT_FALSE(Parse("proxy.example.org"));
+  EXPECT_FALSE(Parse("//proxy.example.org"));
+}
+
+TEST(AerieExtensionProxyTest, RejectsUserInfoQueryFragmentAndPaths) {
+  EXPECT_FALSE(Parse("https://user@proxy.example.org"));
+  EXPECT_FALSE(Parse("https://user:secret@proxy.example.org"));
+  EXPECT_FALSE(Parse("https://proxy.example.org/?a=b"));
+  EXPECT_FALSE(Parse("https://proxy.example.org/#frag"));
+  EXPECT_FALSE(Parse("https://proxy.example.org/ext"));
+  EXPECT_FALSE(Parse("https://proxy.example.org/a/b/"));
+}
+
+TEST(AerieExtensionProxyTest, RejectsNonAsciiAndWhitespace) {
+  EXPECT_FALSE(Parse("https://pr\xc3\xb6xy.example.org"));
+  EXPECT_FALSE(Parse(" https://proxy.example.org"));
+  EXPECT_FALSE(Parse("https://proxy.example.org "));
+  EXPECT_FALSE(Parse("https://proxy.exam\tple.org"));
+  EXPECT_FALSE(Parse("https://proxy.example.org\n"));
+}
+
+TEST(AerieExtensionProxyTest, RejectsLoopbackUnlessTheTestSwitchIsOn) {
+  for (std::string_view url :
+       {"https://localhost", "https://localhost:8443", "https://127.0.0.1",
+        "https://127.1.2.3:9000", "https://[::1]", "https://app.localhost"}) {
+    EXPECT_FALSE(ParseExtensionProxyUrl(url, /*allow_loopback=*/false)) << url;
+    EXPECT_TRUE(ParseExtensionProxyUrl(url, /*allow_loopback=*/true)) << url;
+  }
+  // Even with loopback allowed, the scheme must be https.
+  EXPECT_FALSE(ParseExtensionProxyUrl("http://127.0.0.1:8000",
+                                      /*allow_loopback=*/true));
+}
+
+TEST(AerieExtensionProxyTest, RejectsEveryLoopbackSpellingWithoutTheSwitch) {
+  for (std::string_view url : {
+           "https://localhost.", "https://LOCALHOST", "https://foo.localhost",
+           "https://127.0.0.1:8443", "https://127.255.255.254", "https://127.1",
+           "https://0x7f.0.0.1", "https://2130706433", "https://0177.0.0.1",
+           "https://[::1]", "https://[0:0:0:0:0:0:0:1]", "https://[::ffff:7f00:1]",
+           "https://[::ffff:127.0.0.1]", "https://[::ffff:7f12:3456]",
+           "https://0.0.0.0", "https://0.0.0.0:8443", "https://[::]",
+           "https://[::ffff:0.0.0.0]"}) {
+    EXPECT_FALSE(ParseExtensionProxyUrl(url, /*allow_loopback=*/false)) << url;
+    // Not rejected for a missing scheme or a bad path: only for the host.
+    EXPECT_FALSE(Parse(url)) << url;
+  }
+}
+
+TEST(AerieExtensionProxyTest, AcceptsPublicAddressesAndIpv4MappedPublicOnes) {
+  EXPECT_TRUE(Parse("https://203.0.113.7"));
+  EXPECT_TRUE(Parse("https://[2001:db8::1]"));
+  EXPECT_TRUE(Parse("https://[::ffff:203.0.113.7]"));
+}
+
+TEST(AerieExtensionProxyTest, TheTestSwitchAllowsLoopbackSpellings) {
+  for (std::string_view url : {"https://[::ffff:7f00:1]", "https://127.1",
+                               "https://localhost."}) {
+    EXPECT_TRUE(ParseExtensionProxyUrl(url, /*allow_loopback=*/true)) << url;
+  }
+}
+
+TEST(AerieExtensionProxyTest, LoopbackSwitchIsOffInTheTestProcess) {
+  EXPECT_FALSE(IsLoopbackExtensionProxyAllowed());
+  EXPECT_FALSE(ParseExtensionProxyUrl("https://localhost"));
+}
+
+}  // namespace aerie
