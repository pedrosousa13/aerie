+#include "chrome/browser/ui/webui/aerie_filters/aerie_filters_ui.h"
 #include "chrome/browser/ui/webui/autofill_and_password_manager_internals/autofill_internals_ui.h"
@@ -273,2 +274,3 @@
   map.AddWebUIConfig(std::make_unique<AccessibilityUIConfig>());
+  map.AddWebUIConfig(std::make_unique<aerie_adblock::AerieFiltersUIConfig>());
   map.AddWebUIConfig(std::make_unique<AutofillInternalsUIConfig>());
