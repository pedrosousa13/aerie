[Unit]
Description=Aerie local CI: nightly clean build and full Bench on main

[Service]
Type=oneshot
WorkingDirectory=@REPO@
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/env python3 -m tools.aerie_ci nightly
# Up to 1 hour waiting for the build-tree lock, then a clean build (about 2.5 hours) and the Bench.
TimeoutStartSec=6h
Nice=10
