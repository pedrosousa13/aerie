#!/usr/bin/env python3
"""Aerie build entry point. Run ./aerie --help."""

import sys
from pathlib import Path

if sys.version_info < (3, 11):
    sys.exit("aerie: Python 3.11 or newer is required")

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent / "tools"))

from aerie_build.cli import main  # noqa: E402

sys.exit(main())
