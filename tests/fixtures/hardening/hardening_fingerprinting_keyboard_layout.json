        "main": {
          "hasKeyboard": true,
          "lockType": "function",
          "unlockType": "function",
          "rejection": "NotSupportedError",
          "message": "getLayoutMap() is not supported."
        },
        "pref_off": {
          "hasKeyboard": true,
          "lockType": "function",
          "unlockType": "function",
          "size": 49,
