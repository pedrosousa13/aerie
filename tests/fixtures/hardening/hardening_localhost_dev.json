       "href": "http://dev.localhost:41000/index.html",
       "interstitial": false
      }
     },
     "127.0.0.1": {
      "url": "http://127.0.0.1:41000/index.html",
      "outcome": "loaded",
      "error": null,
      "hit": true,
      "state": {
       "title": "Aerie Bench Fixture",
       "href": "http://127.0.0.1:41000/index.html",
       "interstitial": false
      }
     }
    },
    "unserved": {
     "127.0.0.2": {
      "url": "http://127.0.0.2:41000/index.html",
      "outcome": "net_error",
      "error": "net::ERR_CONNECTION_REFUSED",
      "state": {
       "title": "",
       "interstitial": false
      }
