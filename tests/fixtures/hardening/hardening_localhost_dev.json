    "strict_control": {
     "outcome": "interstitial"
    },
    "served": {
     "localhost": {
      "url": "http://localhost:41000/index.html",
      "outcome": "loaded",
      "error": null,
      "hit": true,
      "state": {
       "title": "Aerie Bench Fixture",
       "href": "http://localhost:41000/index.html",
       "interstitial": false
      }
     },
     "dev.localhost": {
      "url": "http://dev.localhost:41000/index.html",
      "outcome": "loaded",
      "error": null,
      "hit": true,
      "state": {
