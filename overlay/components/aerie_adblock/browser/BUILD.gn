import("//testing/test.gni")

# Everything in this directory runs in the browser process. None of it may be
# reachable from a renderer: only //chrome/browser:core (and this directory)
# may depend on it.
_visibility = [
  "//chrome/browser:core",
  "//chrome/browser/aerie_adblock:*",
  "//chrome/browser/ui/views/aerie_adblock:*",
  "//chrome/browser/ui/webui/aerie_filters:*",
  "//components/aerie_adblock/*",
]

# The one target Chromium code depends on. See aerie_adblock_hook.h.
source_set("browser") {
  visibility = _visibility
  sources = [
    "aerie_adblock_hook.cc",
    "aerie_adblock_hook.h",
    "aerie_protection_hook.cc",
    "aerie_protection_hook.h",
  ]

  # aerie_adblock_hook.h includes headers of these, and
  # chrome/browser/aerie_adblock includes filter_engine_service.h through it, so
  # gn check wants them public.
  public_deps = [
    ":protection_policy",
    ":protection_service",
    ":service",
    "//content/public/browser",
    "//services/network/public/cpp",
  ]
  deps = [
    ":lists",
    ":page_counter",
    ":proxy",
    "//base",
    "//components/aerie_adblock:resources",
    "//net",
    "//ui/base",
    "//url",
  ]
}

# The value the classifier produces and the engine consumes, and the session
# key it carries. Nothing but //base.
source_set("classified_request") {
  visibility = _visibility
  sources = [
    "classified_request.h",
    "session_key.h",
  ]
  public_deps = [ "//base" ]
}

# Request -> (url, hosts, type, third party). Pure; no Rust.
source_set("classifier") {
  visibility = _visibility
  sources = [
    "request_classifier.cc",
    "request_classifier.h",
  ]
  deps = [
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//third_party/blink/public/mojom:mojom_platform",
    "//url",
  ]
  public_deps = [
    ":classified_request",
    "//base",
    "//net",
  ]
}

# The user's filter list settings as data, and their files (issue #10). No
# Rust, no network.
source_set("list_types") {
  visibility = _visibility
  sources = [
    "filter_list_state.cc",
    "filter_list_state.h",
    "filter_list_storage.cc",
    "filter_list_storage.h",
    "list_failure.h",
  ]
  public_deps = [
    "//base",
    "//url",
  ]
  deps = [ "//crypto" ]
}

# The C++ face of the Rust engine.
source_set("engine") {
  visibility = _visibility
  sources = [
    "adblock_engine.cc",
    "adblock_engine.h",
  ]
  public_deps = [
    ":classified_request",
    ":list_types",
    "//base",
    "//components/aerie_adblock:aerie_adblock_ffi",
  ]
}

# The Filter Engine service: one engine per process, on its own sequence.
source_set("service") {
  visibility = _visibility
  sources = [
    "filter_engine_service.cc",
    "filter_engine_service.h",
  ]
  public_deps = [
    ":classifier",
    ":engine",
    ":list_types",
    "//base",
    "//content/public/browser",
    "//url",
  ]
}

# The scripts that apply cosmetic filtering in a frame's isolated world.
source_set("cosmetic_scripts") {
  visibility = _visibility
  sources = [
    "cosmetic_scripts.cc",
    "cosmetic_scripts.h",
  ]
  public_deps = [
    "//base",
    "//components/aerie_adblock/common:limits",
    "//content/public/common",
  ]
}

# Downloads, checks and keeps the filter lists; the scheduled update (issue #10).
source_set("lists") {
  visibility = _visibility
  sources = [
    "filter_list_fetcher.cc",
    "filter_list_fetcher.h",
    "filter_list_manager.cc",
    "filter_list_manager.h",
  ]
  public_deps = [
    ":list_types",
    ":service",
    "//base",
    "//url",
  ]
  deps = [
    ":engine",
    "//net",
    "//net/traffic_annotation",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
  ]
}

# How many requests were blocked for the page of each tab.
source_set("page_counter") {
  visibility = _visibility
  sources = [
    "page_block_counter.cc",
    "page_block_counter.h",
  ]
  public_deps = [
    "//base",
    "//content/public/browser",
  ]
}

# The C++ face of the Rust protection engine (phishing and malware domains).
source_set("protection_engine") {
  visibility = _visibility
  sources = [
    "protection_engine.cc",
    "protection_engine.h",
  ]
  public_deps = [
    "//base",
    "//components/aerie_adblock:aerie_adblock_ffi",
  ]
}

# The protection service: one engine per process, on its own sequence.
source_set("protection_service") {
  visibility = _visibility
  sources = [
    "protection_service.cc",
    "protection_service.h",
  ]
  public_deps = [
    ":protection_engine",
    "//base",
  ]
}

# Which navigations are judged and what happens to them. Pure; no Rust, no
# content. The throttle in //chrome/browser/aerie_adblock applies it.
source_set("protection_policy") {
  visibility = _visibility
  sources = [
    "protection_policy.cc",
    "protection_policy.h",
  ]
  public_deps = [
    "//base",
    "//url",
  ]
}

# The proxying URLLoaderFactory.
source_set("proxy") {
  visibility = _visibility
  sources = [
    "adblock_proxying_url_loader.cc",
    "adblock_proxying_url_loader.h",
    "adblock_proxying_url_loader_factory.cc",
    "adblock_proxying_url_loader_factory.h",
  ]
  public_deps = [
    ":classifier",
    ":service",
    "//base",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]
  deps = [
    "//net",
    "//services/network/public/cpp:http_request_headers_mojom_support",
  ]
}

test("aerie_adblock_unittests") {
  testonly = true
  visibility = [ "//components/aerie_adblock:*" ]
  sources = [
    "adblock_engine_unittest.cc",
    "adblock_proxying_url_loader_factory_unittest.cc",
    "adblock_proxying_url_loader_unittest.cc",
    "cosmetic_scripts_unittest.cc",
    "filter_engine_service_unittest.cc",
    "filter_list_fetcher_unittest.cc",
    "filter_list_manager_unittest.cc",
    "filter_list_state_unittest.cc",
    "filter_list_storage_unittest.cc",
    "protection_engine_unittest.cc",
    "protection_policy_unittest.cc",
    "protection_service_unittest.cc",
    "request_classifier_unittest.cc",
    "session_key_unittest.cc",
  ]
  deps = [
    ":classifier",
    ":cosmetic_scripts",
    ":engine",
    ":list_types",
    ":lists",
    ":protection_engine",
    ":protection_policy",
    ":protection_service",
    ":proxy",
    ":service",
    "//base",
    "//mojo/core/test:run_all_unittests",
    "//base/test:test_support",
    "//mojo/public/cpp/bindings",
    "//net",
    "//net/traffic_annotation:test_support",
    "//services/network:test_support",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]
}

# Tests that need a content environment (a RenderViewHost and a WebContents).
test("aerie_adblock_content_unittests") {
  testonly = true
  visibility = [ "//components/aerie_adblock:*" ]
  sources = [
    "filter_list_manager_session_unittest.cc",
    "page_block_counter_unittest.cc",
  ]
  deps = [
    ":classified_request",
    ":list_types",
    ":lists",
    ":page_counter",
    ":service",
    "//base",
    "//base/test:test_support",
    "//components/test:run_all_unittests",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gtest",
    "//url",
  ]
}
