import("//testing/test.gni")

# Everything in this directory runs in the browser process. None of it may be
# reachable from a renderer: only //chrome/browser:core (and this directory)
# may depend on it.
_visibility = [
  "//chrome/browser:core",
  "//chrome/browser/aerie_adblock:*",
  "//components/aerie_adblock/*",
]

# The one target Chromium code depends on. See aerie_adblock_hook.h.
source_set("browser") {
  visibility = _visibility
  sources = [
    "aerie_adblock_hook.cc",
    "aerie_adblock_hook.h",
  ]

  # aerie_adblock_hook.h includes headers of these, and
  # chrome/browser/aerie_adblock includes filter_engine_service.h through it, so
  # gn check wants them public.
  public_deps = [
    ":service",
    "//content/public/browser",
    "//services/network/public/cpp",
  ]
  deps = [
    ":proxy",
    "//base",
    "//components/aerie_adblock:resources",
    "//net",
    "//ui/base",
    "//url",
  ]
}

# The value the classifier produces and the engine consumes. No dependencies.
source_set("classified_request") {
  visibility = _visibility
  sources = [ "classified_request.h" ]
}

# Request -> (url, hosts, type, third party). Pure; no Rust.
source_set("classifier") {
  visibility = _visibility
  sources = [
    "request_classifier.cc",
    "request_classifier.h",
  ]
  deps = [
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//third_party/blink/public/mojom:mojom_platform",
    "//url",
  ]
  public_deps = [
    ":classified_request",
    "//base",
    "//net",
  ]
}

# The C++ face of the Rust engine.
source_set("engine") {
  visibility = _visibility
  sources = [
    "adblock_engine.cc",
    "adblock_engine.h",
  ]
  public_deps = [
    ":classified_request",
    "//base",
    "//components/aerie_adblock:aerie_adblock_ffi",
  ]
}

# The Filter Engine service: one engine per process, on its own sequence.
source_set("service") {
  visibility = _visibility
  sources = [
    "filter_engine_service.cc",
    "filter_engine_service.h",
  ]
  public_deps = [
    ":classifier",
    ":engine",
    "//base",
    "//url",
  ]
}

# The scripts that apply cosmetic filtering in a frame's isolated world.
source_set("cosmetic_scripts") {
  visibility = _visibility
  sources = [
    "cosmetic_scripts.cc",
    "cosmetic_scripts.h",
  ]
  public_deps = [
    "//base",
    "//content/public/common",
  ]
}

# The proxying URLLoaderFactory.
source_set("proxy") {
  visibility = _visibility
  sources = [
    "adblock_proxying_url_loader.cc",
    "adblock_proxying_url_loader.h",
    "adblock_proxying_url_loader_factory.cc",
    "adblock_proxying_url_loader_factory.h",
  ]
  public_deps = [
    ":classifier",
    ":service",
    "//base",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]
  deps = [
    "//net",
    "//services/network/public/cpp:http_request_headers_mojom_support",
  ]
}

test("aerie_adblock_unittests") {
  testonly = true
  visibility = [ "//components/aerie_adblock:*" ]
  sources = [
    "adblock_engine_unittest.cc",
    "adblock_proxying_url_loader_factory_unittest.cc",
    "adblock_proxying_url_loader_unittest.cc",
    "cosmetic_scripts_unittest.cc",
    "filter_engine_service_unittest.cc",
    "request_classifier_unittest.cc",
  ]
  deps = [
    ":classifier",
    ":cosmetic_scripts",
    ":engine",
    ":proxy",
    ":service",
    "//base",
    "//mojo/core/test:run_all_unittests",
    "//base/test:test_support",
    "//mojo/public/cpp/bindings",
    "//net",
    "//net/traffic_annotation:test_support",
    "//services/network:test_support",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]
}
