import("//testing/test.gni")

# The device list that navigator.mediaDevices.enumerateDevices() returns to a
# page that holds no camera or microphone permission, while fingerprinting
# protection is on (issue #202): the decision to pin the list and the entry that
# it pins. Pure code with no Blink, no content and no base, so it has unit
# tests. The media devices manager calls it
# (patches/hardening/0028-pin-the-device-list-before-permission.patch).
source_set("aerie_media_devices") {
  sources = [
    "device_list.cc",
    "device_list.h",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "device_list_unittest.cc" ]
  deps = [
    ":aerie_media_devices",
    "//testing/gtest",
  ]
}

test("aerie_media_devices_unittests") {
  deps = [
    ":unit_tests",
    "//base/test:run_all_unittests",
  ]
}
