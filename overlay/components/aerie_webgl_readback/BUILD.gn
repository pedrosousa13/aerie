import("//testing/test.gni")

# Which WebGL readPixels calls get fingerprinting noise (issue #119) and where
# their pixels sit in the destination buffer. Pure code with no Blink and no
# base, so it has unit tests. Blink's WebGL module calls it
# (patches/hardening/0019-noise-webgl-readpixels-on-the-default-framebuffer.patch).
source_set("aerie_webgl_readback") {
  sources = [
    "read_pixels_policy.cc",
    "read_pixels_policy.h",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "read_pixels_policy_unittest.cc" ]
  deps = [
    ":aerie_webgl_readback",
    "//testing/gtest",
  ]
}

test("aerie_webgl_readback_unittests") {
  deps = [
    ":unit_tests",
    "//base/test:run_all_unittests",
  ]
}
