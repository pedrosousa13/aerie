import("//testing/test.gni")

# What WebGL and WebGPU report about the graphics card (issue #112): the vendor
# family of the real strings, the masked strings, and the decision whether a
# context is protected. Pure code with no Blink and no base, so it has unit
# tests. Blink's WebGL and WebGPU modules call it
# (patches/hardening/0010-mask-the-gpu-in-webgl-and-webgpu.patch).
source_set("aerie_gpu_info") {
  sources = [
    "gpu_info.cc",
    "gpu_info.h",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "gpu_info_unittest.cc" ]
  deps = [
    ":aerie_gpu_info",
    "//testing/gtest",
  ]
}

test("aerie_gpu_info_unittests") {
  deps = [
    ":unit_tests",
    "//base/test:run_all_unittests",
  ]
}
