import("//testing/test.gni")

# The values that navigator.getBattery() and speechSynthesis.getVoices() report
# while fingerprinting protection is on (issue #120): the pinned battery, the one
# voice to keep and the decision whether a window is protected. Pure code with no
# Blink and no base, so it has unit tests. Blink's BatteryManager and
# SpeechSynthesis call it through core's navigator_masking.h
# (patches/hardening/0021 and 0022).
source_set("aerie_navigator_pins") {
  sources = [
    "navigator_pins.cc",
    "navigator_pins.h",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "navigator_pins_unittest.cc" ]
  deps = [
    ":aerie_navigator_pins",
    "//testing/gtest",
  ]
}

test("aerie_navigator_pins_unittests") {
  deps = [
    ":unit_tests",
    "//base/test:run_all_unittests",
  ]
}
