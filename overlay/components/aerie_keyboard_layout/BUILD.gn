import("//testing/test.gni")

# Whether navigator.keyboard.getLayoutMap() is refused while fingerprinting
# protection is on (issue #203). Pure code with no Blink, no content and no base,
# so it has unit tests. The keyboard lock service calls it
# (patches/hardening/0029-refuse-the-keyboard-layout-map-under-protection.patch).
source_set("aerie_keyboard_layout") {
  sources = [
    "layout_map_policy.cc",
    "layout_map_policy.h",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "layout_map_policy_unittest.cc" ]
  deps = [
    ":aerie_keyboard_layout",
    "//testing/gtest",
  ]
}

test("aerie_keyboard_layout_unittests") {
  deps = [
    ":unit_tests",
    "//base/test:run_all_unittests",
  ]
}
