# The per-profile Tab Model service and its binding to the tab strips (issue
# #176). The model itself, its persistence and its tests are in
# //components/aerie_tab_model. Same shape as //chrome/browser/aerie_widevine.
#
# tab_model_browsertest.cc is not listed: it joins the Aerie browser-test
# target that issue #175 adds (see the note at the top of that file).
# The one declaration that chrome::CloseTab calls (patches/sidebar/0036). A
# header with no dependencies of its own, so that //chrome/browser/ui can depend
# on it without a cycle; its definition is in pinned_tabs_controller.cc.
source_set("pinned_close_hook") {
  visibility = [ "//chrome/*" ]
  sources = [ "pinned_close_hook.h" ]
}

# chrome/browser/ui/browser_tabrestore.h (chrome::AddRestoredTab, which
# PinnedTabsController calls) is deliberately not a dependency: its target
# depends on //chrome/browser/profiles, which depends on this one (patches/sidebar/0011), so
# naming it would close a cycle. The symbol is resolved when chrome links.
source_set("aerie_tab_model") {
  visibility = [ "//chrome/*" ]
  public = [
    "pinned_tabs_controller.h",
    "sleep_controller.h",
    "sleep_controller_factory.h",
    "tab_model_service.h",
    "tab_model_service_factory.h",
    "tab_strip_adapter.h",
  ]
  sources = [
    "pinned_tabs_controller.cc",
    "pinned_tabs_controller.h",
    "sleep_controller.cc",
    "sleep_controller_factory.cc",
    "tab_model_service.cc",
    "tab_model_service_factory.cc",
    "tab_strip_adapter.cc",
  ]
  # The headers include these.
  public_deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs:tab_strip_model_observer",
    "//components/aerie_tab_model",
    "//components/keyed_service/content",
    "//components/keyed_service/core",
    "//components/prefs",
    "//components/tabs:public",
  ]
  deps = [
    ":pinned_close_hook",
    "//chrome/app:generated_resources",
    "//chrome/browser/performance_manager",
    "//chrome/browser/performance_manager/public/user_tuning",
    "//chrome/browser/resource_coordinator",
    "//chrome/browser/resource_coordinator:mojo_bindings",
    "//chrome/browser/tab_list",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/common",
    "//components/aerie_tab_model:prefs",
    "//components/performance_manager",
    "//components/sessions",
    "//content/public/browser",
    "//ui/base",
    "//url",
  ]
}

# Browser tests of sleeping tabs (issue #179). Listed in aerie_browser_tests
# (overlay/chrome/test/aerie/BUILD.gn).
source_set("browser_tests") {
  testonly = true
  # content/public/test/browser_test.h refuses to compile without it.
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "sleep_controller_browsertest.cc" ]
  deps = [
    ":aerie_tab_model",
    "//base",
    "//chrome/app:generated_resources",
    "//base/test:test_support",
    "//chrome/browser:browser",
    "//chrome/browser/profiles:profile",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//components/aerie_tab_model",
    "//components/aerie_tab_model:prefs",
    "//components/performance_manager",
    "//components/prefs",
    "//content/test:test_support",
    "//net:test_support",
  ]
}
