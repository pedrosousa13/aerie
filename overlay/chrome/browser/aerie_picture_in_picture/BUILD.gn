# Test-only: automatic picture-in-picture when the user switches tab (issue
# #263), through Chromium's AutoPictureInPictureTabHelper. Joins
# //chrome/test/aerie:aerie_browser_tests.
source_set("browser_tests") {
  testonly = true
  # content/public/test/browser_test.h refuses to compile without it.
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [
    "aerie_auto_pip_browsertest.cc",
    "aerie_auto_pip_fixture.h",
  ]
  deps = [
    "//base",
    "//base/test:test_support",
    "//chrome/browser:browser",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/tabs:tabs_public",
    "//chrome/common",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    "//content/public/browser",
    "//content/test:test_support",
    "//net",
    "//net:test_support",
    "//testing/gtest",
    "//third_party/blink/public/common",
    "//url",
  ]
}
