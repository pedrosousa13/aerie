  Resources of chrome://filters, the filter list settings page.
-->
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/aerie_filters_resources.h" type="rc_header" context="default_100_percent">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="aerie_filters_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_AERIE_FILTERS_HTML" file="aerie_filters.html" type="BINDATA" />
      <include name="IDR_AERIE_FILTERS_JS" file="aerie_filters.js" type="BINDATA" />
      <include name="IDR_AERIE_FILTERS_CSS" file="aerie_filters.css" type="BINDATA" />
    </includes>
  </release>
</grit>
