# The theme step of aerie://setup (issue #46). Helium's onboarding page
# controller adds this handler; see patches/onboarding/0001.
source_set("theme_handler") {
  visibility = [ "//chrome/browser/ui/webui:*" ]
  sources = [
    "aerie_theme_handler.cc",
    "aerie_theme_handler.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/themes",
    "//content/public/browser",
    "//skia",
    "//ui/base/mojom",
  ]
}
