# The preview swatches of the Theme setting (issue #185). SettingsUI's strings
# provider calls AddThemeSwatches() (patches/sidebar/0048). The page is
# chrome/browser/resources/settings/appearance_page/aerie_appearance_row.*.
source_set("swatches") {
  visibility = [ "//chrome/browser/ui/webui/settings:*" ]
  sources = [
    "aerie_appearance_settings.cc",
    "aerie_appearance_settings.h",
  ]
  deps = [
    "//components/aerie_design_tokens:tokens",
    "//components/aerie_frame:look",
    "//content/public/browser",
  ]
}
