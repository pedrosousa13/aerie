module aerie_guard.mojom;

// What the fingerprinting row shows for the site. The browser reads it from
// helium_noise::GetHeliumNoiseState.
enum FingerprintingMode {
  // Protection is on for the site.
  kOn,
  // The user turned it off for this site (or, in an incognito tab, for this
  // private session).
  kOffForSite,
  // It is off for the whole browser, in Settings. The row is a link, not a
  // switch.
  kOffInSettings,
  // This build has no fingerprinting protection to switch.
  kUnavailable,
};

// What the fingerprinting protection changes. The page maps each value to a
// string of its own.
enum ProtectedSurface {
  kCanvas,
  kAudio,
  kCpuCores,
  kDeviceMemory,
  kGraphicsCard,
  kScreen,
  kTextMetrics,
};

struct FingerprintingState {
  FingerprintingMode mode;
  // Every surface the protection covers, in display order. The same list for
  // every mode.
  array<ProtectedSurface> surfaces;
  // The switch changed after the page loaded. The noise tokens are fixed when
  // a navigation commits, so the tab shows the old values until it reloads.
  bool needs_reload;
};

// How far network blocking goes on the site (issue #109). "Off" is not a level:
// it is the switch of the panel, SetGuardOn(false). The page shows the three as
// one row.
enum BlockingLevel {
  // First-party and third-party requests that match a rule are blocked.
  kAggressive,
  // Built-in lists do not block requests to the page's own site; custom lists
  // still do. Third-party requests are blocked as in Aggressive.
  kStandard,
};

// What the panel shows. The browser builds it from its own state about the tab
// and site the panel was opened for; the page never sends a host, a URL or a
// tab id.
struct PanelState {
  // The host of the site, as the exception keys it. Shown as text.
  string host;
  // The image URL of the site's favicon, for an <img>. It only reads the
  // local favicon store (no request to any server).
  string favicon_url;
  // False while the site has an exception.
  bool blocking_on;
  // The tab is in an incognito window: a change lasts for this private
  // session only and is never saved.
  bool incognito;
  // An incognito tab cannot turn Guard back on for this site, because a
  // regular window saved the exception. The switch is disabled.
  bool locked;
  // False while cosmetic hiding ("Hide leftover ad boxes") is off for the
  // site. Network blocking is not affected.
  bool cosmetic_hiding_on;
  // An incognito tab cannot turn cosmetic hiding back on for this site,
  // because a regular window saved the choice. The row is disabled.
  bool cosmetic_locked;
  // The blocking level in force for the site: its own, or the default from
  // Settings. While blocking is off it is the level a turn back on restores.
  BlockingLevel blocking_level;
  // Requests blocked on the page. 0 while blocking is off.
  int32 blocked_count;
  // The count in words, in the user's language ("12 requests blocked on this
  // page"). Empty while blocking is off.
  string blocked_summary;
  // The URLs of the first blocked requests of the page, oldest first (at most
  // 200, each cut to 256 characters; blocked_count still counts them all). The
  // page shows each as text. Empty while blocking is off. Memory only: the
  // browser keeps them with the tab and drops them when the tab shows another
  // page.
  array<string> blocked_urls;
  FingerprintingState fingerprinting;
};

// The links in the panel. The page names one by this value; the browser
// decides what it opens.
enum Link {
  // The Aerie Guard section of Settings.
  kAerieGuardSettings,
  // The fingerprinting protection page of Settings.
  kNoiseSettings,
};

// The page calls this once when it loads.
interface PageHandlerFactory {
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};

// Requests from the panel. Every input is an enum or a bool; the browser
// validates it and acts only on the tab and site it captured when the panel
// opened. A request for a tab or site that has changed is refused and the
// browser closes the panel.
interface PageHandler {
  // The state of the captured site. Null when the panel has no site: it was
  // loaded in an ordinary tab, or its site is gone.
  GetState() => (PanelState? state);
  // The page has rendered; the browser shows the bubble.
  ShowUI();
  // Turns Guard on or off for the captured site and its subdomains, then
  // reloads the tab.
  SetGuardOn(bool on);
  // Gives the captured site and its subdomains a blocking level, then reloads
  // the tab. If blocking is off for the site, it is turned on again in the same
  // step. The value is an enum: the browser rejects any other as a bad message.
  SetBlockingLevel(BlockingLevel level);
  // Turns cosmetic hiding on or off for the captured site and its subdomains,
  // then reloads the tab. Network blocking stays as it is.
  SetCosmeticHidingOn(bool on);
  // Turns fingerprinting protection on or off for the captured site and its
  // subdomains. It does not reload the tab: the page shows "Reload to apply"
  // and calls Reload(). Refused, with the panel's state sent again, when
  // protection is off in Settings or unavailable. In an incognito tab the
  // change is in memory only.
  SetFingerprintingOn(bool on);
  // Reloads the captured tab, so the change of SetFingerprintingOn applies, and
  // closes the panel.
  Reload();
  // Opens a link in a new tab and closes the panel.
  OpenLink(Link link);
};

// Messages from the browser to the panel.
interface Page {
  // The state changed (the blocked count, the exception). Null when the panel
  // has no site.
  OnStateChanged(PanelState? state);
};
