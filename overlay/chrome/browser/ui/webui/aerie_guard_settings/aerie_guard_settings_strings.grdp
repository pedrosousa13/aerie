     the terms of the GPL-3.0 license that can be found in the LICENSE file.

     Strings of the Aerie Guard section of Settings (issues #103 and #104). patches/adblock/0022 gives each one to the
     settings page under the name tests/test_aerie_guard_settings.py checks. -->
<grit-part>
  <message name="IDS_SETTINGS_AERIE_GUARD_TITLE" desc="Title of the Aerie Guard section of Settings and the text of its entry in the menu on the left.">
    Aerie Guard
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_SHOW_COUNT" desc="Label of the switch that decides whether the Aerie Guard icon in the address bar shows the number of blocked items drawn on it.">
    Show the number of blocked items on the Guard icon
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_SHOW_COUNT_DESC" desc="Line under the switch that shows or hides the number on the Aerie Guard icon. It says that the number stays in the tooltip.">
    When this is off, the icon has no number. Its tooltip still says how many items were blocked on the page.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_AUTO_UPDATE" desc="Label of the switch that turns the automatic update of the filter lists on or off.">
    Update filter lists automatically
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_AUTO_UPDATE_DESC" desc="Line under the switch for the automatic update of the filter lists. It says what the browser contacts and how often, and what happens when the switch is off.">
    Once a day, Aerie downloads each list again from the address of its publisher. When this is off, Aerie does not download lists on its own.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_DEFAULT_LEVEL" desc="Label of the menu in the Aerie Guard section of Settings that sets the blocking level of every site that has no level of its own.">
    Default blocking level
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_DEFAULT_LEVEL_DESC" desc="Line under the menu of the default blocking level in the Aerie Guard section of Settings. It says what the two levels do and that the Guard icon can change one site.">
    Aggressive blocks matching requests to the site itself and to other sites. Standard blocks matching requests to other sites. Built-in lists do not block requests to the site itself; your own lists still do. You can change one site from the Guard icon in the address bar.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LEVEL_AGGRESSIVE" desc="Option of the menu of the default blocking level in the Aerie Guard section of Settings.">
    Aggressive
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LEVEL_STANDARD" desc="Option of the menu of the default blocking level in the Aerie Guard section of Settings.">
    Standard
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_SITES_HEADING" desc="Heading of the list of sites where the user turned off blocking.">
    Sites where blocking is off
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_SITES_DESC" desc="Text under the heading of the list of sites where blocking is off. It says that subdomains are included, that the Guard icon can also change one site, and that sites turned off in a private window are not listed.">
    Aerie Guard does not block on these sites or on their subdomains. You can also change one site from the Guard icon in the address bar. Sites you turn off in a private window are not shown here.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_SITES_EMPTY" desc="Text shown instead of the list when the user turned blocking off for no site.">
    Blocking is on for every site.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_ADD_SITE_LABEL" desc="Label of the text field where the user types a site name to turn blocking off for it.">
    Turn blocking off for a site
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_ADD_SITE_PLACEHOLDER" desc="Example site name shown in the empty text field where the user types a site to turn blocking off for.">
    example.org
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_ADD_SITE_BUTTON" desc="Button next to the text field. It turns blocking off for the site that was typed.">
    Turn off
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_REMOVE_SITE" desc="Button on a row of the list of sites where blocking is off. It turns blocking on again for that site.">
    Turn on
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_REMOVE_SITE_ARIA" desc="Accessible name of the button that turns blocking on again for one site of the list. The placeholder is the site name.">
    Turn blocking back on for <ph name="SITE">$1<ex>news.example</ex></ph>
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_ERROR_INVALID_SITE" desc="Error under the site field when the text typed is not a site name.">
    That is not a valid site name.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_ERROR_TOO_MANY_SITES" desc="Error under the site field when the list of sites where blocking is off is full.">
    There are too many sites turned off. Turn some back on.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_ERROR_GENERIC" desc="Error under the site field when the change was refused for a reason that has no message of its own.">
    Aerie Guard could not change this site.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LISTS_HEADING" desc="Heading of the list of filter lists on the Aerie Guard page.">
    Filter lists
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LISTS_DESC" desc="Text under the heading of the filter lists. It says that a list that is off stays on the computer but is not used.">
    Aerie Guard blocks with these lists. A list that is off stays on this computer but is not used.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_RULES" desc="Line of a filter list that says how many blocking rules it has. The placeholder is a number.">
    Rules: <ph name="COUNT">$1<ex>52000</ex></ph>
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_RULES_COUNTING" desc="Line of a filter list shown while the browser still counts the blocking rules of the list.">
    Rules: counting
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_IGNORED" desc="Line of a filter list that says how many of its exception rules the browser ignores. The placeholder is a number. An exception rule that matches every address is ignored because it would turn blocking off everywhere.">
    Ignored exception rules: <ph name="COUNT">$1<ex>2</ex></ph>
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_UPDATED" desc="Line of a filter list that says when it was last downloaded. The placeholder is a date.">
    Updated <ph name="DATE">$1<ex>3 Nov 2026</ex></ph>
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_SHIPPED" desc="Line of a filter list that says it was not downloaded and that the copy that came with this version of the browser is in use.">
    Using the copy that came with this version of Aerie
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_OFF" desc="Line of a filter list that is turned off. It says the list is not used and that its file is kept.">
    Off. The list is not used. Its file stays on this computer.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_REQUIRED" desc="Line of the filter list that cannot be turned off. It says why.">
    Always on. Most of the hiding of leftover ad boxes comes from this list.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_TOGGLE_ARIA" desc="Accessible name of the switch that turns one filter list on or off. The placeholder is the name of the list.">
    Use <ph name="LIST">$1<ex>EasyPrivacy</ex></ph> for blocking
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_STATUS_UPDATING" desc="Status of a filter list while it is being downloaded again.">
    Updating
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_STATUS_UPDATED" desc="Status of a filter list after it was downloaded again without a problem.">
    Updated
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_STATUS_FAILED" desc="Status of a filter list after the download failed. The list in use stays as it was.">
    Update failed
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_UPDATE_NOW" desc="Button that downloads one filter list again at once.">
    Update now
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_UPDATE_NOW_ARIA" desc="Accessible name of the button that downloads one filter list again at once. The placeholder is the name of the list.">
    Update <ph name="LIST">$1<ex>EasyList</ex></ph> now
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_RETRY" desc="Button that tries again to download a filter list after a failed update.">
    Retry
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_RETRY_ARIA" desc="Accessible name of the button that tries again to download a filter list after a failed update. The placeholder is the name of the list.">
    Try to update <ph name="LIST">$1<ex>EasyList</ex></ph> again
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_TOO_LARGE" desc="Error of a filter list: the list is larger than the allowed limit.">
    The list is larger than the allowed limit.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_TIMEOUT" desc="Error of a filter list: the list took too long to parse.">
    The list took too long to parse.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_NOT_TEXT" desc="Error of a filter list: the downloaded data is not text.">
    The list is not text.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_LOOKS_LIKE_HTML" desc="Error of a filter list: the address gave a web page and not a filter list.">
    The address gave a web page, not a filter list.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_NO_RULES" desc="Error of a filter list: the list has no blocking rules.">
    The list has no blocking rules.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_UNREADABLE" desc="Error of a filter list: the saved copy of the list could not be read from disk.">
    The saved copy of the list could not be read.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_DOWNLOAD" desc="Error of a filter list: the download failed.">
    The list could not be downloaded.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_INSECURE_URL" desc="Error of a filter list: the address is not https.">
    Only https addresses are allowed.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_REQUIRED" desc="Error shown when a request to turn off the list that cannot be turned off was refused.">
    This list cannot be turned off.
  </message>
</grit-part>
