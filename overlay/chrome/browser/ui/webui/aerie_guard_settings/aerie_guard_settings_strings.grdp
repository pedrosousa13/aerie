     You can use, redistribute, and/or modify this source code under
     the terms of the GPL-3.0 license that can be found in the LICENSE file.

     Strings of the Aerie Guard section of Settings (issues #103, #104, #105 and #107). patches/adblock/0022 (#103, #104) and 0027 (#107) give each one to the
     settings page under the name tests/test_aerie_guard_settings.py checks. -->
<grit-part>
  <message name="IDS_SETTINGS_AERIE_GUARD_TITLE" desc="Title of the Aerie Guard section of Settings and the text of its entry in the menu on the left.">
    Aerie Guard
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_SHOW_COUNT" desc="Label of the switch that decides whether the Aerie Guard icon in the address bar shows the number of blocked items drawn on it.">
    Show the number of blocked items on the Guard icon
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_SHOW_COUNT_DESC" desc="Line under the switch that shows or hides the number on the Aerie Guard icon. It says that the number stays in the tooltip.">
    When this is off, the icon has no number. Its tooltip still says how many items were blocked on the page.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_AUTO_UPDATE" desc="Label of the switch that turns the automatic update of the filter lists on or off.">
    Update filter lists automatically
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_AUTO_UPDATE_DESC" desc="Line under the switch for the automatic update of the filter lists. It says what the browser contacts and how often, and what happens when the switch is off.">
    Once a day, Aerie downloads each list again from the address of its publisher. When this is off, Aerie does not download lists on its own.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_DEFAULT_LEVEL" desc="Label of the menu in the Aerie Guard section of Settings that sets the blocking level of every site that has no level of its own.">
    Default blocking level
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_DEFAULT_LEVEL_DESC" desc="Line under the menu of the default blocking level in the Aerie Guard section of Settings. It says what the two levels do and that the Guard icon can change one site.">
    Aggressive blocks matching requests to the site itself and to other sites. Standard blocks matching requests to other sites. Built-in lists do not block requests to the site itself; your own lists still do. You can change one site from the Guard icon in the address bar.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LEVEL_AGGRESSIVE" desc="Option of the menu of the default blocking level in the Aerie Guard section of Settings.">
    Aggressive
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LEVEL_STANDARD" desc="Option of the menu of the default blocking level in the Aerie Guard section of Settings.">
    Standard
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_SITES_HEADING" desc="Heading of the list of sites where the user turned off blocking.">
    Sites where blocking is off
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_SITES_DESC" desc="Text under the heading of the list of sites where blocking is off. It says that subdomains are included, that the Guard icon can also change one site, and that sites turned off in a private window are not listed.">
    Aerie Guard does not block on these sites or on their subdomains. You can also change one site from the Guard icon in the address bar. Sites you turn off in a private window are not shown here.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_SITES_EMPTY" desc="Text shown instead of the list when the user turned blocking off for no site.">
    Blocking is on for every site.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_ADD_SITE_LABEL" desc="Label of the text field where the user types a site name to turn blocking off for it.">
    Turn blocking off for a site
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_ADD_SITE_PLACEHOLDER" desc="Example site name shown in the empty text field where the user types a site to turn blocking off for.">
    example.org
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_ADD_SITE_BUTTON" desc="Button next to the text field. It turns blocking off for the site that was typed.">
    Turn off
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_REMOVE_SITE" desc="Button on a row of the list of sites where blocking is off. It turns blocking on again for that site.">
    Turn on
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_REMOVE_SITE_ARIA" desc="Accessible name of the button that turns blocking on again for one site of the list. The placeholder is the site name.">
    Turn blocking back on for <ph name="SITE">$1<ex>news.example</ex></ph>
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_ERROR_INVALID_SITE" desc="Error under the site field when the text typed is not a site name.">
    That is not a valid site name.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_ERROR_TOO_MANY_SITES" desc="Error under the site field when the list of sites where blocking is off is full.">
    There are too many sites turned off. Turn some back on.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_ERROR_GENERIC" desc="Error under the site field when the change was refused for a reason that has no message of its own.">
    Aerie Guard could not change this site.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LISTS_HEADING" desc="Heading of the list of filter lists on the Aerie Guard page.">
    Filter lists
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LISTS_DESC" desc="Text under the heading of the filter lists. It says that a list that is off stays on the computer but is not used.">
    Aerie Guard blocks with these lists. A list that is off stays on this computer but is not used.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_RULES" desc="Line of a filter list that says how many blocking rules it has. The placeholder is a number.">
    Rules: <ph name="COUNT">$1<ex>52000</ex></ph>
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_RULES_COUNTING" desc="Line of a filter list shown while the browser still counts the blocking rules of the list.">
    Rules: counting
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_IGNORED" desc="Line of a filter list that says how many of its exception rules the browser ignores. The placeholder is a number. An exception rule that matches every address is ignored because it would turn blocking off everywhere.">
    Ignored exception rules: <ph name="COUNT">$1<ex>2</ex></ph>
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_UPDATED" desc="Line of a filter list that says when it was last downloaded. The placeholder is a date.">
    Updated <ph name="DATE">$1<ex>3 Nov 2026</ex></ph>
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_SHIPPED" desc="Line of a filter list that says it was not downloaded and that the copy that came with this version of the browser is in use.">
    Using the copy that came with this version of Aerie
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_OFF" desc="Line of a filter list that is turned off. It says the list is not used and that its file is kept.">
    Off. The list is not used. Its file stays on this computer.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_REQUIRED" desc="Line of the filter list that cannot be turned off. It says why.">
    Always on. Most of the hiding of leftover ad boxes comes from this list.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_TOGGLE_ARIA" desc="Accessible name of the switch that turns one filter list on or off. The placeholder is the name of the list.">
    Use <ph name="LIST">$1<ex>EasyPrivacy</ex></ph> for blocking
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_STATUS_UPDATING" desc="Status of a filter list while it is being downloaded again.">
    Updating
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_STATUS_UPDATED" desc="Status of a filter list after it was downloaded again without a problem.">
    Updated
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_STATUS_FAILED" desc="Status of a filter list after the download failed. The list in use stays as it was.">
    Update failed
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_UPDATE_NOW" desc="Button that downloads one filter list again at once.">
    Update now
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_UPDATE_NOW_ARIA" desc="Accessible name of the button that downloads one filter list again at once. The placeholder is the name of the list.">
    Update <ph name="LIST">$1<ex>EasyList</ex></ph> now
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_RETRY" desc="Button that tries again to download a filter list after a failed update.">
    Retry
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_RETRY_ARIA" desc="Accessible name of the button that tries again to download a filter list after a failed update. The placeholder is the name of the list.">
    Try to update <ph name="LIST">$1<ex>EasyList</ex></ph> again
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_TOO_LARGE" desc="Error of a filter list: the list is larger than the allowed limit.">
    The list is larger than the allowed limit.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_TIMEOUT" desc="Error of a filter list: the list took too long to parse.">
    The list took too long to parse.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_NOT_TEXT" desc="Error of a filter list: the downloaded data is not text.">
    The list is not text.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_LOOKS_LIKE_HTML" desc="Error of a filter list: the address gave a web page and not a filter list.">
    The address gave a web page, not a filter list.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_NO_RULES" desc="Error of a filter list: the list has no blocking rules.">
    The list has no blocking rules.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_UNREADABLE" desc="Error of a filter list: the saved copy of the list could not be read from disk.">
    The saved copy of the list could not be read.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_DOWNLOAD" desc="Error of a filter list: the download failed.">
    The list could not be downloaded.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_INSECURE_URL" desc="Error of a filter list: the address is not https.">
    Only https addresses are allowed.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_NON_PUBLIC_URL" desc="Error of a filter list: the https address points at the user's own network or computer.">
    This address is on your own network or computer, so Aerie does not fetch filter lists from it.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_REQUIRED" desc="Error shown when a request to turn off the list that cannot be turned off was refused.">
    This list cannot be turned off.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_LIST_TITLE" desc="Name of the filter list that holds the user's own rules, in the list of filter lists on the Aerie Guard page.">
    Your own rules
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_HEADING" desc="Heading of the area where the user writes their own filter rules.">
    Your own filter rules
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_DESC" desc="Text under the heading of the area where the user writes their own filter rules. It says how they are written, that some kinds of rule are always dropped and that nothing is sent anywhere.">
    Write one rule per line, in the same syntax as EasyList. Scriptlet, procedural and HTML rules are always dropped. The rules stay on this computer.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_LABEL" desc="Accessible name of the text box where the user writes their own filter rules.">
    Your own filter rules
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_PLACEHOLDER" desc="Example rule shown in the empty text box where the user writes their own filter rules. It is filter syntax, not a sentence.">
    ||ads.example^
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_SAVE" desc="Button that saves the user's own filter rules and starts using them.">
    Save rules
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_SAVED" desc="Short message shown after the user's own filter rules were saved.">
    The rules are saved and in use.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_SUMMARY" desc="Line under the text box of the user's own filter rules. The first placeholder is the number of blocking rules and the second is the number of hiding rules that are in use.">
    In use: <ph name="BLOCKING">$1<ex>12</ex></ph> blocking rules and <ph name="HIDING">$2<ex>3</ex></ph> hiding rules.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_SUMMARY_OFF" desc="Line under the text box of the user's own filter rules when they are not in use, because the switch is off or the engine could not be rebuilt. The first placeholder is the number of blocking rules and the second is the number of hiding rules in the saved text.">
    Not in use: the saved text has <ph name="BLOCKING">$1<ex>12</ex></ph> blocking rules and <ph name="HIDING">$2<ex>3</ex></ph> hiding rules.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_ISSUES_HEADING" desc="Heading of the list of rules, in the user's own filter rules, that are dropped or ignored.">
    Rules that are not used
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_ISSUE_LINE" desc="Start of one entry in the list of rules that are not used. The placeholder is the line number of the rule in the text box.">
    Line <ph name="LINE">$1<ex>3</ex></ph>
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_ISSUES_MORE" desc="Line after the list of rules that are not used, when the list is cut short. The placeholder is how many more rules are not shown.">
    And <ph name="COUNT">$1<ex>25</ex></ph> more that are not shown.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_REASON_SCRIPTLET" desc="Reason shown for a rule that was dropped because it is a scriptlet rule.">
    Dropped: Aerie never runs scriptlets.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_REASON_HTML_FILTER" desc="Reason shown for a rule that was dropped because it is an HTML filtering rule.">
    Dropped: HTML filtering rules are not supported.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_REASON_PROCEDURAL" desc="Reason shown for a rule that was dropped because it is a procedural rule.">
    Dropped: procedural rules are not supported.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_REASON_STYLE_INJECTION" desc="Reason shown for a rule that was dropped because it injects a style or a script.">
    Dropped: rules that inject styles or scripts are not supported.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_REASON_UNSAFE_SELECTOR" desc="Reason shown for a rule that was dropped because its selector is not allowed.">
    Dropped: the selector is not allowed.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_REASON_TOO_LONG" desc="Reason shown for a rule that was dropped because the line is too long.">
    Dropped: the line is longer than 4 KiB.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_REASON_CONTAINS_NUL" desc="Reason shown for a rule that was dropped because the line has a NUL character.">
    Dropped: the line has a NUL character.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_REASON_MATCHES_EVERY_ADDRESS" desc="Reason shown for an exception rule that is ignored because it would match every address.">
    Ignored: this exception rule would match every address.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_REASON_UNPARSEABLE" desc="Reason shown for a rule that was dropped because it is not a valid filter rule.">
    Dropped: this is not a valid filter rule.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_ERROR_TOO_LARGE" desc="Error shown when the user's own filter rules are larger than the limit and were not saved.">
    The rules are larger than 256 KiB. Nothing was saved.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_ERROR_TOO_MANY_LINES" desc="Error shown when the user's own filter rules have more lines than the limit and were not saved.">
    The rules have more than 10,000 lines. Nothing was saved.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_ERROR_NOT_TEXT" desc="Error shown when the user's own filter rules are not valid text and were not saved.">
    The rules are not valid text. Nothing was saved.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_ERROR_TIMEOUT" desc="Error shown when checking the user's own filter rules took too long and they were not saved.">
    The rules took too long to check. Nothing was saved.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CUSTOM_ERROR_UNWRITABLE" desc="Error shown when the user's own filter rules could not be written to disk.">
    The rules could not be saved on this computer.
  </message>
  <!-- catalogue:begin -->
  <message name="IDS_SETTINGS_AERIE_GUARD_CATALOGUE_HEADING" desc="Heading of the catalogue of filter lists in the Aerie Guard section of Settings.">
    Filter list catalogue
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CATALOGUE_DESC" desc="Text under the heading of the catalogue of filter lists. It says that nothing is downloaded until the user turns a list on and where a list comes from.">
    Lists that other people publish. Aerie downloads a list from its publisher only after you turn it on, and nothing is downloaded for lists that are off. Lists that are on are updated like the others.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CATALOGUE_SEARCH_LABEL" desc="Label of the search field above the catalogue of filter lists.">
    Search lists
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CATALOGUE_SEARCH_PLACEHOLDER" desc="Hint inside the empty search field above the catalogue of filter lists.">
    Name, language or topic
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CATALOGUE_NO_RESULTS" desc="Text shown when the search finds no filter list in the catalogue.">
    No list matches your search.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CATALOGUE_CATEGORY_ANNOYANCES" desc="Heading of the group of filter lists that hide page annoyances such as pop-ups.">
    Annoyances
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CATALOGUE_CATEGORY_COOKIES" desc="Heading of the group of filter lists that hide cookie consent notices.">
    Cookie notices
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CATALOGUE_CATEGORY_SOCIAL" desc="Heading of the group of filter lists that block social media buttons and widgets.">
    Social
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CATALOGUE_CATEGORY_PRIVACY" desc="Heading of the group of filter lists that block trackers and tracking parameters.">
    Privacy
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CATALOGUE_CATEGORY_REGIONAL" desc="Heading of the group of filter lists made for sites in one language or region.">
    Regional
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CATALOGUE_LICENCE" desc="Line on a catalogue row that names the licence of the filter list. The placeholder is a licence name such as GPL-3.0.">
    Licence: <ph name="LICENCE">$1<ex>GPL-3.0</ex></ph>
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CATALOGUE_HOMEPAGE" desc="Link on a catalogue row to the website of the filter list's publisher.">
    Website
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CATALOGUE_HOMEPAGE_ARIA" desc="Accessible name of the link to the website of a filter list's publisher. The placeholder is the name of the list.">
    Website of <ph name="LIST">$1<ex>EasyList Germany</ex></ph>
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CATALOGUE_TOGGLE_ARIA" desc="Accessible name of the switch that turns one catalogue filter list on or off. The placeholder is the name of the list.">
    Download and use <ph name="LIST">$1<ex>EasyList Germany</ex></ph>
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CATALOGUE_LANGUAGES" desc="Line on a catalogue row that names the languages a regional filter list is made for. The placeholder is a list of language names.">
    For sites in <ph name="LANGUAGES">$1<ex>German</ex></ph>
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CATALOGUE_NOT_DOWNLOADED" desc="Line on a catalogue row for a filter list that is off. It says that nothing has been downloaded.">
    Off. Nothing is downloaded.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_ERROR_TOO_MANY" desc="Error shown when the user turns on a filter list but too many lists are already in use.">
    Too many lists are in use. Turn one off first.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_SUGGESTED_HEADING" desc="Heading of the group at the top of the filter list catalogue. It holds the regional lists that fit the languages of the browser.">
    Suggested for your languages
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_SUGGESTED_DESC" desc="Line under the heading of the suggested filter lists. It says the lists are only suggestions and are off until the user turns them on.">
    These lists match the languages of your browser. They stay off until you turn them on.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LANGUAGE_CARD_TITLE" desc="Title of the one-time card in the Aerie Guard section of Settings. It suggests regional filter lists that fit the languages of the browser.">
    Filter lists for your languages
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LANGUAGE_CARD_BODY" desc="Text of the one-time card that suggests regional filter lists. It says that nothing is turned on or downloaded until the user chooses a list.">
    Aerie has filter lists made for the languages of your browser. Nothing is turned on or downloaded until you choose a list.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LANGUAGE_CARD_DISMISS" desc="Label of the button that closes the one-time card that suggests regional filter lists. The card does not come back.">
    Dismiss
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LANGUAGE_CARD_REVIEW" desc="Label of the button on the one-time card that moves the user to the suggested filter lists in the catalogue.">
    Review lists
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_FANBOYANNOYANCES_TITLE" desc="Name of the filter list Fanboy Annoyances in the catalogue of the Aerie Guard section of Settings. It is the publisher's name for the list.">
    Fanboy Annoyances
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_FANBOYANNOYANCES_DESC" desc="One sentence that says what the filter list Fanboy Annoyances does, shown under its name in the catalogue.">
    Hides pop-ups, newsletter prompts, chat widgets, in-page video overlays and other page clutter.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_UBOANNOYANCES_TITLE" desc="Name of the filter list uBlock annoyances in the catalogue of the Aerie Guard section of Settings. It is the publisher's name for the list.">
    uBlock annoyances
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_UBOANNOYANCES_DESC" desc="One sentence that says what the filter list uBlock annoyances does, shown under its name in the catalogue.">
    Hides notices, banners, sticky bars and other annoyances.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_EASYLISTCOOKIE_TITLE" desc="Name of the filter list EasyList Cookie List in the catalogue of the Aerie Guard section of Settings. It is the publisher's name for the list.">
    EasyList Cookie List
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_EASYLISTCOOKIE_DESC" desc="One sentence that says what the filter list EasyList Cookie List does, shown under its name in the catalogue.">
    Hides cookie consent banners and notices.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_FANBOYSOCIAL_TITLE" desc="Name of the filter list Fanboy Social in the catalogue of the Aerie Guard section of Settings. It is the publisher's name for the list.">
    Fanboy Social
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_FANBOYSOCIAL_DESC" desc="One sentence that says what the filter list Fanboy Social does, shown under its name in the catalogue.">
    Blocks social media buttons, share widgets and embedded feeds.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_UBOFILTERS_TITLE" desc="Name of the filter list uBlock filters in the catalogue of the Aerie Guard section of Settings. It is the publisher's name for the list.">
    uBlock filters
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_UBOFILTERS_DESC" desc="One sentence that says what the filter list uBlock filters does, shown under its name in the catalogue.">
    Extra rules for ads, trackers and malware hosts that EasyList does not cover.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_UBOPRIVACY_TITLE" desc="Name of the filter list uBlock privacy in the catalogue of the Aerie Guard section of Settings. It is the publisher's name for the list.">
    uBlock privacy
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_UBOPRIVACY_DESC" desc="One sentence that says what the filter list uBlock privacy does, shown under its name in the catalogue.">
    Blocks trackers and other requests that follow you across sites.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_UBOUNBREAK_TITLE" desc="Name of the filter list uBlock unbreak in the catalogue of the Aerie Guard section of Settings. It is the publisher's name for the list.">
    uBlock unbreak
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_UBOUNBREAK_DESC" desc="One sentence that says what the filter list uBlock unbreak does, shown under its name in the catalogue.">
    Exceptions that fix sites other lists break.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_ADGUARDURLTRACKING_TITLE" desc="Name of the filter list AdGuard URL Tracking in the catalogue of the Aerie Guard section of Settings. It is the publisher's name for the list.">
    AdGuard URL Tracking
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_ADGUARDURLTRACKING_DESC" desc="One sentence that says what the filter list AdGuard URL Tracking does, shown under its name in the catalogue.">
    Strips tracking parameters, such as utm_source, from addresses.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_EASYLISTGERMANY_TITLE" desc="Name of the filter list EasyList Germany in the catalogue of the Aerie Guard section of Settings. It is the publisher's name for the list.">
    EasyList Germany
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_EASYLISTGERMANY_DESC" desc="One sentence that says what the filter list EasyList Germany does, shown under its name in the catalogue.">
    Ad and tracker rules for German-language sites.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_EASYLISTITALY_TITLE" desc="Name of the filter list EasyList Italy in the catalogue of the Aerie Guard section of Settings. It is the publisher's name for the list.">
    EasyList Italy
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_EASYLISTITALY_DESC" desc="One sentence that says what the filter list EasyList Italy does, shown under its name in the catalogue.">
    Ad and tracker rules for Italian-language sites.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_LISTEFR_TITLE" desc="Name of the filter list Liste FR in the catalogue of the Aerie Guard section of Settings. It is the publisher's name for the list.">
    Liste FR
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_LISTEFR_DESC" desc="One sentence that says what the filter list Liste FR does, shown under its name in the catalogue.">
    Ad and tracker rules for French-language sites. Complements EasyList.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_ADGUARDJAPANESE_TITLE" desc="Name of the filter list AdGuard Japanese in the catalogue of the Aerie Guard section of Settings. It is the publisher's name for the list.">
    AdGuard Japanese
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_ADGUARDJAPANESE_DESC" desc="One sentence that says what the filter list AdGuard Japanese does, shown under its name in the catalogue.">
    Ad and tracker rules for Japanese-language sites.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_ADGUARDSPANISHPORTUGUESE_TITLE" desc="Name of the filter list AdGuard Spanish/Portuguese in the catalogue of the Aerie Guard section of Settings. It is the publisher's name for the list.">
    AdGuard Spanish/Portuguese
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_CAT_ADGUARDSPANISHPORTUGUESE_DESC" desc="One sentence that says what the filter list AdGuard Spanish/Portuguese does, shown under its name in the catalogue.">
    Ad and tracker rules for Spanish- and Portuguese-language sites.
  </message>
  <!-- catalogue:end -->
  <message name="IDS_SETTINGS_AERIE_GUARD_SUBSCRIPTIONS_HEADING" desc="Heading of the part of the Aerie Guard page where the user adds a filter list by its web address.">
    Add a list by address
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_SUBSCRIPTIONS_DESC" desc="Text under the heading for adding a filter list by address. It says that the browser downloads the list again once a day and that the lists added this way appear in the list of filter lists above.">
    Subscribe to a filter list from its address. The browser downloads it now and then updates it once a day. It appears in the lists above, where you can update it, read its text or unsubscribe.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_ADD_LIST_LABEL" desc="Label of the text field where the user types the web address of a filter list.">
    Address of the filter list
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_ADD_LIST_PLACEHOLDER" desc="Example address shown in the empty text field where the user types the address of a filter list.">
    https://lists.example/my-list.txt
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_ADD_LIST_BUTTON" desc="Button next to the text field. It subscribes to the filter list at the address that was typed.">
    Subscribe
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_ADD_LIST_IP_WARNING" desc="Warning under the field where the user adds a filter list by address. It says that downloading the list tells the list's server the IP address of this computer.">
    The server that hosts a list learns your IP address each time the browser downloads the list. Subscribe only to lists from sources you trust.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_ADD_LIST_ERROR_DUPLICATE" desc="Error under the field for adding a filter list: the user is already subscribed to the list at this address.">
    You are already subscribed to this list.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_ADD_LIST_ERROR_TOO_MANY" desc="Error under the field for adding a filter list: the user is subscribed to the largest number of lists that is allowed.">
    You are subscribed to the most lists that are allowed. Unsubscribe from one first.
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_VIEW_SOURCE" desc="Button on a filter list the user subscribed to. It opens the text of the saved list in a new tab, read only.">
    View source
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_VIEW_SOURCE_ARIA" desc="Accessible name of the button that opens the saved text of a filter list. The placeholder is the name of the list.">
    View source of <ph name="LIST_NAME">$1<ex>My list</ex></ph>
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_UNSUBSCRIBE" desc="Button on a filter list the user subscribed to. It removes the list and deletes its saved copy.">
    Unsubscribe
  </message>
  <message name="IDS_SETTINGS_AERIE_GUARD_LIST_UNSUBSCRIBE_ARIA" desc="Accessible name of the button that unsubscribes from a filter list. The placeholder is the name of the list.">
    Unsubscribe from <ph name="LIST_NAME">$1<ex>My list</ex></ph>
  </message>
</grit-part>
