# The message handler of the Aerie Guard section of Settings (issue #103): a
# wrapper around FilterListManager for chrome://settings. The page is in
# chrome/browser/resources/settings/aerie_guard_page. SettingsUI adds the
# handler (patches/adblock/0022); the strings are in
# aerie_guard_settings_strings.grdp, included by the same patch.
source_set("handler") {
  visibility = [ "//chrome/browser/ui/webui/settings:*" ]
  sources = [
    "aerie_guard_settings_handler.cc",
    "aerie_guard_settings_handler.h",
  ]
  public_deps = [
    "//base",
    "//components/aerie_adblock/browser:lists",
    "//content/public/browser",
  ]
  deps = [
    "//chrome/browser/profiles:profile",
    "//components/aerie_adblock/browser:catalogue",
    "//components/aerie_adblock/browser:classified_request",  # blocking_level.h
    "//url",
  ]
}

# The catalogue door of the handler, through the page's own message channel
# (issue #105). Built into browser_tests by patches/adblock/0029.
source_set("browser_tests") {
  testonly = true
  # content/public/test/browser_test.h refuses to compile without it.
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "aerie_guard_settings_browsertest.cc" ]
  deps = [
    "//base",
    "//base/test:test_support",
    "//chrome/browser:browser",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//chrome/test/base:chrome_test_utils",
    "//components/aerie_adblock/browser:catalogue",
    "//components/aerie_adblock/browser:lists",
    "//content/public/browser",
    "//content/test:test_support",
    "//url",
  ]
}
