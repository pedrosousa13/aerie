     You can use, redistribute, and/or modify this source code under
     the terms of the GPL-3.0 license that can be found in the LICENSE file.

     Strings of the Aerie Guard icon in the address bar (issue #99): its tooltip and its accessible name,
     and of the panel that opens when it is pressed (issue #100). tests/test_aerie_guard.py checks that every message
     is used. -->
<grit-part>
  <message name="IDS_AERIE_GUARD_TOOLTIP_NONE" desc="Tooltip and accessible name of the Aerie Guard icon in the address bar when blocking is on for the site and nothing was blocked on the page yet.">
    Aerie Guard: nothing blocked on this page
  </message>
  <message name="IDS_AERIE_GUARD_TOOLTIP_BLOCKED" desc="Tooltip and accessible name of the Aerie Guard icon in the address bar when Aerie Guard blocked requests on the page. The number is the exact count, even when the icon shows 99+.">
    {COUNT, plural,
      =1 {Aerie Guard: 1 request blocked on this page}
      other {Aerie Guard: # requests blocked on this page}}
  </message>
  <message name="IDS_AERIE_GUARD_TOOLTIP_OFF" desc="Tooltip and accessible name of the Aerie Guard icon in the address bar when the user turned blocking off for the site.">
    Aerie Guard is off for this site
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_ACCNAME" desc="Accessible name and task manager title of the Aerie Guard panel, the pop-out that opens from the Aerie Guard icon in the address bar.">
    Aerie Guard
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_TITLE" desc="Heading of the Aerie Guard panel.">
    Aerie Guard
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_SWITCH_LABEL" desc="Label of the switch in the Aerie Guard panel. It turns blocking on or off for the site of the open page.">
    Guard on this site
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_STATUS_ON" desc="Status line of the Aerie Guard panel when blocking is on for the site of the open page.">
    Guard is on for this site
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_STATUS_OFF" desc="Status line of the Aerie Guard panel when the user turned blocking off for the site of the open page.">
    Guard is off for this site
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_SCOPE" desc="Line under the switch of the Aerie Guard panel. It says what the switch changes: the site and every subdomain of it. The exception covers both.">
    Applies to <ph name="HOST">$1<ex>news.example</ex></ph> and its subdomains
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_INCOGNITO" desc="Line under the switch of the Aerie Guard panel in an incognito window. A change lasts for this incognito session only and is not saved.">
    For this private session only. Nothing is saved.
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_LOCKED" desc="Line under the disabled switch of the Aerie Guard panel in an incognito window, shown when the user saved an exception for the site in a regular window. An incognito window cannot undo it.">
    Guard was turned off for this site in a regular window. Turn it on there.
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_BLOCKED" desc="Line of the Aerie Guard panel that says how many requests Aerie Guard blocked on the open page.">
    {COUNT, plural,
      =0 {Nothing blocked on this page}
      =1 {1 request blocked on this page}
      other {# requests blocked on this page}}
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_NO_SITE" desc="Text of the Aerie Guard panel when it was opened in an ordinary tab, or its page is gone, so it has no site to show.">
    Open Aerie Guard from the icon in the address bar to see the settings of a site.
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_ADVANCED" desc="Heading of the collapsed Advanced section of the Aerie Guard panel.">
    Advanced
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_COSMETIC_LABEL" desc="Label of the switch in the Advanced section of the Aerie Guard panel. It turns on or off the hiding of the empty boxes that blocked ads leave behind, for the site of the open page.">
    Hide leftover ad boxes
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_COSMETIC_DESC" desc="Line under the cosmetic switch in the Advanced section of the Aerie Guard panel. It says what the switch changes and that blocking stays as it is. The page reloads when the switch changes.">
    Hides the empty space blocked ads leave behind. Blocking is not affected. The page reloads when you change this.
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_COSMETIC_LOCKED" desc="Line under the disabled cosmetic switch in the Aerie Guard panel in an incognito window, shown when the user turned hiding off for the site in a regular window. An incognito window cannot undo it.">
    Hiding was turned off for this site in a regular window. Turn it on there.
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_FINGERPRINTING" desc="Name of the fingerprinting row in the Advanced section of the Aerie Guard panel. The same name as the global setting in Settings. The row has a switch that turns fingerprinting protection on or off for the site of the open page.">
    Fingerprinting protection
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_FINGERPRINTING_ON" desc="Status line under the fingerprinting row of the Aerie Guard panel when fingerprinting protection is on for the site of the open page.">
    On for this site
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_FINGERPRINTING_OFF" desc="Status line under the fingerprinting row of the Aerie Guard panel when the user turned fingerprinting protection off for the site of the open page. The page then sees the real values.">
    Off for this site
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_FINGERPRINTING_SCOPE" desc="Line under the fingerprinting switch of the Aerie Guard panel. It says what the switch changes: the site and every subdomain of it.">
    Applies to <ph name="HOST">$1<ex>news.example</ex></ph> and its subdomains
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_FINGERPRINTING_INCOGNITO" desc="Line under the fingerprinting switch of the Aerie Guard panel in an incognito window. A change lasts for this incognito session only and is not saved.">
    For this private session only. Nothing is saved.
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_FINGERPRINTING_OFF_IN_SETTINGS" desc="Status of the fingerprinting row of the Aerie Guard panel when fingerprinting protection is off for the whole browser. There is no switch then, because the switch is in Settings.">
    Off in Settings
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_FINGERPRINTING_SETTINGS_LINK" desc="Link next to Off in Settings in the fingerprinting row of the Aerie Guard panel. Opens the Settings page where the user turns fingerprinting protection on.">
    Open Settings
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_FINGERPRINTING_UNAVAILABLE" desc="Status of the fingerprinting row of the Aerie Guard panel when this build of the browser has no fingerprinting protection to switch.">
    Not available
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_RELOAD_TO_APPLY" desc="Prompt in the Aerie Guard panel after the user changed the fingerprinting switch. The open page still shows the old values until it reloads.">
    Reload this page to apply the change.
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_RELOAD" desc="Button in the Aerie Guard panel that reloads the open page so a changed setting applies.">
    Reload
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_SURFACES_HEADING" desc="Heading of the list in the Aerie Guard panel that shows what fingerprinting protection changes on a page. The list is collapsed until the user opens it.">
    What this protects
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_SURFACE_CANVAS" desc="Item of the list of what fingerprinting protection changes. Canvas: the pixels a page reads back from a canvas get small random noise.">
    Canvas image data gets small random noise
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_SURFACE_AUDIO" desc="Item of the list of what fingerprinting protection changes. Audio: the samples a page reads from the audio engine get small random noise.">
    Audio output gets small random noise
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_SURFACE_CPU_CORES" desc="Item of the list of what fingerprinting protection changes. The number of processor cores a page can read is changed.">
    The reported number of CPU cores gets small random noise
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_SURFACE_DEVICE_MEMORY" desc="Item of the list of what fingerprinting protection changes. The amount of memory a page can read is capped at 8 GB.">
    The reported device memory is capped at 8 GB
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_SURFACE_GRAPHICS_CARD" desc="Item of the list of what fingerprinting protection changes. The graphics card name that WebGL and WebGPU report is reduced to the vendor family.">
    The graphics card is reported as its vendor family only
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_BLOCKED_LIST" desc="Heading of the expandable list under the blocked count in the Aerie Guard panel. The list shows the addresses of the requests Aerie Guard blocked on the open page.">
    Show what was blocked
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_BLOCKED_LIST_CUT" desc="Line under the list of blocked addresses in the Aerie Guard panel when the page blocked more requests than the list keeps. The first number is how many addresses the list shows, the second how many requests were blocked in all.">
    Showing the first <ph name="SHOWN">$1<ex>200</ex></ph> of <ph name="TOTAL">$2<ex>300</ex></ph> blocked requests
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_SURFACE_SCREEN" desc="Item of the list of what fingerprinting protection changes. The screen size is reported as a common size and the window position as 0,0.">
    The screen size is reported as a common size, and the window position as 0,0
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_SURFACE_TEXT_METRICS" desc="Item of the list of what fingerprinting protection changes. The text widths and heights that canvas measureText returns are scaled by a tiny factor that is the same on every load of a site.">
    Canvas text measurements carry tiny noise
  </message>
  <message name="IDS_AERIE_GUARD_PANEL_SETTINGS" desc="Link at the bottom of the Aerie Guard panel. Opens the Aerie Guard section of Settings.">
    Aerie Guard settings…
  </message>
</grit-part>
