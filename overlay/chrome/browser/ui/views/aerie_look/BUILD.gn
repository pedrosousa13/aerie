assert(!is_android, "The Aerie look is for desktop platforms only")

# The effective look of a window (issue #185): its inputs, what a change of it
# does (the colour scheme, the Aerie ColorMixer, the views) and the whole-chrome
# crossfade. The rule is aerie::tokens::ResolveEffectiveLook() in
# //components/aerie_design_tokens:appearance. The frame (aerie_frame) owns a
# SidebarLookController; the sidebar view reads the look through ReadLookInputs.
source_set("aerie_look") {
  visibility = [
    "//chrome/browser/ui/views/aerie_frame:*",
    "//chrome/browser/ui/views/aerie_sidebar:*",
    "//chrome/browser/ui/views/frame:*",
    "//chrome/test/aerie:*",
  ]
  sources = [
    "aerie_look.cc",
    "aerie_look.h",
    "look_crossfade.cc",
    "look_crossfade.h",
    "sidebar_look_controller.cc",
    "sidebar_look_controller.h",
  ]
  public_deps = [
    "//base",
    "//components/aerie_design_tokens:appearance",
    "//components/aerie_design_tokens:motion",
    "//components/aerie_frame:look",
    "//components/prefs",
    "//ui/native_theme",
  ]
  deps = [
    "//chrome/browser/profiles:profile",
    "//chrome/browser/themes",
    "//chrome/browser/ui/color/aerie:mixer",
    "//chrome/common:constants",
    "//components/aerie_tab_model",
    "//ui/aura",
    "//ui/color",
    "//ui/compositor",
    "//ui/views",
    "//ui/wm",
  ]
}

# Browser tests of the look (issue #185). Listed in aerie_browser_tests
# (overlay/chrome/test/aerie/BUILD.gn).
source_set("browser_tests") {
  testonly = true
  # content/public/test/browser_test.h refuses to compile without it.
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "aerie_look_browsertest.cc" ]
  deps = [
    ":aerie_look",
    "//chrome/browser:browser",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/themes",
    "//chrome/browser/ui/views/aerie_frame",
    "//chrome/browser/ui/views/frame",
    "//chrome/browser/ui/views/frame:browser_view_header",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//components/aerie_design_tokens:appearance",
    "//components/aerie_design_tokens:motion",
    "//components/aerie_design_tokens:prefs",
    "//components/aerie_design_tokens:tokens",
    "//components/prefs",
    "//content/test:test_support",
    "//ui/native_theme",
    "//ui/views",
  ]
}
