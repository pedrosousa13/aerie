assert(!is_android, "The Aerie sidebar is for desktop platforms only")

# The view of Aerie's sidebar (issue #177). VerticalTabStripRegionView, in
# //chrome/browser/ui/views/frame, creates it (patches/sidebar/0024). What it
# decides without a view is in //components/aerie_sidebar.
source_set("aerie_sidebar") {
  visibility = [
    ":browser_tests",
    ":interactive_tests",
    "//chrome/browser/ui/views/frame:*",
  ]
  sources = [
    "aerie_sidebar_context_menu.cc",
    "aerie_sidebar_context_menu.h",
    "aerie_sidebar_focus_ring.cc",
    "aerie_sidebar_focus_ring.h",
    "aerie_sidebar_folder_group.cc",
    "aerie_sidebar_folder_group.h",
    "aerie_sidebar_regions.cc",
    "aerie_sidebar_regions.h",
    "aerie_sidebar_rename_field.cc",
    "aerie_sidebar_rename_field.h",
    "aerie_sidebar_rename_fade.cc",
    "aerie_sidebar_rename_fade.h",
    "aerie_sidebar_rename_popover.cc",
    "aerie_sidebar_rename_popover.h",
    "aerie_sidebar_row_view.cc",
    "aerie_sidebar_row_view.h",
    "aerie_sidebar_tile_view.cc",
    "aerie_sidebar_tile_view.h",
    "aerie_sidebar_toolbar_hook.h",
    "aerie_sidebar_toolbar_parts.h",
    "aerie_sidebar_top_row.cc",
    "aerie_sidebar_top_row.h",
    "aerie_sidebar_view.cc",
    "aerie_sidebar_view.h",
  ]
  # The headers include these.
  public_deps = [
    "//base",
    "//chrome/browser/ui/tabs:tab_strip_model_observer",
    "//components/aerie_design_tokens:motion",
    "//components/aerie_design_tokens:tokens",
    "//components/aerie_sidebar:palette",
    "//components/aerie_sidebar:today_list",
    "//components/aerie_sidebar:tree",
    "//components/aerie_tab_model",
    "//ui/base",
    "//ui/base/metadata",
    "//ui/views",
  ]
  deps = [
    "//cc/paint",
    "//chrome/app:generated_resources",
    "//chrome/app/vector_icons",
    "//chrome/browser/aerie_tab_model",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/sessions",
    "//chrome/browser/ui:view_ids",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/views/aerie_sidebar/vector_icons",
    "//components/aerie_frame:palette",
    "//components/aerie_sidebar:drag",
    "//components/aerie_sidebar:layout",
    "//components/aerie_sidebar:motion",
    "//components/favicon/content",
    "//components/prefs",
    "//components/tabs:public",
    "//components/vector_icons",
    "//content/public/browser",
    "//ui/color",
    "//ui/compositor",
    "//ui/gfx",
    "//ui/gfx/animation",
  ]
}

# Browser tests of the sidebar (issue #177). Listed in aerie_browser_tests
# (overlay/chrome/test/aerie/BUILD.gn).
source_set("browser_tests") {
  testonly = true
  # content/public/test/browser_test.h refuses to compile without it.
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [
    "aerie_sidebar_browsertest.cc",
    "aerie_sidebar_folders_browsertest.cc",
    "aerie_sidebar_pinned_browsertest.cc",
    "aerie_sidebar_rename_browsertest.cc",
    "aerie_sidebar_sleep_browsertest.cc",
  ]
  deps = [
    ":aerie_sidebar",
    "//chrome/browser:browser",
    "//chrome/browser/aerie_tab_model",
    "//chrome/browser/history",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/resource_coordinator",
    "//chrome/browser/ui:view_ids",
    "//chrome/browser/ui/views/frame",
    "//chrome/common",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//components/aerie_adblock/browser:guard_state",
    "//components/aerie_adblock/browser:page_counter",
    "//components/aerie_design_tokens:motion",
    "//components/aerie_frame:palette",
    "//components/aerie_sidebar:layout",
    "//components/aerie_sidebar:palette",
    "//components/aerie_sidebar:prefs",
    "//components/aerie_tab_model",
    "//components/history/core/browser",
    "//components/prefs",
    "//content/test:test_support",
    "//net:test_support",
    "//ui/base",
    "//ui/color",
    "//ui/compositor",
    "//ui/gfx:test_support",
    "//ui/views",
    "//ui/views:test_support",
  ]
}

