LINE_TO, 13, 7.5f,
LINE_TO, 13, 13,
LINE_TO, 3, 13,
CLOSE,
MOVE_TO, 6, 9,
LINE_TO, 6, 10.5f,
LINE_TO, 10, 10.5f,
LINE_TO, 10, 9,
CLOSE
