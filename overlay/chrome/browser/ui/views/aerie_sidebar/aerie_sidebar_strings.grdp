     You can use, redistribute, and/or modify this source code under
     the terms of the GPL-3.0 license that can be found in the LICENSE file.

     Strings of the Aerie sidebar (issue #177). patches/sidebar/0022 includes this part in generated_resources.grd and
     gives the Settings title to the page under the name tests/test_sidebar.py checks. The strings of the sidebar view
     (its accessible names and the resize separator) are in this part too. -->
<grit-part>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR" desc="Title of the Sidebar section of Settings, where the settings of the browser's vertical tab sidebar are. It has no settings yet.">
    Sidebar
  </message>
  <message name="IDS_AERIE_SIDEBAR_NAME" desc="Accessible name of the sidebar, the navigation landmark on the side of the window that holds the list of tabs.">
    Sidebar
  </message>
  <message name="IDS_AERIE_SIDEBAR_TODAY" desc="Heading of the list of unpinned tabs in the sidebar. It is also the accessible name of that list.">
    Today
  </message>
  <message name="IDS_AERIE_SIDEBAR_NEW_TAB" desc="Label of the row and of the plus button in the sidebar that open a new tab.">
    New Tab
  </message>
  <message name="IDS_AERIE_SIDEBAR_CLOSE_TAB" desc="Tooltip and accessible name of the button on a tab row of the sidebar that closes the tab.">
    Close tab
  </message>
  <message name="IDS_AERIE_SIDEBAR_RESIZE" desc="Accessible name of the separator at the inner edge of the sidebar. The user drags it, or presses the left and right arrow keys on it, to change the width of the sidebar.">
    Resize sidebar
  </message>
  <message name="IDS_AERIE_SIDEBAR_RESIZE_ANNOUNCE" desc="What a screen reader says after the user changed the width of the sidebar with the arrow keys. The number is the new width in pixels.">
    Sidebar width <ph name="WIDTH">$1<ex>260</ex></ph> pixels
  </message>
  <message name="IDS_AERIE_SIDEBAR_TOP_ROW" desc="Accessible name of the row at the top of the sidebar that holds the window controls, the button that hides the sidebar, and the Back, Forward and Reload buttons.">
    Sidebar controls
  </message>
  <message name="IDS_AERIE_SIDEBAR_HIDE" desc="Tooltip and accessible name of the button in the top row of the sidebar that hides the sidebar. The keyboard shortcut for it is Ctrl+S.">
    Hide sidebar
  </message>
  <message name="IDS_AERIE_SIDEBAR_WINDOW_CONTROLS" desc="Accessible name of the group of three round buttons in the sidebar that close, minimize and maximize the browser window.">
    Window controls
  </message>
  <message name="IDS_AERIE_SIDEBAR_CLOSE_WINDOW" desc="Tooltip and accessible name of the round button in the sidebar that closes the browser window.">
    Close window
  </message>
  <message name="IDS_AERIE_SIDEBAR_MINIMIZE_WINDOW" desc="Tooltip and accessible name of the round button in the sidebar that minimizes the browser window.">
    Minimize
  </message>
  <message name="IDS_AERIE_SIDEBAR_MAXIMIZE_WINDOW" desc="Tooltip and accessible name of the round button in the sidebar that maximizes the browser window, or restores it when it is already maximized.">
    Maximize
  </message>
  <message name="IDS_AERIE_SIDEBAR_NAVIGATION" desc="Accessible name of the group of the Back, Forward and Reload buttons in the sidebar.">
    Navigation
  </message>
  <message name="IDS_AERIE_SIDEBAR_ADDRESS" desc="Accessible name of the group in the sidebar that holds the address field. The address field is the rounded box where the user types a web address or a search.">
    Address
  </message>
  <message name="IDS_AERIE_SIDEBAR_ROW_ASLEEP_NAME" desc="Accessible name of a tab row in the sidebar when the tab is asleep. A sleeping tab has freed its memory and loads again when the user selects it. The tab's title comes first, then the word asleep.">
    <ph name="TITLE">$1<ex>Example page</ex></ph>, asleep
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB" desc="Item of the context menu of a tab row in the sidebar. It puts the tab to sleep at once, which frees its memory. The tab loads again when the user selects it.">
    Sleep tab
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB_ASLEEP" desc="Tooltip of the disabled Sleep tab menu item when the tab is asleep already.">
    This tab is asleep already
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB_SELECTED" desc="Tooltip of the disabled Sleep tab menu item when the tab is the one the user is looking at. A tab that is on screen cannot sleep.">
    The tab you are viewing cannot sleep
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB_UNAVAILABLE" desc="Tooltip of the disabled Sleep tab menu item when the browser cannot put this tab to sleep, for example because it has no page loaded.">
    This tab cannot sleep
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB_CANNOT_AUDIBLE" desc="Tooltip of the disabled Sleep tab menu item. The tab plays sound, or did a moment ago.">
    This tab is playing sound
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB_CANNOT_CAPTURE" desc="Tooltip of the disabled Sleep tab menu item. The tab shares the screen, the camera or the microphone, is mirrored, shows picture-in-picture, or is connected to a device.">
    This tab is sharing, recording or connected to a device
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB_CANNOT_DEVTOOLS" desc="Tooltip of the disabled Sleep tab menu item. Developer tools are open on the tab.">
    Developer tools are open on this tab
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB_CANNOT_FORM" desc="Tooltip of the disabled Sleep tab menu item. The user has typed in a form on the tab, or the page has unsaved changes.">
    This tab has unsaved changes
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB_CANNOT_PAGE" desc="Tooltip of the disabled Sleep tab menu item. This kind of page cannot sleep, for example a PDF, an extension page or a page that a policy keeps awake.">
    This kind of page cannot sleep
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB_CANNOT_BACKGROUND" desc="Tooltip of the disabled Sleep tab menu item. The tab is working in the background, for example it can send notifications.">
    This tab is working in the background
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEPING_COUNT" desc="Text at the end of the Today heading of the sidebar. It says how many tabs are asleep, for example: 3 asleep.">
    <ph name="COUNT">$1<ex>3</ex></ph> asleep
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEPING_COUNT_AND_MEMORY" desc="Text at the end of the Today heading of the sidebar. It says how many tabs are asleep and an estimate of the memory they freed, in megabytes, rounded to ten. For example: 3 asleep, about 180 MB.">
    <ph name="COUNT">$1<ex>3</ex></ph> asleep, about <ph name="MEGABYTES">$2<ex>180</ex></ph> MB
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEPING_TOOLTIP" desc="Tooltip of the text at the end of the Today heading that says how many tabs are asleep. It tells the user that the memory number is an estimate.">
    Estimate of the memory that sleeping tabs freed
  </message>
  <message name="IDS_AERIE_SIDEBAR_FAVORITES" desc="Accessible name of the grid of Favorites at the top of the sidebar. Favorites are small tiles, one per page the user keeps close.">
    Favorites
  </message>
  <message name="IDS_AERIE_SIDEBAR_PINNED" desc="Accessible name of the list of pinned tabs in the sidebar. A pinned tab stays in this list across restarts and keeps its page.">
    Pinned tabs
  </message>
  <message name="IDS_AERIE_SIDEBAR_BACK_TO_PINNED" desc="Tooltip and accessible name of the button on a pinned tab row in the sidebar. The tab has left its pinned page, and the button takes it back to that page.">
    Back to pinned page
  </message>
  <message name="IDS_AERIE_SIDEBAR_CLOSE_RESET_SLEEP" desc="Tooltip of the close button on a pinned tab when pressing it goes back to the pinned page and puts the tab to sleep.">
    Reset and sleep
  </message>
  <message name="IDS_AERIE_SIDEBAR_CLOSE_SLEEP" desc="Tooltip of the close button on a pinned tab when pressing it puts the tab to sleep and keeps its page.">
    Sleep
  </message>
  <message name="IDS_AERIE_SIDEBAR_CLOSE_CLOSE" desc="Tooltip of the close button on a pinned tab when pressing it unpins and closes the tab.">
    Close
  </message>
  <message name="IDS_AERIE_SIDEBAR_TILE_ASLEEP" desc="Tooltip of a sleeping tile in the Favorites grid of the sidebar. The tab is unloaded, so it uses no memory, and it loads again when the user selects it.">
    Asleep, frees memory
  </message>
  <message name="IDS_AERIE_SIDEBAR_PIN_TAB" desc="Item of the context menu of a tab in the sidebar. It moves the tab to the list of pinned tabs.">
    Pin tab
  </message>
  <message name="IDS_AERIE_SIDEBAR_UNPIN_TAB" desc="Item of the context menu of a pinned tab in the sidebar. It moves the tab back to the list of today's tabs.">
    Unpin tab
  </message>
  <message name="IDS_AERIE_SIDEBAR_ADD_TO_FAVORITES" desc="Item of the context menu of a tab in the sidebar. It makes the tab a Favorite, a small tile at the top of the sidebar.">
    Add to Favorites
  </message>
  <message name="IDS_AERIE_SIDEBAR_REMOVE_FROM_FAVORITES" desc="Item of the context menu of a Favorite in the sidebar. It takes the tab out of the Favorites grid and puts it back where it was.">
    Remove from Favorites
  </message>
  <message name="IDS_AERIE_SIDEBAR_FAVORITES_FULL" desc="Short message that the sidebar shows for a moment when the user tries to add a 13th Favorite. The Favorites grid holds 12.">
    Favorites are full. Remove one to add another.
  </message>
  <message name="IDS_AERIE_SIDEBAR_RENAME_TAB" desc="Item of the context menu of a tab in the sidebar. It opens a field in place of the tab's title, where the user types a name that the sidebar shows instead of the page's title.">
    Rename
  </message>
  <message name="IDS_AERIE_SIDEBAR_RESET_NAME" desc="Item of the context menu of a tab in the sidebar that has a name the user typed. It removes that name, so the sidebar shows the page's title again. It also names the small pencil button after the title of such a tab.">
    Reset name
  </message>
  <message name="IDS_AERIE_SIDEBAR_RENAME_FIELD_NAME" desc="Accessible name of the text field in which the user types a new name for a tab in the sidebar.">
    Tab name
  </message>
  <message name="IDS_AERIE_SIDEBAR_RENAME_POPOVER" desc="Accessible name of the small popover with a text field in which the user types a new name for a Favorite. A Favorite is a small tile with no title on it.">
    Rename tab
  </message>
  <message name="IDS_AERIE_SIDEBAR_RENAME_CAPTION" desc="Short help text under the text field in which the user types a new name for a tab in the sidebar. A screen reader reads it as the description of the field.">
    Enter keeps, Esc cancels. Empty or the page title resets.
  </message>
  <message name="IDS_AERIE_SIDEBAR_ROW_RENAMED_NAME" desc="Accessible name of a tab row in the sidebar when the user gave the tab a name. The name that the row shows comes first, then the word renamed.">
    <ph name="TITLE">$1<ex>Example page</ex></ph>, renamed
  </message>
  <message name="IDS_AERIE_SIDEBAR_RENAMED_TOOLTIP" desc="First line of the tooltip of the pencil button on a renamed tab in the sidebar. It tells the real title of the page, and that the sidebar shows the user's own name instead.">
    Page title: <ph name="TITLE">$1<ex>Example page</ex></ph>. Shown: your name.
  </message>
  <message name="IDS_AERIE_SIDEBAR_RENAMED_PRECEDENCE" desc="Second line of the tooltip of the pencil button on a renamed tab in the sidebar. It lists, in order, where the title that the sidebar shows can come from. The first one that applies wins.">
    Order: your name, rename rule (no rule matches), tidy (none), AI title (off), page title.
  </message>
  <message name="IDS_SETTINGS_AERIE_SLEEP_AFTER" desc="Label of the drop-down in the Sidebar section of Settings that sets how long a tab can be idle before it is put to sleep.">
    Put inactive tabs to sleep after
  </message>
  <message name="IDS_SETTINGS_AERIE_SLEEP_AFTER_DESC" desc="Line under the sleep drop-down in Settings. It says what a sleeping tab is.">
    A sleeping tab frees its memory and loads again when you select it.
  </message>
  <message name="IDS_SETTINGS_AERIE_SLEEP_15_MIN" desc="Option of the sleep drop-down in Settings: 15 minutes.">
    15 minutes
  </message>
  <message name="IDS_SETTINGS_AERIE_SLEEP_30_MIN" desc="Option of the sleep drop-down in Settings: 30 minutes.">
    30 minutes
  </message>
  <message name="IDS_SETTINGS_AERIE_SLEEP_1_HOUR" desc="Option of the sleep drop-down in Settings: 1 hour. This is the default.">
    1 hour
  </message>
  <message name="IDS_SETTINGS_AERIE_SLEEP_2_HOURS" desc="Option of the sleep drop-down in Settings: 2 hours.">
    2 hours
  </message>
  <message name="IDS_SETTINGS_AERIE_SLEEP_4_HOURS" desc="Option of the sleep drop-down in Settings: 4 hours.">
    4 hours
  </message>
  <message name="IDS_SETTINGS_AERIE_SLEEP_8_HOURS" desc="Option of the sleep drop-down in Settings: 8 hours.">
    8 hours
  </message>
  <message name="IDS_SETTINGS_AERIE_SLEEP_NEVER" desc="Option of the sleep drop-down in Settings: tabs never go to sleep by themselves.">
    Never
  </message>
  <message name="IDS_SETTINGS_AERIE_PINNED_CLOSE" desc="Label of the drop-down in the Sidebar section of Settings that sets what Ctrl+W and the close button do on a pinned tab. A pinned tab is one the user keeps in the Pinned section of the sidebar.">
    Close a pinned tab
  </message>
  <message name="IDS_SETTINGS_AERIE_PINNED_CLOSE_DESC" desc="Line under the pinned-close drop-down in Settings. It says that the second press closes the tab for good.">
    A second press on a tab that is already asleep unpins and closes it.
  </message>
  <message name="IDS_SETTINGS_AERIE_PINNED_CLOSE_RESET_SLEEP_SWITCH" desc="Option of the pinned-close drop-down in Settings, the default. Closing a pinned tab goes back to its pinned page, puts the tab to sleep and selects the next tab.">
    Reset, sleep and switch
  </message>
  <message name="IDS_SETTINGS_AERIE_PINNED_CLOSE_SLEEP" desc="Option of the pinned-close drop-down in Settings. Closing a pinned tab puts it to sleep and selects the next tab. The page stays as it is.">
    Sleep only
  </message>
  <message name="IDS_SETTINGS_AERIE_PINNED_CLOSE_CLOSE" desc="Option of the pinned-close drop-down in Settings. Closing a pinned tab unpins and closes it.">
    Close
  </message>
  <message name="IDS_SETTINGS_AERIE_FOLDER_RULES" desc="Label of the switch in the Sidebar section of Settings that turns the rules of all folders on or off. A folder can have rules that put new tabs into it by themselves.">
    Folder rules everywhere
  </message>
  <message name="IDS_SETTINGS_AERIE_FOLDER_RULES_DESC" desc="Line under the folder-rules switch in Settings. When the switch is off, no folder moves a new tab into itself.">
    Let folders with rules file new tabs by themselves. Turn this off to stop every folder at once.
  </message>
  <message name="IDS_AERIE_SIDEBAR_NEW_FOLDER" desc="Item of the context menu in the sidebar that makes a new, empty folder for tabs. It is also the name that a new folder starts with, until the user renames it.">
    New folder
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_TOO_DEEP" desc="Tooltip of the disabled New folder item of the sidebar context menu, and the hint shown when a folder would be nested too deeply. The number is the most levels of folders inside folders that the sidebar allows.">
    Can't nest deeper than <ph name="LEVELS">$1<ex>5</ex></ph> levels
  </message>
  <message name="IDS_AERIE_SIDEBAR_MOVED_TO" desc="Said to a screen reader after the user moves a tab or folder with Alt and an arrow key in the sidebar. The first number is the new place among the items next to it, the second is how many items there are.">
    Moved to <ph name="CONTAINER">$1<ex>Trips</ex></ph>, position <ph name="POSITION">$2<ex>2</ex></ph> of <ph name="COUNT">$3<ex>4</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_RENAME_FOLDER" desc="Item of the context menu of a folder in the sidebar. It opens a field in place of the folder's name, where the user types a new name.">
    Rename folder
  </message>
  <message name="IDS_AERIE_SIDEBAR_DELETE_FOLDER" desc="Item of the context menu of a folder in the sidebar, and the button of the question that asks whether to delete a folder that holds tabs. The tabs in the folder are not closed: they move out of it.">
    Delete folder
  </message>
  <message name="IDS_AERIE_SIDEBAR_MOVE_TO_NEW_FOLDER" desc="Item of the context menu of a tab in the sidebar. It makes a new folder where the tab is and puts the tab in it.">
    Move to new folder
  </message>
  <message name="IDS_AERIE_SIDEBAR_MOVE_TO_FOLDER" desc="Item of the context menu of a tab in the sidebar. It opens a list of the folders; choosing one puts the tab in that folder.">
    Move to folder
  </message>
  <message name="IDS_AERIE_SIDEBAR_MOVE_OUT_OF_FOLDER" desc="Item of the context menu of a tab in a folder in the sidebar. It moves the tab out of the folder, to the place next to the folder.">
    Move out of folder
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_ITEMS" desc="The number of things (tabs and folders) that a folder in the sidebar holds. A screen reader reads it as part of the folder's name.">
    {COUNT, plural,
      =0 {empty}
      =1 {1 item}
      other {# items}}
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_NAME_EXPANDED" desc="Accessible name of a folder row in the sidebar that is open and shows what is in it. The folder's name comes first, then the word folder, the state, and the number of items, for example: Trips, folder, expanded, 3 items.">
    <ph name="NAME">$1<ex>Trips</ex></ph>, folder, expanded, <ph name="ITEMS">$2<ex>3 items</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_NAME_COLLAPSED" desc="Accessible name of a folder row in the sidebar that is shut and hides what is in it. The folder's name comes first, then the word folder, the state, and the number of items, for example: Trips, folder, collapsed, 3 items.">
    <ph name="NAME">$1<ex>Trips</ex></ph>, folder, collapsed, <ph name="ITEMS">$2<ex>3 items</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_HAS_SELECTED" desc="End of the accessible name of a shut folder row in the sidebar that holds the tab that is open now. The rest of the name comes first.">
    <ph name="NAME">$1<ex>Trips, folder, collapsed, 3 items</ex></ph>, holds the open tab
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_RENAME_FIELD_NAME" desc="Accessible name of the text field in which the user types a new name for a folder in the sidebar.">
    Folder name
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_RENAME_CAPTION" desc="Short help text under the text field in which the user types a new name for a folder in the sidebar. A screen reader reads it as the description of the field.">
    Enter keeps, Esc cancels. Empty keeps the old name.
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_DELETE_TITLE" desc="Title of the question that asks whether to delete a folder in the sidebar that holds tabs.">
    Delete this folder?
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_DELETE_BODY" desc="Text of the question that asks whether to delete a folder in the sidebar that holds tabs. It says what the folder holds. No tab is closed: they move out, next to the folder.">
    This folder holds <ph name="ITEMS">$1<ex>3 items</ex></ph>. They move out, next to the folder. No tab closes.
  </message>
  <message name="IDS_AERIE_SIDEBAR_EDIT_FOLDER" desc="Item of the context menu of a folder in the sidebar. It opens the folder editor, where the user sets the folder's name, its kind and its rules. The three dots say that more input follows.">
    Edit folder...
  </message>
  <message name="IDS_AERIE_SIDEBAR_STOP_RULE_MATCHING" desc="Item of the context menu of a tab that a folder rule filed by itself. It adds this tab to the folder's exceptions, so that the rule never files it again, and moves the tab out of the folder.">
    Stop this rule matching this tab
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_RULES_BUTTON" desc="Tooltip and accessible name of the small funnel button on the row of an auto-filing folder in the sidebar. It opens the folder editor.">
    Edit folder rules
  </message>
  <message name="IDS_AERIE_SIDEBAR_AUTO_FOLDER_NAME_EXPANDED" desc="Accessible name of a folder row in the sidebar that files new tabs by rules and is open. The name comes first, then the kind, the state and the number of items, for example: Trips, auto-filing folder, expanded, 3 items.">
    <ph name="NAME">$1<ex>Trips</ex></ph>, auto-filing folder, expanded, <ph name="ITEMS">$2<ex>3 items</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_AUTO_FOLDER_NAME_COLLAPSED" desc="Accessible name of a folder row in the sidebar that files new tabs by rules and is shut. The name comes first, then the kind, the state and the number of items, for example: Trips, auto-filing folder, collapsed, 3 items.">
    <ph name="NAME">$1<ex>Trips</ex></ph>, auto-filing folder, collapsed, <ph name="ITEMS">$2<ex>3 items</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_FILED_INTO" desc="Message in the small notice at the bottom of the sidebar after a folder rule moved a new tab into a folder by itself. A screen reader reads it politely.">
    Filed into <ph name="FOLDER">$1<ex>Trips</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_FILED_UNDO" desc="Button in the notice that says a tab was filed into a folder by a rule. It puts the tab back where it was.">
    Undo
  </message>
  <message name="IDS_AERIE_SIDEBAR_FILED_DONT_FILE_SITE" desc="Button in the notice that says a tab was filed into a folder by a rule. It adds the tab's website to the folder's exceptions, so that no tab of that website is filed there again.">
    Don't file this site
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_TITLE" desc="Accessible name of the folder editor, a small panel next to the sidebar. A screen reader reads it when the panel opens.">
    Edit folder <ph name="NAME">$1<ex>Trips</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_NAME_FIELD" desc="Accessible name of the text field in the folder editor where the user types the folder's name.">
    Folder name
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_KIND_LABEL" desc="Label of the choice in the folder editor between the kinds of folder.">
    Kind
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_KIND_MANUAL" desc="Choice in the folder editor: a folder that only holds what the user puts in it.">
    Manual
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_KIND_AUTO" desc="Choice in the folder editor: a folder that moves new tabs into itself when they match its rules.">
    Auto-filing
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_RULES_LABEL" desc="Heading of the list of rules in the folder editor, and the accessible name of that list. A rule says which new tabs go into the folder.">
    Rules
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_RULE_TYPE" desc="Accessible name of the choice of rule type in the folder editor.">
    Rule type
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_RULE_VALUE" desc="Accessible name of the text field in the folder editor where the user types what a rule looks for.">
    Rule text
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_ADD_RULE" desc="Button in the folder editor that adds the rule the user typed to the folder.">
    Add rule
  </message>
  <message name="IDS_AERIE_SIDEBAR_RULE_TYPE_DOMAIN" desc="Type of a folder rule: the website or one of its subdomains, for example example.com.">
    Domain
  </message>
  <message name="IDS_AERIE_SIDEBAR_RULE_TYPE_URL_STARTS" desc="Type of a folder rule: the address of the page starts with the text.">
    URL starts with
  </message>
  <message name="IDS_AERIE_SIDEBAR_RULE_TYPE_URL_CONTAINS" desc="Type of a folder rule: the address of the page has the text somewhere in it.">
    URL contains
  </message>
  <message name="IDS_AERIE_SIDEBAR_RULE_TYPE_TITLE_CONTAINS" desc="Type of a folder rule: the title of the page has the text somewhere in it. Capital letters do not matter.">
    Title contains
  </message>
  <message name="IDS_AERIE_SIDEBAR_RULE_CHIP" desc="Text of one rule in the folder editor: the type, then the text the rule looks for, for example: Domain: example.com.">
    <ph name="TYPE">$1<ex>Domain</ex></ph>: <ph name="VALUE">$2<ex>example.com</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_RULE_CHIP_OFF" desc="Accessible name of the switch of one rule in the folder editor. The switch turns that one rule on or off.">
    Rule <ph name="RULE">$1<ex>Domain: example.com</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_RULE_REMOVE" desc="Accessible name of the small button that removes one rule in the folder editor.">
    Remove rule <ph name="RULE">$1<ex>Domain: example.com</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_EXCEPTIONS_LABEL" desc="Heading of the list of exceptions in the folder editor. An exception is a website or a tab that the folder's rules never file.">
    Exceptions
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_EXCEPTION_REMOVE" desc="Accessible name of the small button that removes one exception in the folder editor.">
    Remove exception <ph name="HOST">$1<ex>example.com</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_EXCEPTIONS_EMPTY" desc="Text in the folder editor when the folder has no exceptions.">
    No exceptions.
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_ALL_SWITCH" desc="Label and accessible name of the switch in the folder editor that turns all rules of this one folder on or off.">
    All rules in this folder
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_GLOBAL_SWITCH" desc="Label and accessible name of the switch in the folder editor that turns the rules of every folder on or off. The same switch is in Settings.">
    Folder rules everywhere
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_DONE" desc="Button that closes the folder editor. Changes are already saved.">
    Done
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_RULES_FULL" desc="Text in the folder editor when the folder has the most rules it can have.">
    This folder has the most rules it can have.
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_SAVE_RULE" desc="Button in the folder editor that replaces a rule the user is editing with the new text. It takes the place of the Add rule button while a rule is edited.">
    Save rule
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_DENSITY" desc="Label of the setting in the Sidebar section of Settings that chooses how dense the sidebar is.">
    Sidebar density
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_DENSITY_DESC" desc="Description under the Sidebar density setting. It says what the four choices change.">
    How much room the sidebar takes. Auto-hide hides it until you move the pointer to the edge of the window.
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_DENSITY_COMFORTABLE" desc="Choice of the Sidebar density setting: the default sidebar with roomy rows.">
    Comfortable
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_DENSITY_COMPACT" desc="Choice of the Sidebar density setting: the sidebar with shorter rows and smaller tiles.">
    Compact
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_DENSITY_RAIL" desc="Choice of the Sidebar density setting: a thin strip that shows only icons, no titles.">
    Collapsed rail
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_DENSITY_AUTO_HIDE" desc="Choice of the Sidebar density setting: the sidebar is hidden until the pointer touches the edge of the window.">
    Auto-hide
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_SIDE" desc="Label of the setting in the Sidebar section of Settings that chooses which side of the window the sidebar is on.">
    Sidebar side
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_SIDE_DESC" desc="Description under the Sidebar side setting.">
    Put the sidebar on the left or on the right of the window.
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_SIDE_LEFT" desc="Choice of the Sidebar side setting: the sidebar is on the left.">
    Left
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_SIDE_RIGHT" desc="Choice of the Sidebar side setting: the sidebar is on the right.">
    Right
  </message>
  <message name="IDS_AERIE_SIDEBAR_PEEK_KEPT_OPEN" desc="Short message that shows in the sidebar after the user pressed Ctrl+Alt+S while the sidebar was hidden at the edge of the window. It says the sidebar stays open now.">
    Sidebar stays open
  </message>
  <message name="IDS_AERIE_SIDEBAR_PEEK_RELEASED" desc="Short message that shows in the sidebar after the user pressed Ctrl+Alt+S again. It says the sidebar hides again when the pointer moves away.">
    Sidebar hides when you move away
  </message>
  <message name="IDS_AERIE_SIDEBAR_GUARD_BUTTON" desc="Tooltip and accessible name of the square shield button that replaces the address field in the collapsed sidebar. It opens the Guard panel of the current site.">
    Guard
  </message>
</grit-part>
