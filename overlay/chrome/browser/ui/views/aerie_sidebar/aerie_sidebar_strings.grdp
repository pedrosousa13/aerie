<?xml version="1.0" encoding="utf-8"?>
<!-- Copyright 2026 The Aerie Authors
     You can use, redistribute, and/or modify this source code under
     the terms of the GPL-3.0 license that can be found in the LICENSE file.

     Strings of the Aerie sidebar (issue #177). patches/sidebar/0022 includes this part in generated_resources.grd and
     gives the Settings title to the page under the name tests/test_sidebar.py checks. The strings of the sidebar view
     (its accessible names and the resize separator) are in this part too. -->
<grit-part>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR" desc="Title of the Sidebar section of Settings, where the settings of the browser's vertical tab sidebar are. It has no settings yet.">
    Sidebar
  </message>
  <message name="IDS_AERIE_SIDEBAR_NAME" desc="Accessible name of the sidebar, the navigation landmark on the side of the window that holds the list of tabs.">
    Sidebar
  </message>
  <message name="IDS_AERIE_SIDEBAR_TODAY" desc="Heading of the list of unpinned tabs in the sidebar. It is also the accessible name of that list.">
    Today
  </message>
  <message name="IDS_AERIE_SIDEBAR_NEW_TAB" desc="Label of the row and of the plus button in the sidebar that open a new tab.">
    New Tab
  </message>
  <message name="IDS_AERIE_SIDEBAR_CLOSE_TAB" desc="Tooltip and accessible name of the button on a tab row of the sidebar that closes the tab.">
    Close tab
  </message>
  <message name="IDS_AERIE_SIDEBAR_RESIZE" desc="Accessible name of the separator at the inner edge of the sidebar. The user drags it, or presses the left and right arrow keys on it, to change the width of the sidebar.">
    Resize sidebar
  </message>
  <message name="IDS_AERIE_SIDEBAR_RESIZE_ANNOUNCE" desc="What a screen reader says after the user changed the width of the sidebar with the arrow keys. The number is the new width in pixels.">
    Sidebar width <ph name="WIDTH">$1<ex>260</ex></ph> pixels
  </message>
  <message name="IDS_AERIE_SIDEBAR_TOP_ROW" desc="Accessible name of the row at the top of the sidebar that holds the window controls, the button that hides the sidebar, and the Back, Forward and Reload buttons.">
    Sidebar controls
  </message>
  <message name="IDS_AERIE_SIDEBAR_HIDE" desc="Tooltip and accessible name of the button in the top row of the sidebar that hides the sidebar. The keyboard shortcut for it is Ctrl+S.">
    Hide sidebar
  </message>
  <message name="IDS_AERIE_SIDEBAR_WINDOW_CONTROLS" desc="Accessible name of the group of three round buttons in the sidebar that close, minimize and maximize the browser window.">
    Window controls
  </message>
  <message name="IDS_AERIE_SIDEBAR_CLOSE_WINDOW" desc="Tooltip and accessible name of the round button in the sidebar that closes the browser window.">
    Close window
  </message>
  <message name="IDS_AERIE_SIDEBAR_MINIMIZE_WINDOW" desc="Tooltip and accessible name of the round button in the sidebar that minimizes the browser window.">
    Minimize
  </message>
  <message name="IDS_AERIE_SIDEBAR_MAXIMIZE_WINDOW" desc="Tooltip and accessible name of the round button in the sidebar that maximizes the browser window, or restores it when it is already maximized.">
    Maximize
  </message>
  <message name="IDS_AERIE_SIDEBAR_NAVIGATION" desc="Accessible name of the group of the Back, Forward and Reload buttons in the sidebar.">
    Navigation
  </message>
  <message name="IDS_AERIE_SIDEBAR_ADDRESS" desc="Accessible name of the group in the sidebar that holds the address field. The address field is the rounded box where the user types a web address or a search.">
    Address
  </message>
  <message name="IDS_AERIE_SIDEBAR_ROW_ASLEEP_NAME" desc="Accessible name of a tab row in the sidebar when the tab is asleep. A sleeping tab has freed its memory and loads again when the user selects it. The tab's title comes first, then the word asleep.">
    <ph name="TITLE">$1<ex>Example page</ex></ph>, asleep
  </message>
  <message name="IDS_AERIE_SIDEBAR_KEEP_LOADED" desc="Check item of the context menu of a tab row in the sidebar. When it is checked, the tab is kept loaded: it never goes to sleep on the idle timer and is never archived automatically. It protects a call, music, a chat or an editor.">
    Keep loaded
  </message>
  <message name="IDS_AERIE_SIDEBAR_KEEP_LOADED_TOOLTIP" desc="Tooltip of the small mark on a tab row in the sidebar. The mark shows that the tab is kept loaded, so it never goes to sleep and is never archived automatically.">
    Kept loaded: this tab never sleeps or archives
  </message>
  <message name="IDS_AERIE_SIDEBAR_ROW_KEPT_NAME" desc="Accessible name of a tab row in the sidebar when the tab is kept loaded, so it never goes to sleep and is never archived automatically. The tab's title comes first, then the words kept loaded.">
    <ph name="TITLE">$1<ex>Example page</ex></ph>, kept loaded
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB" desc="Item of the context menu of a tab row in the sidebar. It puts the tab to sleep at once, which frees its memory. The tab loads again when the user selects it.">
    Sleep tab
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB_ASLEEP" desc="Tooltip of the disabled Sleep tab menu item when the tab is asleep already.">
    This tab is asleep already
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB_SELECTED" desc="Tooltip of the disabled Sleep tab menu item when the tab is the one the user is looking at. A tab that is on screen cannot sleep.">
    The tab you are viewing cannot sleep
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB_UNAVAILABLE" desc="Tooltip of the disabled Sleep tab menu item when the browser cannot put this tab to sleep, for example because it has no page loaded.">
    This tab cannot sleep
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB_CANNOT_AUDIBLE" desc="Tooltip of the disabled Sleep tab menu item. The tab plays sound, or did a moment ago.">
    This tab is playing sound
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB_CANNOT_CAPTURE" desc="Tooltip of the disabled Sleep tab menu item. The tab shares the screen, the camera or the microphone, is mirrored, shows picture-in-picture, or is connected to a device.">
    This tab is sharing, recording or connected to a device
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB_CANNOT_DEVTOOLS" desc="Tooltip of the disabled Sleep tab menu item. Developer tools are open on the tab.">
    Developer tools are open on this tab
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB_CANNOT_FORM" desc="Tooltip of the disabled Sleep tab menu item. The user has typed in a form on the tab, or the page has unsaved changes.">
    This tab has unsaved changes
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB_CANNOT_PAGE" desc="Tooltip of the disabled Sleep tab menu item. This kind of page cannot sleep, for example a PDF, an extension page or a page that a policy keeps awake.">
    This kind of page cannot sleep
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEP_TAB_CANNOT_BACKGROUND" desc="Tooltip of the disabled Sleep tab menu item. The tab is working in the background, for example it can send notifications.">
    This tab is working in the background
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEPING_COUNT" desc="Text at the end of the Today heading of the sidebar. It says how many tabs are asleep, for example: 3 asleep.">
    <ph name="COUNT">$1<ex>3</ex></ph> asleep
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEPING_COUNT_AND_MEMORY" desc="Text at the end of the Today heading of the sidebar. It says how many tabs are asleep and an estimate of the memory they freed, in megabytes, rounded to ten. For example: 3 asleep, about 180 MB.">
    <ph name="COUNT">$1<ex>3</ex></ph> asleep, about <ph name="MEGABYTES">$2<ex>180</ex></ph> MB
  </message>
  <message name="IDS_AERIE_SIDEBAR_SLEEPING_TOOLTIP" desc="Tooltip of the text at the end of the Today heading that says how many tabs are asleep. It tells the user that the memory number is an estimate.">
    Estimate of the memory that sleeping tabs freed
  </message>
  <message name="IDS_AERIE_SIDEBAR_FAVORITES" desc="Accessible name of the grid of Favorites at the top of the sidebar. Favorites are small tiles, one per page the user keeps close.">
    Favorites
  </message>
  <message name="IDS_AERIE_SIDEBAR_PINNED" desc="Accessible name of the list of pinned tabs in the sidebar. A pinned tab stays in this list across restarts and keeps its page.">
    Pinned tabs
  </message>
  <message name="IDS_AERIE_SIDEBAR_BACK_TO_PINNED" desc="Tooltip and accessible name of the button on a pinned tab row in the sidebar. The tab has left its pinned page, and the button takes it back to that page.">
    Back to pinned page
  </message>
  <message name="IDS_AERIE_SIDEBAR_CLOSE_RESET_SLEEP" desc="Tooltip of the close button on a pinned tab when pressing it goes back to the pinned page and puts the tab to sleep.">
    Reset and sleep
  </message>
  <message name="IDS_AERIE_SIDEBAR_CLOSE_SLEEP" desc="Tooltip of the close button on a pinned tab when pressing it puts the tab to sleep and keeps its page.">
    Sleep
  </message>
  <message name="IDS_AERIE_SIDEBAR_CLOSE_CLOSE" desc="Tooltip of the close button on a pinned tab when pressing it unpins and closes the tab.">
    Close
  </message>
  <message name="IDS_AERIE_SIDEBAR_TILE_ASLEEP" desc="Tooltip of a sleeping tile in the Favorites grid of the sidebar. The tab is unloaded, so it uses no memory, and it loads again when the user selects it.">
    Asleep, frees memory
  </message>
  <message name="IDS_AERIE_SIDEBAR_PIN_TAB" desc="Item of the context menu of a tab in the sidebar. It moves the tab to the list of pinned tabs.">
    Pin tab
  </message>
  <message name="IDS_AERIE_SIDEBAR_UNPIN_TAB" desc="Item of the context menu of a pinned tab in the sidebar. It moves the tab back to the list of today's tabs.">
    Unpin tab
  </message>
  <message name="IDS_AERIE_SIDEBAR_ADD_TO_FAVORITES" desc="Item of the context menu of a tab in the sidebar. It makes the tab a Favorite, a small tile at the top of the sidebar.">
    Add to Favorites
  </message>
  <message name="IDS_AERIE_SIDEBAR_REMOVE_FROM_FAVORITES" desc="Item of the context menu of a Favorite in the sidebar. It takes the tab out of the Favorites grid and puts it back where it was.">
    Remove from Favorites
  </message>
  <message name="IDS_AERIE_SIDEBAR_FAVORITES_FULL" desc="Short message that the sidebar shows for a moment when the user tries to add a 13th Favorite. The Favorites grid holds 12.">
    Favorites are full. Remove one to add another.
  </message>
  <message name="IDS_AERIE_SIDEBAR_RENAME_TAB" desc="Item of the context menu of a tab in the sidebar. It opens a field in place of the tab's title, where the user types a name that the sidebar shows instead of the page's title.">
    Rename
  </message>
  <message name="IDS_AERIE_SIDEBAR_RESET_NAME" desc="Item of the context menu of a tab in the sidebar that has a name the user typed. It removes that name, so the sidebar shows the page's title again. It also names the small pencil button after the title of such a tab.">
    Reset name
  </message>
  <message name="IDS_AERIE_SIDEBAR_RENAME_FIELD_NAME" desc="Accessible name of the text field in which the user types a new name for a tab in the sidebar.">
    Tab name
  </message>
  <message name="IDS_AERIE_SIDEBAR_RENAME_POPOVER" desc="Accessible name of the small popover with a text field in which the user types a new name for a Favorite. A Favorite is a small tile with no title on it.">
    Rename tab
  </message>
  <message name="IDS_AERIE_SIDEBAR_RENAME_CAPTION" desc="Short help text under the text field in which the user types a new name for a tab in the sidebar. A screen reader reads it as the description of the field.">
    Enter keeps, Esc cancels. Empty or the page title resets.
  </message>
  <message name="IDS_AERIE_SIDEBAR_ROW_RENAMED_NAME" desc="Accessible name of a tab row in the sidebar when the user gave the tab a name. The name that the row shows comes first, then the word renamed.">
    <ph name="TITLE">$1<ex>Example page</ex></ph>, renamed
  </message>
  <message name="IDS_AERIE_SIDEBAR_RENAMED_TOOLTIP" desc="First line of the tooltip of the pencil button on a renamed tab in the sidebar. It tells the real title of the page, and that the sidebar shows the user's own name instead.">
    Page title: <ph name="TITLE">$1<ex>Example page</ex></ph>. Shown: your name.
  </message>
  <message name="IDS_AERIE_SIDEBAR_RENAMED_PRECEDENCE" desc="Second line of the tooltip of the pencil button on a renamed tab in the sidebar. It lists, in order, where the title that the sidebar shows can come from. The first one that applies wins.">
    Order: your name, rename rule, tidy, AI title (off), page title.
  </message>
  <message name="IDS_AERIE_SIDEBAR_TIDIED_TOOLTIP" desc="Tooltip of a tab row in the sidebar whose title the browser tidied on the device (it dropped a site name, an unread count or a repeated separator). It tells the original title.">
    Tidied, original: <ph name="TITLE">$1<ex>Inbox (3) - Gmail</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_RULE_RENAMED_TOOLTIP" desc="Tooltip of a tab row in the sidebar whose title one of the user's rename rules changed. It tells the name of the rule and the original title.">
    Renamed by rule <ph name="RULE">$1<ex>Mail</ex></ph>, original: <ph name="TITLE">$2<ex>Inbox (3) - Gmail</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_MAKE_RULE" desc="Item of the context menu of a tab in the sidebar. It opens Settings with the editor for a new rename rule, filled in from this tab.">
    Make a rename rule from this tab...
  </message>
  <message name="IDS_SETTINGS_AERIE_SLEEP_AFTER" desc="Label of the drop-down in the Sidebar section of Settings that sets how long a tab can be idle before it is put to sleep.">
    Put inactive tabs to sleep after
  </message>
  <message name="IDS_SETTINGS_AERIE_SLEEP_AFTER_DESC" desc="Line under the sleep drop-down in Settings. It says what a sleeping tab is.">
    A sleeping tab frees its memory and loads again when you select it.
  </message>
  <message name="IDS_SETTINGS_AERIE_SLEEP_15_MIN" desc="Option of the sleep drop-down in Settings: 15 minutes.">
    15 minutes
  </message>
  <message name="IDS_SETTINGS_AERIE_SLEEP_30_MIN" desc="Option of the sleep drop-down in Settings: 30 minutes.">
    30 minutes
  </message>
  <message name="IDS_SETTINGS_AERIE_SLEEP_1_HOUR" desc="Option of the sleep drop-down in Settings: 1 hour. This is the default.">
    1 hour
  </message>
  <message name="IDS_SETTINGS_AERIE_SLEEP_2_HOURS" desc="Option of the sleep drop-down in Settings: 2 hours.">
    2 hours
  </message>
  <message name="IDS_SETTINGS_AERIE_SLEEP_4_HOURS" desc="Option of the sleep drop-down in Settings: 4 hours.">
    4 hours
  </message>
  <message name="IDS_SETTINGS_AERIE_SLEEP_8_HOURS" desc="Option of the sleep drop-down in Settings: 8 hours.">
    8 hours
  </message>
  <message name="IDS_SETTINGS_AERIE_SLEEP_NEVER" desc="Option of the sleep drop-down in Settings: tabs never go to sleep by themselves.">
    Never
  </message>
  <message name="IDS_SETTINGS_AERIE_PINNED_CLOSE" desc="Label of the drop-down in the Sidebar section of Settings that sets what Ctrl+W and the close button do on a pinned tab. A pinned tab is one the user keeps in the Pinned section of the sidebar.">
    Close a pinned tab
  </message>
  <message name="IDS_SETTINGS_AERIE_PINNED_CLOSE_DESC" desc="Line under the pinned-close drop-down in Settings. It says that the second press closes the tab for good.">
    A second press on a tab that is already asleep unpins it and sends it to the Archive.
  </message>
  <message name="IDS_SETTINGS_AERIE_PINNED_CLOSE_RESET_SLEEP_SWITCH" desc="Option of the pinned-close drop-down in Settings, the default. Closing a pinned tab goes back to its pinned page, puts the tab to sleep and selects the next tab.">
    Reset, sleep and switch
  </message>
  <message name="IDS_SETTINGS_AERIE_PINNED_CLOSE_SLEEP" desc="Option of the pinned-close drop-down in Settings. Closing a pinned tab puts it to sleep and selects the next tab. The page stays as it is.">
    Sleep only
  </message>
  <message name="IDS_SETTINGS_AERIE_PINNED_CLOSE_CLOSE" desc="Option of the pinned-close drop-down in Settings. Closing a pinned tab unpins and closes it.">
    Close
  </message>
  <message name="IDS_SETTINGS_AERIE_FOLDER_RULES" desc="Label of the switch in the Sidebar section of Settings that turns the rules of all folders on or off. A folder can have rules that put new tabs into it by themselves.">
    Folder rules everywhere
  </message>
  <message name="IDS_SETTINGS_AERIE_FOLDER_RULES_DESC" desc="Line under the folder-rules switch in Settings. When the switch is off, no folder moves a new tab into itself.">
    Let folders with rules file new tabs by themselves. Turn this off to stop every folder at once.
  </message>
  <message name="IDS_AERIE_SIDEBAR_NEW_FOLDER" desc="Item of the context menu in the sidebar that makes a new, empty folder for tabs. It is also the name that a new folder starts with, until the user renames it.">
    New folder
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_TOO_DEEP" desc="Tooltip of the disabled New folder item of the sidebar context menu, and the hint shown when a folder would be nested too deeply. The number is the most levels of folders inside folders that the sidebar allows.">
    Can't nest deeper than <ph name="LEVELS">$1<ex>5</ex></ph> levels
  </message>
  <message name="IDS_AERIE_SIDEBAR_MOVED_TO" desc="Said to a screen reader after the user moves a tab or folder with Alt and an arrow key in the sidebar. The first number is the new place among the items next to it, the second is how many items there are.">
    Moved to <ph name="CONTAINER">$1<ex>Trips</ex></ph>, position <ph name="POSITION">$2<ex>2</ex></ph> of <ph name="COUNT">$3<ex>4</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_RENAME_FOLDER" desc="Item of the context menu of a folder in the sidebar. It opens a field in place of the folder's name, where the user types a new name.">
    Rename folder
  </message>
  <message name="IDS_AERIE_SIDEBAR_DELETE_FOLDER" desc="Item of the context menu of a folder in the sidebar, and the button of the question that asks whether to delete a folder that holds tabs. The tabs in the folder are not closed: they move out of it.">
    Delete folder
  </message>
  <message name="IDS_AERIE_SIDEBAR_MOVE_TO_NEW_FOLDER" desc="Item of the context menu of a tab in the sidebar. It makes a new folder where the tab is and puts the tab in it.">
    Move to new folder
  </message>
  <message name="IDS_AERIE_SIDEBAR_MOVE_TO_FOLDER" desc="Item of the context menu of a tab in the sidebar. It opens a list of the folders; choosing one puts the tab in that folder.">
    Move to folder
  </message>
  <message name="IDS_AERIE_SIDEBAR_MOVE_OUT_OF_FOLDER" desc="Item of the context menu of a tab in a folder in the sidebar. It moves the tab out of the folder, to the place next to the folder.">
    Move out of folder
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_ITEMS" desc="The number of things (tabs and folders) that a folder in the sidebar holds. A screen reader reads it as part of the folder's name.">
    {COUNT, plural,
      =0 {empty}
      =1 {1 item}
      other {# items}}
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_NAME_EXPANDED" desc="Accessible name of a folder row in the sidebar that is open and shows what is in it. The folder's name comes first, then the word folder, the state, and the number of items, for example: Trips, folder, expanded, 3 items.">
    <ph name="NAME">$1<ex>Trips</ex></ph>, folder, expanded, <ph name="ITEMS">$2<ex>3 items</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_NAME_COLLAPSED" desc="Accessible name of a folder row in the sidebar that is shut and hides what is in it. The folder's name comes first, then the word folder, the state, and the number of items, for example: Trips, folder, collapsed, 3 items.">
    <ph name="NAME">$1<ex>Trips</ex></ph>, folder, collapsed, <ph name="ITEMS">$2<ex>3 items</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_HAS_SELECTED" desc="End of the accessible name of a shut folder row in the sidebar that holds the tab that is open now. The rest of the name comes first.">
    <ph name="NAME">$1<ex>Trips, folder, collapsed, 3 items</ex></ph>, holds the open tab
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_RENAME_FIELD_NAME" desc="Accessible name of the text field in which the user types a new name for a folder in the sidebar.">
    Folder name
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_RENAME_CAPTION" desc="Short help text under the text field in which the user types a new name for a folder in the sidebar. A screen reader reads it as the description of the field.">
    Enter keeps, Esc cancels. Empty keeps the old name.
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_DELETE_TITLE" desc="Title of the question that asks whether to delete a folder in the sidebar that holds tabs.">
    Delete this folder?
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_DELETE_BODY" desc="Text of the question that asks whether to delete a folder in the sidebar that holds tabs. It says what the folder holds. No tab is closed: they move out, next to the folder.">
    This folder holds <ph name="ITEMS">$1<ex>3 items</ex></ph>. They move out, next to the folder. No tab closes.
  </message>
  <message name="IDS_AERIE_SIDEBAR_EDIT_FOLDER" desc="Item of the context menu of a folder in the sidebar. It opens the folder editor, where the user sets the folder's name, its kind and its rules. The three dots say that more input follows.">
    Edit folder...
  </message>
  <message name="IDS_AERIE_SIDEBAR_STOP_RULE_MATCHING" desc="Item of the context menu of a tab that a folder rule filed by itself. It adds this tab to the folder's exceptions, so that the rule never files it again, and moves the tab out of the folder.">
    Stop this rule matching this tab
  </message>
  <message name="IDS_AERIE_SIDEBAR_FOLDER_RULES_BUTTON" desc="Tooltip and accessible name of the small funnel button on the row of an auto-filing folder in the sidebar. It opens the folder editor.">
    Edit folder rules
  </message>
  <message name="IDS_AERIE_SIDEBAR_AUTO_FOLDER_NAME_EXPANDED" desc="Accessible name of a folder row in the sidebar that files new tabs by rules and is open. The name comes first, then the kind, the state and the number of items, for example: Trips, auto-filing folder, expanded, 3 items.">
    <ph name="NAME">$1<ex>Trips</ex></ph>, auto-filing folder, expanded, <ph name="ITEMS">$2<ex>3 items</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_AUTO_FOLDER_NAME_COLLAPSED" desc="Accessible name of a folder row in the sidebar that files new tabs by rules and is shut. The name comes first, then the kind, the state and the number of items, for example: Trips, auto-filing folder, collapsed, 3 items.">
    <ph name="NAME">$1<ex>Trips</ex></ph>, auto-filing folder, collapsed, <ph name="ITEMS">$2<ex>3 items</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_FILED_INTO" desc="Message in the small notice at the bottom of the sidebar after a folder rule moved a new tab into a folder by itself. A screen reader reads it politely.">
    Filed into <ph name="FOLDER">$1<ex>Trips</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_FILED_UNDO" desc="Button in the notice that says a tab was filed into a folder by a rule. It puts the tab back where it was.">
    Undo
  </message>
  <message name="IDS_AERIE_SIDEBAR_FILED_DONT_FILE_SITE" desc="Button in the notice that says a tab was filed into a folder by a rule. It adds the tab's website to the folder's exceptions, so that no tab of that website is filed there again.">
    Don't file this site
  </message>
  <message name="IDS_AERIE_SIDEBAR_SMART_FOLDER_NAME" desc="Accessible name of a folder row in the sidebar that shows the open tabs that match its rules. The name comes first, then the kind and the number of tabs it shows, for example: Docs, smart folder, 4 items. Whether it is open or shut is read from its expanded state.">
    <ph name="NAME">$1<ex>Docs</ex></ph>, smart folder, <ph name="ITEMS">$2<ex>4 items</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_SMART_ORIGIN_TODAY" desc="Small hint at the end of a row inside a smart folder in the sidebar, when the pointer is on the row. It says that the real tab is in the Today list.">
    Today
  </message>
  <message name="IDS_AERIE_SIDEBAR_SMART_ORIGIN_PINNED" desc="Small hint at the end of a row inside a smart folder in the sidebar, when the pointer is on the row. It says that the real tab is in the Pinned list.">
    Pinned
  </message>
  <message name="IDS_AERIE_SIDEBAR_SMART_ROW_NAME" desc="Accessible name of a row inside a smart folder in the sidebar. The tab's title comes first, then the list that the real tab is in, for example: Roadmap, shown from Today.">
    <ph name="TITLE">$1<ex>Roadmap</ex></ph>, shown from <ph name="LIST">$2<ex>Today</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_SMART_CLOSE_TOOLTIP" desc="Tooltip and accessible name of the close button on a row inside a smart folder in the sidebar. The row only shows the tab; the button acts on the real tab in the Today or Pinned list. The first part is what the button does to a tab (Close, Sleep, or Reset and sleep), and the last part is the list.">
    <ph name="ACTION">$1<ex>Close</ex></ph> the real tab in <ph name="LIST">$2<ex>Today</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_SMART_NO_DROP" desc="Hint that shows in the sidebar when the user drops a tab or a folder on a smart folder, or on a row inside one. Nothing moves. A smart folder only shows the tabs that match its rules.">
    Smart folders show tabs. They don't hold them.
  </message>
  <message name="IDS_AERIE_SIDEBAR_SMART_TABS" desc="The number of tabs that moved, as a part of the notice shown after a folder is switched to a smart folder.">
    {COUNT, plural,
      =1 {1 tab}
      other {# tabs}}
  </message>
  <message name="IDS_AERIE_SIDEBAR_SMART_MOVED_OUT" desc="Notice at the bottom of the sidebar after the user switched a folder that held tabs to a smart folder. A smart folder holds nothing, so the tabs moved out, next to the folder. A screen reader reads it politely. The first part is a number of tabs, for example: 3 tabs.">
    Moved <ph name="TABS">$1<ex>3 tabs</ex></ph> out of <ph name="FOLDER">$2<ex>Docs</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_KIND_SMART" desc="Choice in the folder editor: a folder that shows the open tabs that match its rules and holds none of them.">
    Smart
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_SMART_EXPLAIN" desc="One line in the folder editor under the choice of kind, when the kind is Smart. It tells the user what a smart folder does.">
    Shows open tabs that match. It moves nothing.
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_TITLE" desc="Accessible name of the folder editor, a small panel next to the sidebar. A screen reader reads it when the panel opens.">
    Edit folder <ph name="NAME">$1<ex>Trips</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_NAME_FIELD" desc="Accessible name of the text field in the folder editor where the user types the folder's name.">
    Folder name
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_KIND_LABEL" desc="Label of the choice in the folder editor between the kinds of folder.">
    Kind
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_KIND_MANUAL" desc="Choice in the folder editor: a folder that only holds what the user puts in it.">
    Manual
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_KIND_AUTO" desc="Choice in the folder editor: a folder that moves new tabs into itself when they match its rules.">
    Auto-filing
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_RULES_LABEL" desc="Heading of the list of rules in the folder editor, and the accessible name of that list. A rule says which new tabs go into the folder.">
    Rules
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_RULE_TYPE" desc="Accessible name of the choice of rule type in the folder editor.">
    Rule type
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_RULE_VALUE" desc="Accessible name of the text field in the folder editor where the user types what a rule looks for.">
    Rule text
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_ADD_RULE" desc="Button in the folder editor that adds the rule the user typed to the folder.">
    Add rule
  </message>
  <message name="IDS_AERIE_SIDEBAR_RULE_TYPE_DOMAIN" desc="Type of a folder rule: the website or one of its subdomains, for example example.com.">
    Domain
  </message>
  <message name="IDS_AERIE_SIDEBAR_RULE_TYPE_URL_STARTS" desc="Type of a folder rule: the address of the page starts with the text.">
    URL starts with
  </message>
  <message name="IDS_AERIE_SIDEBAR_RULE_TYPE_URL_CONTAINS" desc="Type of a folder rule: the address of the page has the text somewhere in it.">
    URL contains
  </message>
  <message name="IDS_AERIE_SIDEBAR_RULE_TYPE_TITLE_CONTAINS" desc="Type of a folder rule: the title of the page has the text somewhere in it. Capital letters do not matter.">
    Title contains
  </message>
  <message name="IDS_AERIE_SIDEBAR_RULE_CHIP" desc="Text of one rule in the folder editor: the type, then the text the rule looks for, for example: Domain: example.com.">
    <ph name="TYPE">$1<ex>Domain</ex></ph>: <ph name="VALUE">$2<ex>example.com</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_RULE_CHIP_OFF" desc="Accessible name of the switch of one rule in the folder editor. The switch turns that one rule on or off.">
    Rule <ph name="RULE">$1<ex>Domain: example.com</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_RULE_REMOVE" desc="Accessible name of the small button that removes one rule in the folder editor.">
    Remove rule <ph name="RULE">$1<ex>Domain: example.com</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_EXCEPTIONS_LABEL" desc="Heading of the list of exceptions in the folder editor. An exception is a website or a tab that the folder's rules never file.">
    Exceptions
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_EXCEPTION_REMOVE" desc="Accessible name of the small button that removes one exception in the folder editor.">
    Remove exception <ph name="HOST">$1<ex>example.com</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_EXCEPTIONS_EMPTY" desc="Text in the folder editor when the folder has no exceptions.">
    No exceptions.
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_ALL_SWITCH" desc="Label and accessible name of the switch in the folder editor that turns all rules of this one folder on or off.">
    All rules in this folder
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_GLOBAL_SWITCH" desc="Label and accessible name of the switch in the folder editor that turns the rules of every folder on or off. The same switch is in Settings.">
    Folder rules everywhere
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_DONE" desc="Button that closes the folder editor. Changes are already saved.">
    Done
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_RULES_FULL" desc="Text in the folder editor when the folder has the most rules it can have.">
    This folder has the most rules it can have.
  </message>
  <message name="IDS_AERIE_SIDEBAR_SHEET_SAVE_RULE" desc="Button in the folder editor that replaces a rule the user is editing with the new text. It takes the place of the Add rule button while a rule is edited.">
    Save rule
  </message>
  <message name="IDS_AERIE_SIDEBAR_BEHAVIOUR_HEADING" desc="Heading of the Behaviour section in the folder editor, and the accessible name of its group. The section holds three settings that a folder can set for the tabs inside it.">
    Behaviour
  </message>
  <message name="IDS_AERIE_SIDEBAR_BEHAVIOUR_ARCHIVE" desc="Label of the folder behaviour that sets when unused Today tabs in the folder are archived.">
    Auto-archive
  </message>
  <message name="IDS_AERIE_SIDEBAR_BEHAVIOUR_SLEEP" desc="Label of the folder behaviour that sets how long a tab in the folder is unused before it goes to sleep.">
    Sleep tabs after
  </message>
  <message name="IDS_AERIE_SIDEBAR_BEHAVIOUR_LINKS" desc="Label of the folder behaviour that sets where a link opens when it would open a new tab.">
    Links open
  </message>
  <message name="IDS_AERIE_SIDEBAR_BEHAVIOUR_SWITCH" desc="Accessible name of a switch in the folder editor. On means the folder has its own value for the behaviour; off means it uses the value of the folder above it, or the global one.">
    Set <ph name="BEHAVIOUR">$1<ex>Auto-archive</ex></ph> for this folder
  </message>
  <message name="IDS_AERIE_SIDEBAR_BEHAVIOUR_INHERITS_GLOBAL" desc="Text next to a folder behaviour that the folder does not set. The value that follows is the global one, from Settings.">
    Inherits global
  </message>
  <message name="IDS_AERIE_SIDEBAR_BEHAVIOUR_INHERITS_FROM" desc="Text next to a folder behaviour that the folder does not set, when the folder above it sets it. The value that follows is the one of that folder.">
    Inherits from <ph name="FOLDER">$1<ex>Trips</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_BEHAVIOUR_NAME_INHERITED" desc="Accessible name of the value control of a folder behaviour that the folder does not set. It reads the behaviour, where the value comes from, and the value.">
    <ph name="BEHAVIOUR">$1<ex>Auto-archive</ex></ph>, <ph name="SOURCE">$2<ex>Inherits global</ex></ph>, <ph name="VALUE">$3<ex>12 hours</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_BEHAVIOUR_NAME_OWN" desc="Accessible name of the value control of a folder behaviour that the folder sets itself. It reads the behaviour and its value.">
    <ph name="BEHAVIOUR">$1<ex>Auto-archive</ex></ph>, <ph name="VALUE">$2<ex>24 hours</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_BEHAVIOUR_MINUTES" desc="Value of the Sleep tabs after behaviour in the folder editor when the global setting is a number of minutes that the drop-down in Settings does not offer.">
    <ph name="MINUTES">$1<ex>45</ex></ph> minutes
  </message>
  <message name="IDS_AERIE_SIDEBAR_BEHAVIOUR_PINNED_NOTE" desc="Note under the Auto-archive setting in the folder editor for a folder in Pinned. The setting is off and cannot be changed there.">
    Pinned tabs never archive
  </message>
  <message name="IDS_AERIE_SIDEBAR_LINKS_NEW_TAB" desc="Option of the Links open setting, in Settings and in the folder editor: a link that would open a new tab opens one. In a folder the new tab opens next to the tab inside the same folder.">
    In a new tab
  </message>
  <message name="IDS_AERIE_SIDEBAR_LINKS_IN_PLACE" desc="Option of the Links open setting, in Settings and in the folder editor: a link that would open a new tab opens in the tab that holds the link instead.">
    In place
  </message>
  <message name="IDS_SETTINGS_AERIE_LINKS_OPEN" desc="Label of the drop-down in the Sidebar section of Settings that sets where a link opens when it would open a new tab. A folder can set its own. It is the default for tabs in folders.">
    Links open
  </message>
  <message name="IDS_SETTINGS_AERIE_LINKS_OPEN_DESC" desc="Line under the Links open drop-down in Settings. It says what the setting changes and what it leaves alone.">
    Where a link opens when the page asks for a new tab, for tabs in folders that do not set their own. Tabs that are in no folder are not changed. Ctrl+click, middle-click, pop-up windows, forms and links in embedded frames are not changed.
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_DENSITY" desc="Label of the setting in the Sidebar section of Settings that chooses how dense the sidebar is.">
    Sidebar density
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_DENSITY_DESC" desc="Description under the Sidebar density setting. It says what the four choices change.">
    How much room the sidebar takes. Auto-hide hides it until you move the pointer to the edge of the window.
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_DENSITY_COMFORTABLE" desc="Choice of the Sidebar density setting: the default sidebar with roomy rows.">
    Comfortable
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_DENSITY_COMPACT" desc="Choice of the Sidebar density setting: the sidebar with shorter rows and smaller tiles.">
    Compact
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_DENSITY_RAIL" desc="Choice of the Sidebar density setting: a thin strip that shows only icons, no titles.">
    Collapsed rail
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_DENSITY_AUTO_HIDE" desc="Choice of the Sidebar density setting: the sidebar is hidden until the pointer touches the edge of the window.">
    Auto-hide
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_SIDE" desc="Label of the setting in the Sidebar section of Settings that chooses which side of the window the sidebar is on.">
    Sidebar side
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_SIDE_DESC" desc="Description under the Sidebar side setting.">
    Put the sidebar on the left or on the right of the window.
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_SIDE_LEFT" desc="Choice of the Sidebar side setting: the sidebar is on the left.">
    Left
  </message>
  <message name="IDS_SETTINGS_AERIE_SIDEBAR_SIDE_RIGHT" desc="Choice of the Sidebar side setting: the sidebar is on the right.">
    Right
  </message>
  <message name="IDS_SETTINGS_AERIE_APPEARANCE_THEME" desc="Label of the setting in the Sidebar section of Settings that chooses the Theme: how the browser window is drawn.">
    Theme
  </message>
  <message name="IDS_SETTINGS_AERIE_APPEARANCE_THEME_DESC" desc="Description under the Theme setting. It says that the Theme changes how the sidebar, the window frame and the menus look.">
    How the sidebar, the window frame and the menus are drawn. A Workspace colour tints them differently in each theme.
  </message>
  <message name="IDS_SETTINGS_AERIE_APPEARANCE_THEME_VIVID" desc="Name of a Theme: the default, with a strong colour gradient from the Workspace colour.">
    Vivid
  </message>
  <message name="IDS_SETTINGS_AERIE_APPEARANCE_THEME_SOFT" desc="Name of a Theme: a gentle colour gradient from the Workspace colour.">
    Soft
  </message>
  <message name="IDS_SETTINGS_AERIE_APPEARANCE_THEME_CLEAN" desc="Name of a Theme: a near-neutral window with a thin strip of the Workspace colour.">
    Clean
  </message>
  <message name="IDS_SETTINGS_AERIE_APPEARANCE_THEME_OLED" desc="Name of a Theme: true black surfaces, for dark mode only.">
    OLED
  </message>
  <message name="IDS_SETTINGS_AERIE_APPEARANCE_THEME_HIGH_CONTRAST" desc="Name of a Theme: black and white surfaces and text with the highest contrast.">
    High contrast
  </message>
  <message name="IDS_SETTINGS_AERIE_APPEARANCE_THEME_MONO" desc="Name of a Theme: grey surfaces without a colour gradient.">
    Mono
  </message>
  <message name="IDS_SETTINGS_AERIE_APPEARANCE_MODE" desc="Label of the setting in the Sidebar section of Settings that chooses the colour mode: light, dark, or the same as the computer.">
    Mode
  </message>
  <message name="IDS_SETTINGS_AERIE_APPEARANCE_MODE_DESC" desc="Description under the Mode setting. It says what System means.">
    Light or dark. System follows your computer.
  </message>
  <message name="IDS_SETTINGS_AERIE_APPEARANCE_MODE_SYSTEM" desc="Choice of the Mode setting: use the light or dark colours that the computer uses.">
    System
  </message>
  <message name="IDS_SETTINGS_AERIE_APPEARANCE_MODE_LIGHT" desc="Choice of the Mode setting: always use light colours.">
    Light
  </message>
  <message name="IDS_SETTINGS_AERIE_APPEARANCE_MODE_DARK" desc="Choice of the Mode setting: always use dark colours.">
    Dark
  </message>
  <message name="IDS_SETTINGS_AERIE_APPEARANCE_NOTE_OLED_LIGHT" desc="Note under the Theme setting. It shows while the OLED theme is chosen and the mode is not dark, because OLED has only a dark look.">
    OLED is dark only. In light mode the browser shows Clean.
  </message>
  <message name="IDS_SETTINGS_AERIE_APPEARANCE_NOTE_NO_TINT" desc="Note under the Theme setting. It shows while the High contrast or Mono theme is chosen, which draw no colour gradient.">
    This theme draws no colour gradient. The Workspace colour sets only the accent.
  </message>
  <message name="IDS_AERIE_SIDEBAR_PEEK_KEPT_OPEN" desc="Short message that shows in the sidebar after the user pressed Ctrl+Alt+S while the sidebar was hidden at the edge of the window. It says the sidebar stays open now.">
    Sidebar stays open
  </message>
  <message name="IDS_AERIE_SIDEBAR_PEEK_RELEASED" desc="Short message that shows in the sidebar after the user pressed Ctrl+Alt+S again. It says the sidebar hides again when the pointer moves away.">
    Sidebar hides when you move away
  </message>
  <message name="IDS_AERIE_SIDEBAR_GUARD_BUTTON" desc="Tooltip and accessible name of the square shield button that replaces the address field in the collapsed sidebar. It opens the Guard panel of the current site.">
    Guard
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_BUTTON" desc="Label, tooltip and accessible name of the button in the bottom bar of the sidebar that opens the Archive panel. The Archive keeps the tabs the browser closed for the user because they were not used for a long time.">
    Archive
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_PANEL" desc="Accessible name of the Archive panel, the small window that lists archived tabs. It is a dialog.">
    Archive
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_HEADER" desc="Text before the menu in the header of the Archive panel. The menu shows how long a Today tab can stay unused before it is archived, for example: Archive Today tabs after 12 hours. Today is the name of the sidebar section of unpinned tabs.">
    Archive Today tabs after
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_AFTER_NAME" desc="Accessible name of the menu button in the header of the Archive panel. It reads the whole sentence with the chosen time. Today is the name of the sidebar section of unpinned tabs.">
    Archive Today tabs after <ph name="TIME">$1<ex>12 hours</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_AFTER_12H" desc="Option of the archive timeout, in the Archive panel and in Settings: 12 hours. This is the default.">
    12 hours
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_AFTER_24H" desc="Option of the archive timeout, in the Archive panel and in Settings: 24 hours.">
    24 hours
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_AFTER_7D" desc="Option of the archive timeout, in the Archive panel and in Settings: 7 days.">
    7 days
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_AFTER_NEVER" desc="Option of the archive timeout, in the Archive panel and in Settings: tabs are never archived by themselves.">
    Never
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_SEARCH" desc="Placeholder and accessible name of the search field in the Archive panel. It searches the titles and the addresses of the archived tabs.">
    Search archived tabs
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_LIST" desc="Accessible name of the list of archived tabs in the Archive panel.">
    Archived tabs
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_GROUP_TODAY" desc="Heading in the Archive panel above the tabs that were archived on the current day.">
    Today
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_GROUP_YESTERDAY" desc="Heading in the Archive panel above the tabs that were archived on the day before.">
    Yesterday
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_GROUP_LAST_WEEK" desc="Heading in the Archive panel above the tabs that were archived two to seven days ago.">
    Last week
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_GROUP_EARLIER" desc="Heading in the Archive panel above the tabs that were archived more than seven days ago.">
    Earlier
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_EMPTY" desc="Text in the Archive panel when no tab is archived.">
    Nothing is archived yet. Tabs you do not use go here.
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_NO_MATCHES" desc="Text in the Archive panel when the search finds no archived tab.">
    No archived tab matches.
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_ROW_NAME" desc="Accessible name of one archived tab in the Archive panel: its title, then the name of the Workspace it came from. A Workspace is a named group of tabs, for example Personal.">
    <ph name="TITLE">$1<ex>Example page</ex></ph>, <ph name="WORKSPACE">$2<ex>Personal</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_CLEAR_BUTTON" desc="Label and accessible name of the button at the end of the Today heading in the sidebar. It moves every unpinned tab of Today to the Archive, where the user can restore them. Today is the name of the sidebar section of unpinned tabs.">
    Clear
  </message>
  <message name="IDS_AERIE_SIDEBAR_CLEAR_TOOLTIP" desc="Tooltip of the Clear button in the Today heading of the sidebar. It says what a click does and what a click with the Alt key held does. Today is the name of the sidebar section of unpinned tabs.">
    Archive the tabs in Today. Hold Alt to close them instead.
  </message>
  <message name="IDS_AERIE_SIDEBAR_CLEAR_MENU_ARCHIVE" desc="Item of the menu of the Clear button in the Today heading of the sidebar. It moves every unpinned tab of Today to the Archive, where the user can restore them. It does the same as a click on the button.">
    Archive all
  </message>
  <message name="IDS_AERIE_SIDEBAR_CLEAR_MENU_CLOSE" desc="Item of the menu of the Clear button in the Today heading of the sidebar. It closes every unpinned tab of Today at once and does not keep them in the Archive.">
    Close all
  </message>
  <message name="IDS_AERIE_SIDEBAR_CLEARED_TOAST" desc="Short message in the small notice at the bottom of the sidebar after the user pressed Clear. It says how many tabs went to the Archive. A button next to it undoes this. A screen reader reads it politely.">
    {COUNT, plural,
      =1 {1 tab archived}
      other {# tabs archived}}
  </message>
  <message name="IDS_AERIE_SIDEBAR_CLEARED_TOAST_READ" desc="What a screen reader says when the notice after the Clear button appears: how many tabs went to the Archive, then that the Undo button is there.">
    {COUNT, plural,
      =1 {1 tab archived. Undo is available.}
      other {# tabs archived. Undo is available.}}
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_ROW_NAME_CLEARED" desc="Accessible name of one archived tab in the Archive panel that the user archived with the Clear button: its title, that it was cleared, then the name of the Workspace it came from. A Workspace is a named group of tabs, for example Personal.">
    <ph name="TITLE">$1<ex>Example page</ex></ph>, cleared, <ph name="WORKSPACE">$2<ex>Personal</ex></ph>
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_ROW_CLEARED" desc="Small label on a row of the Archive panel for a tab that the user archived with the Clear button of the Today heading.">
    Cleared
  </message>
  <message name="IDS_AERIE_SIDEBAR_ARCHIVE_RESTORED" desc="Said by a screen reader after the user restored an archived tab from the Archive panel.">
    Restored <ph name="TITLE">$1<ex>Example page</ex></ph>
  </message>
  <message name="IDS_SETTINGS_AERIE_ARCHIVE_AFTER" desc="Label of the drop-down in the Sidebar section of Settings that sets how long a Today tab can stay unused before it is archived. Today is the name of the sidebar section of unpinned tabs.">
    Archive Today tabs after
  </message>
  <message name="IDS_SETTINGS_AERIE_ARCHIVE_AFTER_DESC" desc="Line under the archive drop-down in Settings. It says which tabs the browser leaves alone.">
    The tab you are viewing and tabs that play sound stay. Pinned tabs and Favorites are never archived.
  </message>
  <message name="IDS_SETTINGS_AERIE_ARCHIVE_KEEP" desc="Label of the drop-down in the Sidebar section of Settings that sets how long the Archive keeps an archived tab before it drops it.">
    Keep archived tabs for
  </message>
  <message name="IDS_SETTINGS_AERIE_ARCHIVE_KEEP_DESC" desc="Line under the archive-keep drop-down in Settings. It says what is dropped.">
    After this time an archived tab is removed from the Archive.
  </message>
  <message name="IDS_SETTINGS_AERIE_ARCHIVE_KEEP_7D" desc="Option of the archive-keep drop-down in Settings: 7 days.">
    7 days
  </message>
  <message name="IDS_SETTINGS_AERIE_ARCHIVE_KEEP_30D" desc="Option of the archive-keep drop-down in Settings: 30 days. This is the default.">
    30 days
  </message>
  <message name="IDS_SETTINGS_AERIE_ARCHIVE_KEEP_90D" desc="Option of the archive-keep drop-down in Settings: 90 days.">
    90 days
  </message>
  <message name="IDS_SETTINGS_AERIE_ARCHIVE_KEEP_FOREVER" desc="Option of the archive-keep drop-down in Settings: archived tabs are never dropped.">
    Forever
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_TIDY" desc="Label of the switch in the Sidebar section of Settings that turns the built-in tidy of tab titles on or off.">
    Tidy tab titles
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_TIDY_DESC" desc="Line under the tidy switch in Settings. It says what the tidy removes and that it runs on the device.">
    Remove a site name such as " - Gmail", unread counts such as "(3)", and repeated separators from the titles in the sidebar. This runs on this device only. The page's own title does not change.
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_TIDY_OFF_SITES" desc="Heading of the list in Settings of sites where the tidy of tab titles is off.">
    Don't tidy these sites
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_TIDY_OFF_SITES_DESC" desc="Line under the heading of the list of sites where the tidy is off. A site covers its subdomains.">
    Type a site, for example example.com. It covers its subdomains too.
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_TIDY_OFF_SITES_ADD" desc="Button in Settings that adds the site typed in the field to the list of sites where the tidy is off.">
    Add
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_TIDY_OFF_SITES_REMOVE" desc="Start of the accessible name of the button that removes a site from the list of sites where the tidy is off. The site name follows it.">
    Remove site
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULES" desc="Heading of the rename rules in the Sidebar section of Settings. A rename rule changes the title that the sidebar shows for a tab.">
    Rename rules
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULES_ALL" desc="Label of the switch in Settings that turns all rename rules on or off.">
    All rename rules
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULES_ALL_DESC" desc="Line under the switch that turns all rename rules on or off.">
    Turn this off to stop every rule at once. No rule is removed.
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULES_HELP" desc="Help line above the list of rename rules in Settings. It says that the first rule that matches wins and how to reorder with the keyboard.">
    The first rule that matches a tab wins. Use the arrow keys to move through the list, and Alt with Up or Down to move a rule.
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULES_EMPTY" desc="Line shown in Settings when the user has no rename rules.">
    No rules yet.
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_SWITCH" desc="Start of the accessible name of the switch of one rename rule. The name of the rule follows it.">
    Rule on
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_MOVE_UP" desc="Start of the accessible name of the button that moves a rename rule up the list. The name of the rule follows it.">
    Move rule up
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_MOVE_DOWN" desc="Start of the accessible name of the button that moves a rename rule down the list. The name of the rule follows it.">
    Move rule down
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_UP" desc="Short visible label of the button that moves a rename rule up the list.">
    Up
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_DOWN" desc="Short visible label of the button that moves a rename rule down the list.">
    Down
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_EDIT" desc="Label of the button that edits a rename rule. Also the start of its accessible name.">
    Edit
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_REMOVE" desc="Label of the button that removes a rename rule or a site from a list. Also the start of its accessible name.">
    Remove
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_ADD" desc="Button in Settings that starts a new rename rule.">
    Add a rule
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_NEW" desc="Heading of the form for a new rename rule.">
    New rename rule
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_EDITING" desc="Heading of the form that edits a rename rule.">
    Edit rename rule
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_NAME" desc="Label of the field for the name of a rename rule.">
    Name
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_MATCH" desc="Label of the menu where the user chooses how a rename rule finds its tabs.">
    Match a tab by
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_VALUE" desc="Label of the field for the text that a rename rule looks for (a site, the start of an address, a part of an address or a part of the title).">
    Text to match
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_REWRITE" desc="Label of the menu where the user chooses what a rename rule does to the title.">
    Then
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_MODE_TEMPLATE" desc="Option of the menu of what a rename rule does: it shows a new title that the user writes.">
    Show this title
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_MODE_REMOVE" desc="Option of the menu of what a rename rule does: it deletes some text from the title.">
    Remove this text from the title
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_TEMPLATE" desc="Label of the field for the new title that a rename rule shows.">
    New title
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_REMOVE_TEXT" desc="Label of the field for the text that a rename rule deletes from the title.">
    Text to remove
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_TEMPLATE_HINT" desc="Help line under the field for the new title of a rename rule. The words in braces are typed as they are by the user; do not translate them.">
    Use <ph name="TITLE_TOKEN">{title}<ex>{title}</ex></ph> for the page title and <ph name="HOST_TOKEN">{host}<ex>{host}</ex></ph> for the site. When the rule matches by title, <ph name="TITLE_TOKEN_2">{title}<ex>{title}</ex></ph> is the title without the matched text.
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_REMOVE_HINT" desc="Help line under the field for the text that a rename rule deletes. It says what happens when the field is empty.">
    Every copy of this text goes, in any case. When the rule matches by title, leave this empty to remove the matched text.
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_SAVE" desc="Button that saves a rename rule.">
    Save
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_CANCEL" desc="Button that closes the form of a rename rule without saving.">
    Cancel
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_TYPE_DOMAIN" desc="Option of the menu of how a rule finds a tab: the site of the tab, or any of its subdomains.">
    Site (and its subdomains)
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_TYPE_URL_STARTS_WITH" desc="Option of the menu of how a rule finds a tab: the address of the tab starts with the text.">
    Address starts with
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_TYPE_URL_CONTAINS" desc="Option of the menu of how a rule finds a tab: the address of the tab has the text in it.">
    Address contains
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_TYPE_TITLE_CONTAINS" desc="Option of the menu of how a rule finds a tab: the title of the page has the text in it, in any case.">
    Title contains
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_ERROR_TOO_MANY" desc="Error in the form of a rename rule: the user has the most rules that are allowed (50).">
    You have the most rules that are allowed (50). Remove one first.
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_ERROR_NAME_LONG" desc="Error in the form of a rename rule: the name is too long.">
    The name is too long.
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_ERROR_VALUE_EMPTY" desc="Error in the form of a rename rule: the text to match is empty.">
    Type the text to match.
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_ERROR_VALUE_LONG" desc="Error in the form of a rename rule: the text to match is too long.">
    The text to match is too long.
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_ERROR_TEXT_LONG" desc="Error in the form of a rename rule: the new title or the text to remove is too long.">
    The new title or the text to remove is too long.
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_ERROR_TEMPLATE_EMPTY" desc="Error in the form of a rename rule: the new title is empty.">
    Type the new title.
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_ERROR_REMOVE_EMPTY" desc="Error in the form of a rename rule: it removes text, but no text is given and the rule does not match by title.">
    Type the text to remove.
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_MOVED" desc="Message that a screen reader says after a rename rule moved in the list.">
    Rule <ph name="NAME">$1<ex>Mail</ex></ph> moved to position <ph name="POSITION">$2<ex>2</ex></ph> of <ph name="COUNT">$3<ex>5</ex></ph>.
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_RULE_REMOVED" desc="Message that a screen reader says after a rename rule was removed.">
    Rule <ph name="NAME">$1<ex>Mail</ex></ph> removed.
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_TRY" desc="Heading of the box in Settings where the user tries what the rename rules and the tidy make of a title.">
    Try a title
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_TRY_URL" desc="Label of the field in the Try a title box for the address of a page.">
    Address
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_TRY_PAGE_TITLE" desc="Label of the field in the Try a title box for the title of a page.">
    Page title
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_TRY_RESULT_RULE" desc="Result of the Try a title box when a rename rule changed the title. It tells the new title and the name of the rule.">
    Shown: <ph name="TITLE">$1<ex>Mail</ex></ph> (rename rule <ph name="RULE">$2<ex>Work mail</ex></ph>)
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_TRY_RESULT_TIDY" desc="Result of the Try a title box when the built-in tidy changed the title.">
    Shown: <ph name="TITLE">$1<ex>Inbox</ex></ph> (tidied)
  </message>
  <message name="IDS_SETTINGS_AERIE_TITLE_TRY_RESULT_PAGE" desc="Result of the Try a title box when nothing changed the title.">
    Shown: <ph name="TITLE">$1<ex>Inbox</ex></ph> (the page title, unchanged)
  </message>
  <message name="IDS_AERIE_SIDEBAR_BATCH_CLOSE" desc="Item of the menu that opens when the user right-clicks one of several selected rows in the sidebar. It acts on all of the selected tabs. It closes them. Pinned and Favorite tabs follow the pinned-close setting.">
    {COUNT, plural,
      =1 {Close tab}
      other {Close # tabs}}
  </message>
  <message name="IDS_AERIE_SIDEBAR_BATCH_ARCHIVE" desc="Item of the menu that opens when the user right-clicks one of several selected rows in the sidebar. It acts on all of the selected tabs. It moves them to the Archive, where the user can restore them.">
    {COUNT, plural,
      =1 {Archive tab}
      other {Archive # tabs}}
  </message>
  <message name="IDS_AERIE_SIDEBAR_BATCH_SLEEP" desc="Item of the menu that opens when the user right-clicks one of several selected rows in the sidebar. It acts on all of the selected tabs. It puts them to sleep, which frees their memory. A tab that cannot sleep stays awake.">
    {COUNT, plural,
      =1 {Sleep tab}
      other {Sleep # tabs}}
  </message>
  <message name="IDS_AERIE_SIDEBAR_BATCH_PIN" desc="Item of the menu that opens when the user right-clicks one of several selected rows in the sidebar. It acts on all of the selected tabs. It pins them.">
    {COUNT, plural,
      =1 {Pin tab}
      other {Pin # tabs}}
  </message>
  <message name="IDS_AERIE_SIDEBAR_BATCH_UNPIN" desc="Item of the menu that opens when the user right-clicks one of several selected rows in the sidebar. It acts on all of the selected tabs. It unpins them.">
    {COUNT, plural,
      =1 {Unpin tab}
      other {Unpin # tabs}}
  </message>
  <message name="IDS_AERIE_SIDEBAR_BATCH_ADD_TO_FAVORITES" desc="Item of the menu that opens when the user right-clicks one of several selected rows in the sidebar. It acts on all of the selected tabs. It adds them to Favorites, as many as fit.">
    {COUNT, plural,
      =1 {Add tab to Favorites}
      other {Add # tabs to Favorites}}
  </message>
  <message name="IDS_AERIE_SIDEBAR_BATCH_REMOVE_FROM_FAVORITES" desc="Item of the menu that opens when the user right-clicks one of several selected rows in the sidebar. It acts on all of the selected tabs. It takes them out of Favorites.">
    {COUNT, plural,
      =1 {Remove tab from Favorites}
      other {Remove # tabs from Favorites}}
  </message>
  <message name="IDS_AERIE_SIDEBAR_SELECT_RANGE_TO_HERE" desc="Item of the context menu of a tab row in the sidebar while other rows are selected, and an action for screen readers. It selects every row from the last selected row to this one.">
    Select range to here
  </message>
  <message name="IDS_AERIE_SIDEBAR_CLEAR_SELECTION" desc="Item of the context menu of a row in the sidebar while rows are selected, and an action for screen readers. It unselects every row.">
    Clear selection
  </message>
  <message name="IDS_AERIE_SIDEBAR_SELECTED_COUNT" desc="Announced by a screen reader, and shown nowhere, when the number of selected rows in the sidebar changes. For example: 3 selected.">
    {COUNT, plural,
      =1 {1 selected}
      other {# selected}}
  </message>
  <message name="IDS_AERIE_SIDEBAR_CONFIRM_CLOSE_SELECTION" desc="Short message that the sidebar shows when the user presses Delete with several rows selected. Nothing closes yet; pressing Delete again closes them.">
    {COUNT, plural,
      =1 {Press Delete again to close this tab}
      other {Press Delete again to close # tabs}}
  </message>
  <message name="IDS_AERIE_SIDEBAR_FAVORITES_PARTLY_FULL" desc="Short message that the sidebar shows after the user added several tabs to Favorites and only some fitted. The Favorites grid holds 12. The number is how many were not added.">
    {COUNT, plural,
      =1 {Favorites are full. 1 tab was not added.}
      other {Favorites are full. # tabs were not added.}}
  </message>
  <message name="IDS_AERIE_SIDEBAR_MEDIA_NAME" desc="Accessible name of the card at the bottom of the sidebar that shows the tab that is playing audio or video, with buttons to control it.">
    Now playing
  </message>
  <message name="IDS_AERIE_SIDEBAR_MEDIA_PLAY" desc="Name and tooltip of the button on the sidebar's now playing card that resumes the paused audio or video.">
    Play
  </message>
  <message name="IDS_AERIE_SIDEBAR_MEDIA_PAUSE" desc="Name and tooltip of the button on the sidebar's now playing card that pauses the audio or video.">
    Pause
  </message>
  <message name="IDS_AERIE_SIDEBAR_MEDIA_NEXT" desc="Name and tooltip of the button on the sidebar's now playing card that skips to the next track. The page decides whether there is one.">
    Next track
  </message>
  <message name="IDS_AERIE_SIDEBAR_MEDIA_GO_TO_TAB" desc="Label of the button on the sidebar's now playing card that switches to the tab that plays the audio or video.">
    Go to tab
  </message>
</grit-part>
