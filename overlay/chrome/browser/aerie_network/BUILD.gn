# Test-only: the request policy (//services/network/aerie) seen from the
# browser (issue #257). Joins //chrome/test/aerie:aerie_browser_tests.
source_set("browser_tests") {
  testonly = true
  # content/public/test/browser_test.h refuses to compile without it.
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "request_policy_browsertest.cc" ]
  deps = [
    "//base",
    "//base/test:test_support",
    "//chrome/browser:browser",
    "//chrome/browser/ui/tabs:tabs_public",
    "//chrome/common",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//components/metrics:content",
    "//components/prefs",
    "//content/public/browser",
    "//content/test:test_support",
    "//mojo/public/cpp/bindings",
    "//net",
    "//net:test_support",
    "//net/traffic_annotation:test_support",
    "//services/network:network_service",
    "//services/network/aerie:request_policy",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//testing/gtest",
  ]
}
