# Starts and owns the Filter Engine service from the browser's main parts. Same
# shape as //chrome/browser/performance_monitor. Also holds the protection
# category's browser side: the navigation throttle, the interstitial and the
# per-tab "Continue anyway" state (patches/adblock/0011).
source_set("aerie_adblock") {
  visibility = [ "//chrome/browser:core" ]
  public = [
    "aerie_adblock_main_extra_parts.h",
    "aerie_protection_throttle.h",
  ]
  sources = [
    "aerie_adblock_main_extra_parts.cc",
    "aerie_protection_blocking_page.cc",
    "aerie_protection_blocking_page.h",
    "aerie_protection_tab_state.cc",
    "aerie_protection_tab_state.h",
    "aerie_protection_throttle.cc",
  ]
  public_deps = [
    "//chrome/browser:main_extra_parts",
    "//content/public/browser",
  ]
  deps = [
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser/net:net",
    "//chrome/browser/profiles",
    "//chrome/browser/profiles:profile",
    "//chrome/common:constants",
    "//chrome/common:url_constants",
    "//components/aerie_adblock/browser",
    "//components/security_interstitials/content:security_interstitial_page",
    "//components/security_interstitials/core",
    "//net",
    "//url",
  ]
}

# Cosmetic filtering: hides what the Filter Engine's hide rules name, tab by
# tab. Attached to each tab by patches/adblock/0007; the only user is
# TabFeatures (//chrome/browser/ui/tabs:impl).
source_set("tab_helper") {
  visibility = [ "//chrome/browser/ui/tabs:impl" ]
  sources = [
    "aerie_cosmetic_tab_helper.cc",
    "aerie_cosmetic_tab_helper.h",
  ]
  deps = [
    "//base",
    "//components/aerie_adblock/browser:cosmetic_scripts",
    "//components/aerie_adblock/browser:service",
    "//content/public/browser",
    "//url",
  ]
}
