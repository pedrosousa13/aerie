import("//testing/test.gni")

assert(!is_android, "Aerie's browser tests are for desktop platforms only")

# Aerie's Views UI tests (issue #175, ADR "Testing Decisions", seam B).
#
# Chromium's browser_tests and interactive_ui_tests link every browser test of
# Chromium (hours to link, and they need test data that Helium prunes). These
# two binaries link only Aerie's own test files plus chrome/test's test support.
# They are test-only: nothing in the shipped browser links them, and
# `./aerie build` does not build them. `./aerie test-cpp --target ...` does.
#
# A new Aerie browser test adds its `browser_tests` source_set (next to the code
# it tests) to aerie_browser_tests; a new interactive test adds its source_set to
# aerie_interactive_ui_tests. See CONTRIBUTING.md, "Testing the Views UI".
#
# Hooked into the GN graph by patches/tests/0002 (gn_all in //BUILD.gn), because
# GN only loads a build file that something refers to.

group("tests") {
  testonly = true
  deps = [
    ":aerie_browser_tests",
    ":aerie_interactive_ui_tests",
  ]
}

# What both binaries need to start a browser in the test process.
group("test_data") {
  testonly = true
  data = [
    "//chrome/test/data/",
    "//content/test/data/",
    "//net/tools/testserver/",
    "//third_party/pywebsocket3/src/pywebsocket3/",
    "//third_party/node/node_modules/mocha/mocha.js",
    "//ui/webui/resources/",
    "//google_apis/test/",
  ]
  data_deps = [
    "//chrome:browser_tests_pak",
    "//chrome:packed_resources",
    "//third_party/angle:includes",
    "//ui/resources:ui_test_pak_data",
  ]
}

test("aerie_browser_tests") {
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  deps = [
    ":test_data",
    "//base/test:test_support",
    "//chrome:packed_resources",
    "//chrome:resources",
    "//chrome:strings",
    "//chrome/browser/ui/webui/aerie_guard:browser_tests",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//chrome/test/base:browser_tests_runner",
    "//testing/gmock",
    "//testing/gtest",
  ]
}

source_set("interactive_tests") {
  testonly = true
  sources = [ "aerie_interactive_smoke_uitest.cc" ]
  deps = [
    "//base",
    "//base/test:test_support",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui:view_ids",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//content/test:test_support",
    "//testing/gtest",
    "//ui/events",
  ]
}

test("aerie_interactive_ui_tests") {
  # The same entry point as Chromium's interactive_ui_tests: it turns on the
  # UI controls that send real key and mouse events.
  sources = [ "//chrome/test/base/interactive_ui_tests_main.cc" ]
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  deps = [
    ":interactive_tests",
    ":test_data",
    "//base/test:test_support",
    "//chrome/browser",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//chrome/test/base:chrome_test_launcher",
    "//chrome/test/base:chrome_test_suite",
    "//chrome/test/base:testing_browser_process",
    "//content/public/common",
    "//testing/gtest",
    "//ui/base:test_support",
    "//ui/compositor",
    "//ui/gfx",
  ]
  if (is_linux) {
    deps += [ "//ui/linux:display_server_utils" ]
  }
}
